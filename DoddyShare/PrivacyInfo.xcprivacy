<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- "Save to Doddy" sends nothing anywhere: it leaves the shared text or link in the App Group for the app.
	     What Doddy collects is declared once, in the app's own manifest (DoddyApp/Resources/PrivacyInfo.xcprivacy). -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- The extension's own code calls no required-reason API, but it links DoddyCore, whose code reads
			     the app's own UserDefaults. scripts/check_privacy_manifest.sh checks this manifest against the
			     extension's sources and DoddyCore's. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
