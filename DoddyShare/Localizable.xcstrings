          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Doddy 中就绪"
          }
        }
      }
    },
    "Save to Doddy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
