            "value": "保存到 Doddy"
          }
        }
      }
    },
    "Send to Doddy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Doddy senden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar a Doddy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer à Doddy"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošalji Doddyju"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia a Doddy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyに送信"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij do Doddy’ego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar ao Doddy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送到 Doddy"
          }
        }
      }
    },
    "Sharing to Doddy isn't set up in this version of the app. Nothing was saved. You can use the Save to Doddy shortcut instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Teilen in Doddy ist in dieser Version der App nicht eingerichtet. Nichts wurde gespeichert. Du kannst stattdessen den Kurzbefehl „In Doddy speichern“ verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir en Doddy no está configurado en esta versión de la app. No se ha guardado nada. Puedes usar el atajo Guardar en Doddy en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage vers Doddy n’est pas configuré dans cette version de l’app. Rien n’a été enregistré. Tu peux utiliser le raccourci Enregistrer dans Doddy à la place."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeljenje s Doddyjem nije postavljeno u ovoj verziji aplikacije. Ništa nije spremljeno. Umjesto toga možeš koristiti prečac Spremi u Doddyju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La condivisione in Doddy non è configurata in questa versione dell'app. Niente è stato salvato. Puoi usare invece il comando rapido Salva in Doddy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのアプリでは、Doddyへの共有は設定されていません。何も保存されていません。代わりに「Doddyに保存」ショートカットを使えます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnianie do Doddy’ego nie jest skonfigurowane w tej wersji aplikacji. Nic nie zostało zapisane. Możesz zamiast tego użyć skrótu Zapisz w Doddym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compartilhamento com o Doddy não está configurado nesta versão do app. Nada foi salvo. Você pode usar o atalho Salvar no Doddy no lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的应用尚未设置共享到 Doddy。没有保存任何内容。你可以改用“保存到 Doddy”快捷指令。"
          }
        }
      }
    },
    "That couldn't be handed to Doddy. Nothing was saved. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnte nicht an Doddy übergeben werden. Nichts wurde gespeichert. Versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido pasar eso a Doddy. No se ha guardado nada. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de le transmettre à Doddy. Rien n’a été enregistré. Réessaie."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To nije bilo moguće predati Doddyju. Ništa nije spremljeno. Pokušaj ponovno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile passarlo a Doddy. Niente è stato salvato. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyに渡せませんでした。何も保存されていません。もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się przekazać tego Doddy’emu. Nic nie zostało zapisane. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não pôde ser passado ao Doddy. Nada foi salvo. Tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将其交给 Doddy。没有保存任何内容。请重试。"
          }
        }
      }
    },
    "There's no text or web link here that Doddy can keep. Nothing was saved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist kein Text und kein Weblink, den Doddy behalten kann. Nichts wurde gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay texto ni enlace web que Doddy pueda guardar. No se ha guardado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a ici ni texte ni lien web que Doddy puisse garder. Rien n’a été enregistré."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje nema teksta ni web-poveznice koje bi Doddy mogao sačuvati. Ništa nije spremljeno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c'è testo o link web che Doddy possa conservare. Niente è stato salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはDoddyが残せるテキストやWebリンクがありません。何も保存されていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma tu tekstu ani linku, który Doddy mógłby zachować. Nic nie zostało zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há texto nem link aqui que o Doddy possa guardar. Nada foi salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没有 Doddy 可以保留的文字或网页链接。没有保存任何内容。"
          }
        }
      }
    },
    "This replaces something you shared earlier that isn't saved yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ersetzt etwas, das du vorher geteilt hast und das noch nicht gespeichert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sustituye algo que compartiste antes y que aún no está guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci remplace quelque chose que tu as partagé plus tôt et qui n’est pas encore enregistré."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo zamjenjuje ranije podijeljeni sadržaj koji još nije spremljen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo sostituisce qualcosa che hai condiviso prima e che non è ancora salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ保存されていない、以前に共有した内容と置き換わります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zastąpi wcześniej udostępnioną treść, która nie jest jeszcze zapisana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto substitui algo que você compartilhou antes e ainda não está salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会替换你之前共享但尚未保存的内容。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
