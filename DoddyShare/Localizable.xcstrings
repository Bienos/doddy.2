{
  "sourceLanguage": "en",
  "strings": {
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odustani"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluj"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Doddy opens this on the capture screen next time you open the app. Nothing is saved until you tap Save there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy öffnet das beim nächsten Öffnen der App auf dem Erfassen-Bildschirm. Nichts wird gespeichert, bis du dort auf Speichern tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy lo abrirá en la pantalla de captura la próxima vez que abras la app. No se guarda nada hasta que toques Guardar allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy l’ouvre sur l’écran de saisie la prochaine fois que tu ouvres l’app. Rien n’est enregistré tant que tu n’y touches pas Enregistrer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy to otvara na zaslonu za bilježenje sljedeći put kad otvoriš aplikaciju. Ništa se ne sprema dok ondje ne dodirneš Spremi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy lo apre nella schermata di acquisizione la prossima volta che apri l'app. Niente viene salvato finché non tocchi Salva lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にアプリを開いたとき、Doddyはこれを記録画面で開きます。そこで「保存」をタップするまで、何も保存されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy otworzy to na ekranie zapisu, gdy następnym razem otworzysz aplikację. Nic nie zostanie zapisane, dopóki nie stukniesz tam Zapisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy abre isto na tela de captura na próxima vez que você abrir o app. Nada é salvo até você tocar em Salvar lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次你打开应用时，Doddy 会在记录界面打开它。在你在那里轻点“保存”之前，不会保存任何内容。"
          }
        }
      }
    },
    "Done": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotovo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluído"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Open Doddy to check it and tap Save. It isn't saved yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Doddy, prüfe es und tippe auf Speichern. Es ist noch nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Doddy para revisarlo y toca Guardar. Aún no está guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Doddy pour vérifier et touche Enregistrer. Ce n’est pas encore enregistré."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Doddyja da to provjeriš i dodirneš Spremi. Još nije spremljeno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Doddy per controllarlo e tocca Salva. Non è ancora salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyを開いて内容を確認し、「保存」をタップしてください。まだ保存されていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Doddy’ego, sprawdź to i stuknij Zapisz. To jeszcze nie jest zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Doddy para conferir e tocar em Salvar. Ainda não está salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Doddy 检查后轻点“保存”。它还没有保存。"
          }
        }
      }
    },
    "Ready in Doddy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit in Doddy"
          }
        },
        "es": {
