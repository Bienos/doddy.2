{
  "name": "doddy-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Doddy Web (ADR-600): the browser workspace. Built to web/dist and served by backend/ on the same origin as its API.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "7.18.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
