# Names only. Real values live in the Vercel project's environment settings, never in git.
OPENAI_API_KEY=
# Exact model id from your OpenAI account's model list. No default on purpose.
OPENAI_MODEL=
# At least 32 random characters, e.g. `openssl rand -base64 48`.
GATEWAY_TOKEN_SECRET=
# Comma-separated invite codes handed to private-beta testers. Remove one to revoke it (and its tokens).
GATEWAY_INVITE_CODES=
# Optional limits (defaults in src/config.js)
# GATEWAY_RATE_PER_MINUTE=10
# GATEWAY_RATE_PER_DAY=200
# GATEWAY_GLOBAL_PER_DAY=2000
