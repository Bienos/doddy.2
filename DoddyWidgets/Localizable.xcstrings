    "All ticked. Shopping mode ends by itself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles abgehakt. Der Einkaufsmodus endet von selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo marcado. El modo compra termina solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est coché. Le mode courses se termine tout seul."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve označeno. Način kupnje sam se završava."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto spuntato. La modalità spesa termina da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてチェック済みです。買い物モードは自動で終了します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko odhaczone. Tryb zakupów zakończy się sam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo marcado. O modo compras termina sozinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已全部勾选。购物模式会自动结束。"
          }
