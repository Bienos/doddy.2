    "Opens Doddy and starts a voice conversation. Doddy listens only while the conversation is open.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Doddy und startet ein Sprachgespräch. Doddy hört nur zu, solange das Gespräch offen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Doddy y empieza una conversación de voz. Doddy escucha solo mientras la conversación está abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Doddy et démarre une conversation vocale. Doddy n’écoute que pendant que la conversation est ouverte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara Doddyja i započinje glasovni razgovor. Doddy sluša samo dok je razgovor otvoren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Doddy e avvia una conversazione vocale. Doddy ascolta solo mentre la conversazione è aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyを開いて音声会話を始めます。Doddyが聞いているのは、会話が開いている間だけです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Doddy’ego i zaczyna rozmowę głosową. Doddy słucha tylko, gdy rozmowa jest otwarta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Doddy e começa uma conversa por voz. O Doddy só ouve enquanto a conversa está aberta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Doddy 并开始语音对话。Doddy 只在对话进行期间聆听。"
          }
        }
      }
    },
