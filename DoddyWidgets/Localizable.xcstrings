    "Open Doddy": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Doddy’ego"
          }
        }
      }
    },
    "Opens Doddy and starts a voice conversation. Doddy listens only while the conversation is open.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Doddy’ego i zaczyna rozmowę głosową. Doddy słucha tylko, gdy rozmowa jest otwarta."
          }
        }
      }
    },
    "Opens Doddy ready for a new note. Nothing is saved until you tap Save.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Doddy’ego gotowego na nową notatkę. Nic nie jest zapisywane, dopóki nie stukniesz Zapisz."
          }
        }
      }
    },
    "Paused": {
      "extractionState": "manual",
      "localizations": {
