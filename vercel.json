{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "doddy": {
      "root": "backend",
      "framework": "node",
      "runtime": "node",
      "buildCommand": "npm ci && npm run build"
    },
    "doddy-messaging": {
      "root": "server/messaging",
      "framework": "fastify",
      "buildCommand": "npm ci && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/webhooks/(.*)",
      "destination": { "service": "doddy-messaging" }
    },
    {
      "source": "/healthz",
      "destination": { "service": "doddy-messaging" }
    },
    {
      "source": "/v1/(accounts?|device|phone|updates|calls|call-notes|memory-copy|news)(/.*)?",
      "destination": { "service": "doddy-messaging" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "doddy" }
    }
  ]
}
