    "Notes saved here stay on this Mac. They aren't on your iPhone, and your iPhone's notes aren't here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gespeicherte Notizen bleiben auf diesem Mac. Sie sind nicht auf deinem iPhone, und die Notizen von deinem iPhone sind nicht hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas guardadas aquí se quedan en este Mac. No están en tu iPhone, y las notas de tu iPhone no están aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes enregistrées ici restent sur ce Mac. Elles ne sont pas sur ton iPhone, et les notes de ton iPhone ne sont pas ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilješke spremljene ovdje ostaju na ovom Macu. Nisu na tvojem iPhoneu, a bilješke s iPhonea nisu ovdje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note salvate qui restano su questo Mac. Non sono sul tuo iPhone, e le note del tuo iPhone non sono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで保存したメモはこのMacにとどまります。iPhoneには入らず、iPhoneのメモもここには表示されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki zapisane tutaj zostają na tym Macu. Nie ma ich na Twoim iPhonie, a notatek z iPhone'a nie ma tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas salvas aqui ficam neste Mac. Elas não estão no seu iPhone, e as notas do seu iPhone não estão aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里保存的笔记只留在这台 Mac 上。它们不在你的 iPhone 上，你 iPhone 上的笔记也不在这里。"
          }
        }
      }
    },
    "Nothing saved on this Mac yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac ist noch nichts gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada guardado en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’enregistré sur ce Mac pour l’instant."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovom Macu još ništa nije spremljeno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente salvato su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacにはまだ何も保存されていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym Macu nic jeszcze nie zapisano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada salvo neste Mac ainda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上还没有保存任何内容。"
          }
        }
      }
    },
