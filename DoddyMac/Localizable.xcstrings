{
  "sourceLanguage": "en",
  "strings": {
    "%@, %lld notes": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, notatki: %lld"
          }
        }
      }
    },
    "%@. Tap to tick.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Kliknij, aby zaznaczyć."
          }
        }
      }
    },
    "%lld clips waiting": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czekające wycinki: %lld"
