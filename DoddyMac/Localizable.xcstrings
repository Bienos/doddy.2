    "Doddy": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy"
          }
        }
      }
    },
    "Doddy couldn't open its notes file, so saving is switched off. Nothing was deleted or reset. Try quitting and reopening Doddy. (%@)": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy nie mógł otworzyć pliku z notatkami, więc zapisywanie jest wyłączone. Nic nie zostało usunięte ani zresetowane. Zamknij Doddy i otwórz go ponownie. (%@)"
          }
        }
      }
    },
    "Doddy for Mac doesn't talk or listen yet. Talking to Doddy is on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy na Maca jeszcze nie mówi ani nie słucha. Rozmowa z Doddym jest dostępna na iPhonie."
          }
        }
      }
    },
    "Doddy keeps up to %lld lists.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy przechowuje do %lld list."
          }
        }
      }
    },
    "Done": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe"
          }
        }
      }
    },
    "Done: %@. Tap to untick.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrobione: %@. Kliknij, aby odznaczyć."
          }
        }
      }
    },
    "Edit and save…": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj i zapisz…"
          }
        }
      }
    },
    "Everything you write here stays on this Mac. Doddy for Mac doesn't use the internet, has no account, and sends nothing anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co tu piszesz, zostaje na tym Macu. Doddy na Maca nie korzysta z internetu, nie ma konta i niczego nigdzie nie wysyła."
          }
        }
      }
    },
    "Export as a text file…": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj jako plik tekstowy…"
          }
        }
      }
    },
    "Extensions": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozszerzenia"
          }
        }
      }
    },
    "Fact": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fakt"
          }
        }
      }
    },
    "First version: %@": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsza wersja: %@"
          }
        }
      }
    },
    "For now, talk to Doddy on your iPhone. On this Mac you can write notes and lists, and send pages from Safari or the Share menu.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie rozmawiaj z Doddym na iPhonie. Na tym Macu możesz pisać notatki i listy oraz wysyłać strony z Safari lub z menu Udostępnij."
          }
        }
      }
    },
    "Give the list a name.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj liście nazwę."
          }
        }
      }
    },
    "In any app, choose Share › Doddy. If it isn't listed, turn it on in System Settings › Privacy & Security › Extensions › Sharing.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W dowolnej aplikacji wybierz Udostępnij › Doddy. Jeśli go nie ma, włącz go w Ustawieniach systemowych › Prywatność i ochrona › Rozszerzenia › Udostępnianie."
          }
        }
      }
    },
    "Intention": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiar"
          }
        }
      }
    },
    "It is removed from this Mac. This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie usunięta z tego Maca. Tego nie można cofnąć."
