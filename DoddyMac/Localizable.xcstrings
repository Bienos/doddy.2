        }
      }
    },
    "A clip is not a note. It becomes one only when you press Save in the Clips list.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycinek nie jest notatką. Staje się nią dopiero po kliknięciu Zapisz na liście wycinków."
          }
        }
      }
    },
    "A list name can have up to %lld characters.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa listy może mieć do %lld znaków."
          }
        }
      }
    },
    "A stored note couldn't be read. Nothing was deleted.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać zapisanej notatki. Nic nie zostało usunięte."
