    "That clip couldn't be thrown away. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odrzucić tego wycinka. Spróbuj ponownie."
          }
        }
      }
    },
    "That item is already on the list.": {
      "extractionState": "manual",
      "localizations": {
