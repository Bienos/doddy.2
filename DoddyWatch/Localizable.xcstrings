    "Notes and lists are hidden. Turn on “Show notes and lists on Apple Watch” in Doddy's Settings on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen und Listen sind ausgeblendet. Schalte „Notizen und Listen auf der Apple Watch zeigen“ in den Doddy-Einstellungen auf deinem iPhone ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas y las listas están ocultas. Activa “Mostrar notas y listas en el Apple Watch” en los Ajustes de Doddy en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes et les listes sont masquées. Active « Afficher les notes et les listes sur l’Apple Watch » dans les Réglages de Doddy sur ton iPhone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilješke i popisi su skriveni. Uključi „Prikaži bilješke i popise na Apple Watchu“ u Doddyjevim Postavkama na iPhoneu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Note e liste sono nascoste. Attiva “Mostra note e liste su Apple Watch” nelle Impostazioni di Doddy sul tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモとリストは非表示です。iPhoneのDoddyの設定で「Apple Watchにメモとリストを表示」をオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki i listy są ukryte. Włącz „Pokazuj notatki i listy na Apple Watch” w Ustawieniach Doddy’ego na iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas e listas estão ocultas. Ative “Mostrar notas e listas no Apple Watch” nos Ajustes do Doddy no seu iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记和清单已隐藏。请在 iPhone 上 Doddy 的设置中开启“在 Apple Watch 上显示笔记和清单”。"
          }
        }
      }
    },
    "Open Doddy on your iPhone once to see your notes and lists here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Doddy einmal auf deinem iPhone, um deine Notizen und Listen hier zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Doddy en tu iPhone una vez para ver aquí tus notas y listas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Doddy une fois sur ton iPhone pour voir tes notes et tes listes ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednom otvori Doddyja na iPhoneu da ovdje vidiš svoje bilješke i popise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Doddy sul tuo iPhone una volta per vedere qui le tue note e liste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでDoddyを一度開くと、ここにメモとリストが表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz raz Doddy’ego na iPhonie, żeby zobaczyć tu swoje notatki i listy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Doddy no seu iPhone uma vez para ver suas notas e listas aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开一次 Doddy，即可在这里看到你的笔记和清单。"
          }
        }
      }
    },
