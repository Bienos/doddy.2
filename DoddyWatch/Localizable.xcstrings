    "Check the words, then Save.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den Text, dann Speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el texto y luego toca Guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie les mots, puis Enregistrer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjeri riječi, zatim Spremi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il testo, poi tocca Salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容を確認して、「保存」をタップしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź słowa, potem stuknij Zapisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique as palavras e toque em Salvar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查内容，然后保存。"
          }
        }
      }
    },
