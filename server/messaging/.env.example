# Copy to .env for local runs. Leave a provider block empty to switch that feature off (API answers 503).
DATABASE_URL=postgres://doddy:doddy@localhost/doddy
PORT=3000
# Proxies in front that append to X-Forwarded-For (Render: 1). Used for per-IP rate limits.
TRUST_PROXY_HOPS=1
# Verify codes the whole server may start per UTC day (SMS cost cap).
VERIFY_DAILY_CAP=200
# Anonymous accounts (POST /v1/accounts, no sign-in; decision 2026-11-08-required-account). 0 (the default): refused with
# 403 sign_in_required, so a new iPhone gets its account here only by signing in with a Doddy account
# (POST /v1/accounts/sign-in, which needs SUPABASE_URL). 1: made as before, within the caps below. Accounts and device
# tokens made earlier keep working either way.
ANONYMOUS_ACCOUNTS=0
# Abuse limits (security review 4 Nov 2026, ADR-702 to ADR-705). Accounts are free, so what they can
# spend is capped per client address, per account and for the server. All optional; defaults in brackets.
# Accounts made per UTC day, per client address (IPv6: per /64) and in all, on top of 10 an hour per address
# (many phones share one carrier address, so keep the first one generous): [50] [1000]
# ACCOUNTS_DAILY_PER_IP= ACCOUNTS_DAILY_PER_SERVER=
# An account is "established" with a verified phone number or once it is this many hours old [24]; the rest share the small
# daily pools below, inside each feature's server-wide cap (errands [10], leaflets [200], Messages [200], digests by the
# AI writer [50]; 0 shuts a pool).
# NEW_ACCOUNT_HOURS= ERRANDS_DAILY_NEW_ACCOUNTS= DEALS_DAILY_NEW_ACCOUNTS= ASSISTANT_DAILY_NEW_ACCOUNTS= NEWS_WRITER_DAILY_NEW_ACCOUNTS=
# Memory on calls (signed-in accounts only): stored ciphertext per account (1-8) and for the server, in MB: [4] [400].
# Over either, a copy is refused (413 memory_copy_too_large, 507 memory_copy_server_full) and the earlier one is kept.
# MEMORY_COPY_MB_PER_ACCOUNT= MEMORY_COPY_MB_PER_SERVER=
# Digests the AI writer writes per UTC day (manual, scheduled, On my radar's daily summaries), per account and for the
# server: [5] [500]. Past a cap a digest is plain headlines (errorCode writer_daily_limit).
# NEWS_WRITER_DAILY_PER_ACCOUNT= NEWS_WRITER_DAILY_PER_SERVER=
# The leaflet catalog (decision 2026-11-12-leaflet-catalog): "1" lets the worker read each chain's leaflets in the background,
# once for everyone, every DEALS_CATALOG_EVERY_HOURS [6] (only pages not read before go to the reader, at most
# DEALS_CATALOG_MAX_PAGES [160] a chain a scan), and answers searches from what it kept. Needs DEALS_ENABLED=1. [0]
# DEALS_CATALOG_ENABLED= DEALS_CATALOG_EVERY_HOURS= DEALS_CATALOG_MAX_PAGES=
# The catalog's daily token budget (decision 2026-11-13-leaflet-results-and-deal-watches): input plus output tokens per
# Warsaw day, per chain [1500000] and for all chains [6000000]; past it, pages wait for the next day. 0 reads no new page.
# DEALS_CATALOG_DAILY_TOKENS_PER_CHAIN= DEALS_CATALOG_DAILY_TOKENS=
# Deal watches (same decision): "1" lets the app keep an item, a price and chains that the server checks against the catalog
# after its scans, at most once a day, with no page read. Needs MEMORY_ENCRYPTION_KEY and DEALS_CATALOG_ENABLED=1. [0]
# Watches per account [10] and for the server [5000], pushes per account in 24 hours [3], days a watch lasts [60].
# DEAL_WATCHES_ENABLED= DEAL_WATCHES_MAX_PER_ACCOUNT= DEAL_WATCHES_MAX_PER_SERVER= DEAL_WATCHES_PUSHES_PER_DAY= DEAL_WATCHES_DAYS=
# Verification codes per client address and per account and UTC day, next to the per-number and server caps: [20] [6]
# VERIFY_DAILY_PER_IP= VERIFY_DAILY_PER_ACCOUNT=
# Calling codes, without "+", whose numbers may be verified, texted and called. Default: Poland, the rest of the EU and EEA,
# the UK and Switzerland. A number outside the list is refused when verified and again when a text or call is sent.
# PHONE_ALLOWED_COUNTRY_CODES=30,31,32,33,34,351,352,353,354,356,357,358,359,36,370,371,372,385,386,39,40,41,420,421,423,43,44,45,46,47,48,49
# Texts queued per account and for the server per UTC day, and "call me" calls for the server per UTC day: [30] [300] [20]
# SMS_DAILY_PER_ACCOUNT= SMS_DAILY_PER_SERVER= OUTBOUND_CALLS_DAILY_PER_SERVER=
# Calls to Doddy's number put through to the phone agent per account (rolling 24 h, 1-1000) [20], and per UTC day for
# the server, call-backs included (1-100000) [200]. Past either the caller hears "that's the limit for today".
# INBOUND_CALLS_DAILY_PER_ACCOUNT=
# INBOUND_CALLS_DAILY_PER_SERVER=
# Call-backs (decision 2026-11-12-call-back-limits): a call from a number Doddy dialled for a user is put through for
# this many days after the last dial (1-90) [7], at most this many times a day per number and user (1-20) [3].
# CALLBACK_ROUTE_DAYS=
# CALLBACK_FORWARDS_PER_ROUTE_DAY=
# 1 = run the worker inside the web service (one service instead of web + worker)
RUN_WORKER_IN_WEB=0
# Public https origin of this server; required to verify Twilio webhook signatures.
PUBLIC_BASE_URL=

# Apple Push Notification service (token auth, .p8 key from the Apple Developer account)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=

# Twilio: SMS via a Messaging Service (Advanced Opt-Out on), phone verification via Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=

# ElevenLabs API key: connects calls to the phone agent (register-call, ADR-750). App voice tokens
# come from server/voice-token.
ELEVENLABS_API_KEY=

# Phone calls (S2; through this server since ADR-750). Twilio rings and routes calls with the
# TWILIO_* values above. Generate the key and secret with: openssl rand -base64 32
# (the tool secret must be at least 32 characters; the server refuses to start otherwise)
# MEMORY_ENCRYPTION_KEY encrypts memory copies and call notes; losing it makes them unreadable.
# A deployed server refuses to start without it (src/deployment.ts): deployed means NODE_ENV=production,
# RENDER set (Render sets it on every service), or a PUBLIC_BASE_URL other servers can reach (any host but
# localhost, a loopback address or a .localhost/.test/.example/.invalid name). Local runs may leave it empty.
MEMORY_ENCRYPTION_KEY=
# Key versions, for a rotation (README, "Rotating MEMORY_ENCRYPTION_KEY"): the current key's version
# (default 1, the version of every row written before versions existed) and, only while
# scripts/reencrypt.mjs rewrites the rows, the previous key with the version its rows were written with.
MEMORY_ENCRYPTION_KEY_VERSION=
MEMORY_ENCRYPTION_KEY_PREVIOUS=
MEMORY_ENCRYPTION_KEY_PREVIOUS_VERSION=
ELEVENLABS_TOOL_SECRET=
ELEVENLABS_PHONE_AGENT_ID=
# Doddy's Twilio number in E.164 (+48…): the caller ID of Doddy's calls, shown in the app.
DODDY_PHONE_NUMBER=

# Doddy's records at Twilio (messages and calls) are deleted this many hours after they are final
# (ADR-753). 0 = as soon as Twilio allows (about 2 minutes). Default 24. Task calls and their
# takeover legs are deleted on the task account with the TWILIO_TASK_* pair (below), once their
# price has been read.
TWILIO_RECORD_DELETE_AFTER_HOURS=

# Quiet hours for calls the user books for later (ADR-754), HH:MM on the user's own clock. No such
# call rings inside them unless its card allowed it. Defaults 21:00 and 08:00.
QUIET_HOURS_START=
QUIET_HOURS_END=

# Calls Doddy makes for the user (ADR-500, docs/decisions/calls.md). Off until the agent id,
# webhook secret and a from-number are set. Use a Poland-only Twilio subaccount; the
# TWILIO_TASK_* pair falls back to TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN, the number to
# DODDY_PHONE_NUMBER. Create the agent with scripts/setup-task-call-agent.mjs.
TWILIO_TASK_ACCOUNT_SID=
TWILIO_TASK_AUTH_TOKEN=
TASK_CALL_FROM_NUMBER=
ELEVENLABS_TASK_AGENT_ID=
# The booking agent "Doddy (books for you)" (decision 2026-11-12-book-agent), created by
# scripts/setup-task-call-agent.mjs --agent book. Empty: calls that book are refused (503 booking_not_configured).
ELEVENLABS_TASK_BOOK_AGENT_ID=
ELEVENLABS_TASK_ORDER_AGENT_ID=
# The ElevenLabs post-call webhook's HMAC secret (at least 16 characters).
ELEVENLABS_WEBHOOK_SECRET=
# 1 stops every call by Doddy at once, including calls in progress (Doddy says goodbye).
TASK_CALLS_KILL_SWITCH=0
# off (default until the legal basis is confirmed) | nagrywana | zapisywana. Audio is never recorded.
CALL_RECORDING_NOTICE=off
# Limits can only be lowered (code ceilings in parentheses): per user 3/hour (3), 10/day (10);
# per number 2/day per user (2), 3/day in all (3), 15 min apart (at least 15); 50/day in all (200);
# longest call 300 s (300). A "user" is the verified number or the account: a new number does not start the count again.
# TASK_CALL_LIMIT_USER_HOUR= TASK_CALL_LIMIT_USER_DAY= TASK_CALL_LIMIT_DEST_USER_DAY=
# TASK_CALL_LIMIT_DEST_DAY= TASK_CALL_DEST_GAP_MINUTES= TASK_CALL_LIMIT_GLOBAL_DAY= TASK_CALL_MAX_SECS=
# Numbers Doddy must never call for anyone (ADR-705), E.164, comma-separated: a stop list for a callee who asked not to be
# called. The real opt-out process is for the owner and counsel to decide (docs/decisions/calls.md).
# TASK_CALL_BLOCKED_NUMBERS=
# Who may read what the other side said on a call (ADR-730): the owner's own verified phone number(s), E.164,
# comma-separated; the account that verified one of them gets the live words and the saved transcript, for the logs
# in the app. Empty (the default): nobody. Every other account gets the answer card (summary, quote, next step)
# without the transcript, and the live words are not sent to it at all.
# CALL_TRANSCRIPT_PHONE_NUMBERS=
# Unit prices for the estimated cost items; unset means that item is "unknown", never zero.
PRICE_TWILIO_TRANSCRIPTION_USD_PER_MIN=
PRICE_TWILIO_CONFERENCE_USD_PER_PARTICIPANT_MIN=
PRICE_ELEVENLABS_USD_PER_CREDIT=
# Twilio <Say> voice for the fixed Polish lines (apology, goodbye, takeover prompt).
TASK_CALL_SAY_VOICE=Polly.Ewa

# News digests. Without an AI key digests are plain headlines; without GNEWS_API_KEY
# keyword topics only match stories in the RSS feeds.
ANTHROPIC_API_KEY=
# Or OpenAI, used only when ANTHROPIC_API_KEY is empty (ADR-197). OPENAI_MODEL defaults to gpt-5-mini.
OPENAI_API_KEY=
OPENAI_MODEL=
GNEWS_API_KEY=

# Errands (ADR-570, docs/implementation/ERRANDS.md): Doddy researches a task in the background with
# Claude's web search and web fetch (a finite budget per errand, below). Runs only when ANTHROPIC_API_KEY and
# MEMORY_ENCRYPTION_KEY are set; 0 refuses new errands and starts no queued one.
ERRANDS_ENABLED=0
# Defaults: claude-opus-5-5, effort high (low|medium|high|xhigh|max), 30-minute time limit per run
# (1-120), 5 queued or running errands per account (1-20), 10 approvals a UTC day per account and 30 for
# the server (ADR-673; counted where deleting an account can't give them back).
# ERRANDS_MODEL= ERRANDS_EFFORT= ERRAND_TIME_LIMIT_MINUTES= ERRANDS_MAX_OPEN= ERRANDS_DAILY_PER_ACCOUNT= ERRANDS_DAILY_PER_SERVER=
# The research budget of one errand (ADR-702; this narrows "no cap on look-ups"): web searches [40], web fetches [40], research
# requests (the first and each resume after a pause) [30] and output tokens over all of them [300000, or 0 or at least 10000].
# 0 means no limit, and is for an owner who sets it on purpose. The time limit above still applies.
# ERRAND_MAX_SEARCHES= ERRAND_MAX_FETCHES= ERRAND_MAX_REQUESTS= ERRAND_MAX_OUTPUT_TOKENS=

# Price watches (shopping stage 2, docs/implementation/SHOPPING_WATCH.md): after one yes, the worker reads
# one shop page about 4 times a day for 30 days and sends one push when the confirmed price is at or
# below the user's number. No model, no other key. Needs MEMORY_ENCRYPTION_KEY; 0 answers 503
# watches_disabled and checks nothing.
WATCHES_ENABLED=0
# Texts to the user's contacts from Doddy's number (decision 2026-11-09-texts-to-contacts): one tap per text, at most 50
# a day per account. 0 (the default) answers 503 contact_texts_off. Needs MEMORY_ENCRYPTION_KEY and Twilio SMS.
CONTACT_TEXTS_ENABLED=0
# Defaults: 5 active watches per account (1-20), 6 hours between two checks of one watch (6-24; the card
# promises 4 a day, so never fewer than 6 hours).
# WATCHES_MAX_OPEN= WATCHES_CHECK_HOURS=

# On my radar alerts (decision 2026-11-10-radar-alerts): the iPhone stores here only the follows a person let
# "Doddy's server check for you"; the worker reads their feeds (shared cache) about every 20 minutes, records
# new matching stories for the app and queues at most one push (as it happens, outside quiet hours, at most 8
# a day; or a daily summary at the person's time). 0 answers 503 radar_disabled to a new alert and checks nothing.
RADAR_ALERTS_ENABLED=0
# Article summaries for On my radar (POST /v1/news/summary): the person taps a story and Claude writes a short summary of
# the article from the publisher's page (read politely: robots.txt and the AI-input content signal honoured). Needs
# ANTHROPIC_API_KEY. 0 answers 503 summary_off. Defaults: claude-haiku-5-5, 40 summaries a UTC day per account (1-1000)
# and 1000 for the server; a summary served from the cache counts nothing.
NEWS_SUMMARY_ENABLED=0
# NEWS_SUMMARY_MODEL= NEWS_SUMMARY_DAILY_PER_ACCOUNT= NEWS_SUMMARY_DAILY_PER_SERVER=
# Deliveries through Uber Direct (decision 2026-11-12-uber-direct-deliveries). Off unless all of these are set and
# UBER_DIRECT_ENABLED=1. The client secret goes only into Render's environment, never into a file or the app.
# Uber bills the account these credentials belong to; the caps below hold for every account and the whole server.
UBER_DIRECT_ENABLED=0
# UBER_DIRECT_CLIENT_ID=
# UBER_DIRECT_CLIENT_SECRET=
# UBER_DIRECT_CUSTOMER_ID=
# test (Uber's sandbox and its simulated courier) or live (real couriers, real charges)
UBER_DIRECT_MODE=test
# Highest price Doddy confirms, in grosze (6000 = 60 zł), and deliveries per rolling 24 hours.
UBER_DIRECT_MAX_FEE=6000
UBER_DIRECT_DAILY_PER_ACCOUNT=2
UBER_DIRECT_DAILY_PER_SERVER=5

# Messages (ADR-585, ADR-586): the app's typed conversation asks Claude through this server. Text only, no
# tools. Runs only when ANTHROPIC_API_KEY is set; 0 answers 503 notConfigured. Nothing the person writes is
# stored or logged; the database keeps counts per account and day.
ASSISTANT_ENABLED=0
# Defaults: claude-haiku-5-5, effort medium (low|medium|high), 100 requests per account and 1000 for the
# whole server per UTC day (ceilings 1000 and 100000).
# ASSISTANT_MODEL= ASSISTANT_EFFORT= ASSISTANT_DAILY_PER_ACCOUNT= ASSISTANT_DAILY_PER_SERVER=

# Studio (ADR-740, docs/implementation/STUDIO.md): research a topic, then make a brief and an
# infographic with Claude's code execution and Doddy's skills. Runs only with ANTHROPIC_API_KEY,
# MEMORY_ENCRYPTION_KEY and STUDIO_SKILLS (ids from scripts/studio_skills.sh upload); 0 refuses new jobs.
STUDIO_ENABLED=0
STUDIO_SKILLS=
# Defaults: Haiku 5.5 plans, extracts claims and renders; Sonnet 5.5 researches and writes; 15 searches and 15
# fetches per job; no blocked domains; a 150,000-token research budget; $2 per job; $3 per account per UTC day;
# 20 minutes per job; 3 open jobs per account. STUDIO_MODEL sets every step's model first; a step overrides it.
# Per UTC day (ADR-742): 3 approvals per account, 10 for the server, a closed pool for new accounts (0) and $10
# committed by the server (each approval holds the job limit until its cost is known), and a hard ceiling of $100
# per UTC calendar month for the whole server (the owner said "100usd cap" with no period: this is the safest reading).
# STUDIO_MODEL= STUDIO_MODEL_PLAN= STUDIO_MODEL_RESEARCH= STUDIO_MODEL_PACK= STUDIO_MODEL_WRITE= STUDIO_MODEL_MAKE=
# STUDIO_MAX_SEARCHES= STUDIO_MAX_FETCHES= STUDIO_BLOCKED_DOMAINS= STUDIO_TASK_BUDGET_TOKENS=
# STUDIO_JOB_LIMIT_USD= STUDIO_DAILY_CAP_USD= STUDIO_TIME_LIMIT_MINUTES= STUDIO_MAX_OPEN=
# STUDIO_DAILY_PER_ACCOUNT= STUDIO_DAILY_PER_SERVER= STUDIO_DAILY_NEW_ACCOUNTS= STUDIO_DAILY_SERVER_CAP_USD=
# STUDIO_MONTHLY_SERVER_CAP_USD=

# Tests only: a disposable database (the test suite drops and recreates its schema)
TEST_DATABASE_URL=
