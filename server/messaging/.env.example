# Copy to .env for local runs. Leave a provider block empty to switch that feature off (API answers 503).
DATABASE_URL=postgres://doddy:doddy@localhost/doddy
PORT=3000
# Proxies in front that append to X-Forwarded-For (Render: 1). Used for per-IP rate limits.
TRUST_PROXY_HOPS=1
# Verify codes the whole server may start per UTC day (SMS cost cap).
VERIFY_DAILY_CAP=200
# 1 = run the worker inside the web service (one service instead of web + worker)
RUN_WORKER_IN_WEB=0
# Public https origin of this server; required to verify Twilio webhook signatures.
PUBLIC_BASE_URL=

# Apple Push Notification service (token auth, .p8 key from the Apple Developer account)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=

# Twilio: SMS via a Messaging Service (Advanced Opt-Out on), phone verification via Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=

# ElevenLabs API key: outbound phone calls (S2). App voice tokens come from server/voice-token.
ELEVENLABS_API_KEY=

# Phone calls (S2). Generate the key and secret with: openssl rand -base64 32
# (the tool secret must be at least 32 characters; the server refuses to start otherwise)
# MEMORY_ENCRYPTION_KEY encrypts memory copies and call notes; losing it makes them unreadable.
MEMORY_ENCRYPTION_KEY=
ELEVENLABS_TOOL_SECRET=
ELEVENLABS_PHONE_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
DODDY_PHONE_NUMBER=

# Calls Doddy makes for the user (ADR-500, docs/decisions/calls.md). Off until the agent id,
# webhook secret and a from-number are set. Use a Poland-only Twilio subaccount; the
# TWILIO_TASK_* pair falls back to TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN, the number to
# DODDY_PHONE_NUMBER. Create the agent with scripts/setup-task-call-agent.mjs.
TWILIO_TASK_ACCOUNT_SID=
TWILIO_TASK_AUTH_TOKEN=
TASK_CALL_FROM_NUMBER=
ELEVENLABS_TASK_AGENT_ID=
# The ElevenLabs post-call webhook's HMAC secret (at least 16 characters).
ELEVENLABS_WEBHOOK_SECRET=
# 1 stops every call by Doddy at once, including calls in progress (Doddy says goodbye).
TASK_CALLS_KILL_SWITCH=0
# off (default until the legal basis is confirmed) | nagrywana | zapisywana. Audio is never recorded.
CALL_RECORDING_NOTICE=off
# Limits can only be lowered (code ceilings in parentheses): per user 3/hour (3), 10/day (10);
# per number 2/day per user (2), 3/day in all (3), 15 min apart (at least 15); 50/day in all (200);
# longest call 300 s (300).
# TASK_CALL_LIMIT_USER_HOUR= TASK_CALL_LIMIT_USER_DAY= TASK_CALL_LIMIT_DEST_USER_DAY=
# TASK_CALL_LIMIT_DEST_DAY= TASK_CALL_DEST_GAP_MINUTES= TASK_CALL_LIMIT_GLOBAL_DAY= TASK_CALL_MAX_SECS=
# Unit prices for the estimated cost items; unset means that item is "unknown", never zero.
PRICE_TWILIO_TRANSCRIPTION_USD_PER_MIN=
PRICE_TWILIO_CONFERENCE_USD_PER_PARTICIPANT_MIN=
PRICE_ELEVENLABS_USD_PER_CREDIT=
# Twilio <Say> voice for the fixed Polish lines (apology, goodbye, takeover prompt).
TASK_CALL_SAY_VOICE=Polly.Ewa

# News digests. Without an AI key digests are plain headlines; without GNEWS_API_KEY
# keyword topics only match stories in the RSS feeds.
ANTHROPIC_API_KEY=
# Or OpenAI, used only when ANTHROPIC_API_KEY is empty (ADR-197). OPENAI_MODEL defaults to gpt-5-mini.
OPENAI_API_KEY=
OPENAI_MODEL=
GNEWS_API_KEY=

# Errands (ADR-566, docs/implementation/ERRANDS.md): Doddy researches a task in the background with
# Claude's web search and web fetch (no cap on look-ups). Runs only when ANTHROPIC_API_KEY and
# MEMORY_ENCRYPTION_KEY are set; 0 refuses new errands and starts no queued one.
ERRANDS_ENABLED=0
# Defaults: claude-opus-5-5, effort high (low|medium|high|xhigh|max), 30-minute time limit per run
# (1-120), 5 queued or running errands per account (1-20).
# ERRANDS_MODEL= ERRANDS_EFFORT= ERRAND_TIME_LIMIT_MINUTES= ERRANDS_MAX_OPEN=

# Tests only: a disposable database (the test suite drops and recreates its schema)
TEST_DATABASE_URL=
