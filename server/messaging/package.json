{
  "name": "doddy-server",
  "private": true,
  "version": "0.1.0",
  "description": "Doddy server: accounts, push notifications, SMS updates, voice tokens.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/src/migrate.js",
    "start": "node dist/src/index.js",
    "worker": "node dist/src/worker.js",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 dist/test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@fastify/formbody": "9.0.1",
    "@fastify/rate-limit": "11.2.1",
    "fast-xml-parser": "5.11.1",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "twilio": "5.13.1",
    "typescript": "5.9.3"
  }
}
