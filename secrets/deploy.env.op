# Host API tokens for the secrets sync tool, from the owner-only 1Password vault (ADR-493).
# References only, never values. Use:
#   op run --env-file=secrets/deploy.env.op -- node tools/secrets/sync.mjs
# A Vercel token scoped to the Doddy projects; a Render API key (it can read every Render secret).
VERCEL_TOKEN=op://doddy-deploy/vercel-token/credential
RENDER_API_KEY=op://doddy-deploy/render-api-key/credential
