  "version": 1,
  "about": "Recall benchmark corpus (OP-016 / OP-008). Invented everyday notes and questions in English and Polish, run against the real SQLite store and RepositoryRecallService by Packages/DoddyCore/Tests/DoddyPersistenceTests/RecallBenchmarkTests.swift. No real user data.",
  "labelled_by": "Claude (AI), 2026-10-10. NOT reviewed by the owner or a native Polish speaker. Treat the numbers as a regression signal for the word rules, not as measured user accuracy.",
  "label_rules": "relevant = every note a person asking this would accept as the answer. Empty relevant = nothing saved answers it, so the honest result is no match. A related but wrong note (another wifi password, another insurance) is not relevant.",
  "tags": {
    "exact": "question uses the note's own words",
    "no_diacritics": "Polish typed without ą ę ó ł ś ż ź ć ń",
    "word_ending": "same word with a different ending (inflection, plural, -ed)",
    "cross_language": "question in one language, answer saved in the other",
    "typo": "misspelt word",
    "spoken_number": "digits in the question, number words in the note, or the reverse",
    "paraphrase": "different words for the same thing; lexical rules are not expected to find these",
    "possessive": "English 's in the question",
    "should_miss": "nothing saved answers it"
  },
