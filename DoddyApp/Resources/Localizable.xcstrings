    "The original capture stays exactly as it was and remains viewable.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche Erfassung bleibt genau, wie sie war, und bleibt einsehbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura original se queda exactamente como estaba y se puede seguir viendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie d’origine reste exactement telle qu’elle était et reste consultable."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvorni zapis ostaje točno onakav kakav je bio i može se pogledati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisizione originale resta esattamente com'era e rimane visibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の記録はそのままの形で残り、いつでも見られます。"
