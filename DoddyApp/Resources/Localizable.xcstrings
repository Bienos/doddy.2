    "The photo's text was added below. Reading photos makes mistakes, so check it before saving.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text des Fotos wurde unten hinzugefügt. Beim Lesen von Fotos passieren Fehler, also prüfe ihn vor dem Speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de la foto se ha añadido abajo. Leer fotos da errores, así que revísalo antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte de la photo a été ajouté ci-dessous. La lecture de photos fait des erreurs, donc vérifie avant d’enregistrer."
