    },
    "Let them say something first, so Doddy can hear their language.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass sie zuerst etwas sagen, damit Doddy ihre Sprache hören kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que la otra persona diga algo primero, para que Doddy oiga su idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse-les dire quelque chose d’abord, pour que Doddy entende leur langue."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neka prvo nešto kažu, da Doddy čuje njihov jezik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che dicano prima qualcosa, così Doddy può sentire la loro lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず相手に何か話してもらうと、Doddyが相手の言語を聞き取れます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niech najpierw coś powiedzą, żeby Doddy usłyszał ich język."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe a pessoa falar algo primeiro, para o Doddy ouvir o idioma dela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让对方先说几句，这样 Doddy 才能听出对方的语言。"
          }
        }
      }
    },
