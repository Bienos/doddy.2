        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de ce qui a été appris n’est partagé. Doddy ne peut pas l’utiliser en conversation tant que tu n’actives pas ceci."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa naučeno ne dijeli se. Doddy to ne može koristiti u razgovoru dok ovo ne uključiš."
