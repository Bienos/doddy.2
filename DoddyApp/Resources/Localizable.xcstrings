    },
    "Voice": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głos"
          }
        }
      }
    },
    "Voice and personality": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głos i osobowość"
          }
        }
      }
    },
    "Warm and engaging": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciepły i angażujący"
          }
        }
      }
    },
    "Warm, smooth and steady": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciepły, gładki i stabilny"
          }
        }
      }
    },
    "Way": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposób"
          }
        }
      }
    },
    "Weekdays": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni robocze"
          }
        }
      }
    },
    "Weekdays only": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko dni robocze"
          }
        }
      }
    },
    "Weekly tidy-up": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotygodniowe porządki"
          }
        }
      }
    },
    "What Doddy calls you": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak Doddy się do Ciebie zwraca"
          }
        }
      }
    },
    "What Doddy did": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co zrobił Doddy"
          }
        }
      }
    },
    "What Doddy knows": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co wie Doddy"
          }
        }
      }
    },
    "What I can do": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co potrafię"
          }
        }
      }
    },
    "What is shared": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jest udostępniane"
          }
        }
      }
    },
    "What leaves this iPhone": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co opuszcza tego iPhone’a"
          }
        }
      }
    },
    "What to remember": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co zapamiętać"
          }
        }
      }
    },
    "What was\nthat thing?": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co to\nbyło?"
          }
        }
      }
    },
    "What was said": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co zostało powiedziane"
          }
        }
      }
    },
    "What would happen": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co by się stało"
          }
        }
      }
    },
    "What would make me useful in your day?": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co sprawiłoby, że będę przydatny w Twoim dniu?"
          }
        }
      }
    },
    "What would you like to keep?": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co chcesz zachować?"
          }
        }
      }
    },
    "What you told me": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co mi powiedziałeś"
          }
        }
      }
    },
    "What's built": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jest zbudowane"
          }
        }
      }
    },
    "Whatever you pick, Doddy answers your question first, says when he isn't sure, only repeats notes you actually saved, asks before saving anything, never jokes about serious things and never makes fun of you.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cokolwiek wybierzesz, Doddy najpierw odpowiada na pytanie, mówi, gdy nie jest pewien, powtarza tylko notatki, które naprawdę zapisałeś, pyta przed zapisaniem czegokolwiek, nigdy nie żartuje z poważnych spraw i nigdy się z Ciebie nie śmieje."
          }
        }
      }
    },
    "When": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy"
          }
        }
      }
    },
    "When I arrive": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy dotrę"
          }
        }
      }
    },
    "When I leave": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wyjdę"
          }
        }
      }
    },
    "When a conversation starts, the app hands Doddy your saved notes and, if this is on, your last few conversations, so he can carry on where you left off. They are kept only on this iPhone. Weather comes from Open-Meteo and facts from Wikipedia.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy zaczyna się rozmowa, aplikacja przekazuje Doddy’emu zapisane notatki oraz, jeśli to jest włączone, kilka ostatnich rozmów, żeby mógł kontynuować tam, gdzie skończyliście. Są przechowywane tylko na tym iPhonie. Pogoda pochodzi z Open-Meteo, a fakty z Wikipedii."
          }
        }
      }
    },
    "When you ask a question, it is sent with your last few messages to Doddy's server, which passes it to OpenAI to write the answer. If \"Use relevant saved notes\" is on, notes that match your question are sent too, and the answer shows which ones. Doddy's server does not store them and logs no text. We ask OpenAI not to keep the reply, but we can't verify that. Voice conversations are separate. You can turn this off at any time.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy zadajesz pytanie, jest ono wysyłane z kilkoma ostatnimi wiadomościami do serwera Doddy’ego, który przekazuje je do OpenAI, żeby napisało odpowiedź. Jeśli „Używaj pasujących notatek” jest włączone, wysyłane są też notatki pasujące do pytania, a odpowiedź pokazuje które. Serwer Doddy’ego ich nie przechowuje i nie zapisuje żadnego tekstu w logach. Prosimy OpenAI, żeby nie zachowywało odpowiedzi, ale nie możemy tego sprawdzić. Rozmowy głosowe to osobna sprawa. Możesz to wyłączyć w każdej chwili."
          }
        }
      }
    },
    "Where your information goes, based on your settings right now. Nothing is sold, and there are no ads or analytics.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokąd trafiają Twoje informacje, zgodnie z obecnymi ustawieniami. Nic nie jest sprzedawane, nie ma reklam ani analityki."
          }
        }
      }
    },
    "Which language feels natural to you?": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaki język jest dla Ciebie naturalny?"
          }
        }
      }
    },
    "While Using, precise": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas używania, dokładna"
          }
        }
      }
    },
    "While you talk, your voice, this conversation, your saved notes, your list names (and a list's items when Doddy reads or changes it), your last few conversations and any calendar entries, contact names or drafts Doddy uses are sent to ElevenLabs to run Doddy. Weather and Wikipedia lookups run from ElevenLabs’ servers. Nothing is saved, added, started, sent or opened unless you tap for it. If you leave the app, Doddy keeps listening (you'll see him in the Dynamic Island) until you tap End. If iOS stops Doddy in the background, the island says so instead of pretending he still hears you.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas rozmowy Twój głos, ta rozmowa, zapisane notatki, nazwy list (a pozycje listy, gdy Doddy ją czyta lub zmienia), kilka ostatnich rozmów oraz wpisy z kalendarza, nazwy kontaktów lub szkice, których Doddy używa, są wysyłane do ElevenLabs, żeby działał Doddy. Sprawdzanie pogody i Wikipedii odbywa się z serwerów ElevenLabs. Nic nie jest zapisywane, dodawane, uruchamiane, wysyłane ani otwierane, dopóki tego nie stukniesz. Jeśli wyjdziesz z aplikacji, Doddy dalej słucha (zobaczysz go w Dynamic Island), dopóki nie stukniesz Zakończ. Jeśli iOS zatrzyma Doddy’ego w tle, wyspa to pokaże, zamiast udawać, że nadal Cię słyszy."
          }
        }
      }
    },
    "Widgets": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widżety"
          }
        }
      }
    },
    "Widgets couldn't be updated, so they may show older notes or lists. Open the widget's note in Doddy to see what is saved.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zaktualizować widżetów, więc mogą pokazywać starsze notatki lub listy. Otwórz notatkę z widżetu w Doddym, żeby zobaczyć, co jest zapisane."
          }
        }
      }
    },
    "With a token server, Doddy sends only your access code to it to get a one-conversation pass; the conversation itself goes to ElevenLabs. Without one, the development agent is open to anyone who has its ID. Conversations count toward the owner's ElevenLabs minutes.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z serwerem tokenów Doddy wysyła do niego tylko Twój kod dostępu, żeby dostać przepustkę na jedną rozmowę; sama rozmowa idzie do ElevenLabs. Bez niego agent deweloperski jest otwarty dla każdego, kto zna jego identyfikator. Rozmowy liczą się do minut ElevenLabs właściciela."
          }
        }
      }
    },
    "Words already added stay in the note until you change them.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodane już słowa zostają w notatce, dopóki ich nie zmienisz."
          }
        }
      }
    },
    "Words are kept exactly as in the file. Keep checklists become lists. Photos, recordings and labels from Keep aren't imported. Imported notes are marked “Imported from a file”.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa zostają dokładnie takie jak w pliku. Listy kontrolne z Keep stają się listami. Zdjęcia, nagrania i etykiety z Keep nie są importowane. Zaimportowane notatki są oznaczone „Zaimportowano z pliku”."
          }
        }
      }
    },
    "Write it out in another language": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz w innym języku"
          }
        }
      }
    },
    "Write something first. Empty notes aren't saved.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw coś napisz. Puste notatki nie są zapisywane."
          }
        }
      }
    },
    "Writing it out on this iPhone…": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuję jako tekst na tym iPhonie…"
          }
        }
      }
    },
    "YOUR SAVED NOTES": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TWOJE ZAPISANE NOTATKI"
          }
        }
      }
    },
    "Yes, I used Double Back Tap": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak, użyłem podwójnego stuknięcia w tył"
          }
        }
      }
    },
    "Yesterday": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczoraj"
          }
        }
      }
    },
    "You asked: “I'm at Mom's for lunch on Saturday. Remind me to bring the spare key, remember where it is, and start a pasta timer.”": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja prośba: „W sobotę jestem u mamy na obiedzie. Przypomnij mi, żeby zabrać zapasowy klucz, zapamiętaj, gdzie jest, i włącz minutnik na makaron.”"
          }
        }
      }
    },
    "You can change this whenever you want.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz to zmienić, kiedy zechcesz."
          }
        }
      }
    },
    "You can undo for a few seconds afterwards.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez kilka sekund możesz to cofnąć."
          }
        }
      }
    },
    "You check it and send it there yourself. Doddy never sends it.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzasz i wysyłasz to sam. Doddy nigdy tego nie wysyła."
          }
        }
      }
    },
    "You choose each saved memory. See the original, edit it or remove it.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde zapisane wspomnienie wybierasz Ty. Zobacz oryginał, zmień go lub usuń."
          }
        }
      }
    },
    "You replied STOP, so texts are blocked by the carrier. Text START to Doddy's number to allow them again.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedziałeś STOP, więc operator blokuje SMS-y. Wyślij START na numer Doddy’ego, aby znów je dopuścić."
          }
        }
      }
    },
    "You see every note before anything is saved. Files are read on this iPhone only.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobaczysz każdą notatkę, zanim cokolwiek zostanie zapisane. Pliki są czytane tylko na tym iPhonie."
          }
        }
      }
    },
    "You speak": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mówisz"
          }
        }
      }
    },
    "You turned notifications off for Doddy in iOS Settings. Turn them on there to get updates.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączyłeś powiadomienia Doddy’ego w Ustawieniach iOS. Włącz je tam, aby dostawać aktualności."
          }
        }
      }
    },
    "Your Doddy messaging data was deleted. Memories on this iPhone were not touched.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane wiadomości Doddy’ego zostały usunięte. Notatki na tym iPhonie pozostały nietknięte."
          }
        }
      }
    },
    "Your PIN": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój PIN"
          }
        }
      }
    },
    "Your day": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dzień"
          }
        }
      }
    },
    "Your day,\nat a glance.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dzień\nw skrócie."
          }
        }
      }
    },
    "Your mate in\nyour pocket": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpel\nw kieszeni"
          }
        }
      }
    },
    "Your memories": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wspomnienia"
          }
        }
      }
    },
    "Your memories were saved by a newer version of Doddy, so this version can't open them. Nothing was deleted or reset. Install the latest version of Doddy.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje notatki zostały zapisane przez nowszą wersję Doddy’ego, więc ta wersja nie może ich otworzyć. Nic nie zostało usunięte ani zresetowane. Zainstaluj najnowszą wersję Doddy’ego."
          }
        }
      }
    },
    "Your memories.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wspomnienia."
          }
        }
      }
    },
    "Your microphone is muted.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój mikrofon jest wyciszony."
          }
        }
      }
    },
    "Your name or nickname": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje imię lub ksywka"
          }
        }
      }
    },
    "Your note": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja notatka"
          }
        }
      }
    },
    "Your note, your choice. No inferred facts.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja notatka, Twój wybór. Bez domysłów."
          }
        }
      }
    },
    "Your notes are always on this iPhone. Weather and Wikipedia lookups run on ElevenLabs and are always on.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje notatki są zawsze na tym iPhonie. Pogoda i Wikipedia są sprawdzane przez ElevenLabs i zawsze włączone."
          }
        }
      }
    },
    "Your notes stay. Only the reminders are removed.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki zostają. Usuwane są tylko przypomnienia."
          }
        }
      }
    },
    "Your number": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój numer"
          }
        }
      }
    },
    "Your preferences changed somewhere else while you were editing. Nothing was saved; your edits are still here. Check them and save again.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje ustawienia zmieniły się gdzieś indziej w trakcie edycji. Nic nie zostało zapisane; Twoje zmiany wciąż tu są. Sprawdź je i zapisz ponownie."
          }
        }
      }
    },
    "Your question is still in the box. Your saved notes are not affected.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje pytanie wciąż jest w polu. Zapisane notatki pozostają bez zmian."
          }
        }
      }
    },
    "Your shortcut reached Doddy": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój skrót dotarł do Doddy’ego"
          }
        }
      }
    },
    "Your typed note": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja wpisana notatka"
          }
        }
      }
    },
    "Your voice note": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja notatka głosowa"
          }
        }
      }
    },
    "Your words, updated": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje słowa, zaktualizowane"
          }
        }
      }
    },
    "Your words. Ready when you need them.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje słowa. Gotowe, gdy ich potrzebujesz."
          }
        }
      }
    },
    "Yours to keep.\nYours to change.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje do zachowania.\nTwoje do zmiany."
          }
        }
      }
    },
    "iOS notifications": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia iOS"
          }
        }
      }
    },
    "iOS watches the place on this iPhone. Doddy never follows where you go.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS obserwuje to miejsce na tym iPhonie. Doddy nigdy nie śledzi, dokąd chodzisz."
          }
        }
      }
    }
  },
  "version": "1.0"
}
