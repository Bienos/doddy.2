    "No answer yet. Tap to try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Antwort. Tippe, um es erneut zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún sin respuesta. Toca para intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de réponse. Touche pour réessayer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema odgovora. Dodirni za ponovni pokušaj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna risposta. Tocca per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ返事がありません。タップしてもう一度試します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze bez odpowiedzi. Dotknij, aby spróbować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem resposta. Toque para tentar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有回复。点按重试。"
          }
        }
      }
    },
