    "Live Activities are off for Doddy. Turn them on in the Settings app, under Doddy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivitäten sind für Doddy aus. Schalte sie in der App Einstellungen unter Doddy ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Actividades en directo están desactivadas para Doddy. Actívalas en la app Ajustes, en Doddy."
