    "Read %lld lines from the photo. Check them before Create.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Zeilen aus dem Foto gelesen. Prüfe sie vor dem Erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han leído %lld líneas de la foto. Revísalas antes de Crear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lignes lues sur la photo. Vérifie-les avant Créer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pročitano redaka s fotografije: %lld. Provjeri ih prije Stvori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lette %lld righe dalla foto. Controllale prima di Crea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真から%lld行を読み取りました。「作成」の前に確認してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytano ze zdjęcia pozycje: %lld. Sprawdź je przed utworzeniem listy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld linhas lidas da foto. Confira antes de Criar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从照片中读取了 %lld 行。创建前请检查。"
          }
        }
      }
    },
    "Read %lld lines from the photo; %lld were too long or past the limit. Check them before Create.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Zeilen aus dem Foto gelesen; %lld waren zu lang oder über dem Limit. Prüfe sie vor dem Erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han leído %lld líneas de la foto; %lld eran demasiado largas o superaban el límite. Revísalas antes de Crear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lignes lues sur la photo ; %lld étaient trop longues ou au-delà de la limite. Vérifie-les avant Créer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pročitano redaka s fotografije: %lld; predugih ili preko limita: %lld. Provjeri ih prije Stvori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lette %lld righe dalla foto; %lld erano troppo lunghe o oltre il limite. Controllale prima di Crea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真から%lld行を読み取りました。%lld行は長すぎるか上限を超えていました。「作成」の前に確認してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytano ze zdjęcia pozycje: %lld; pominięto: %lld (za długie lub ponad limit). Sprawdź je przed utworzeniem listy."
          }
