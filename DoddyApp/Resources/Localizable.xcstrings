          }
        }
      }
    },
    "This removes every memory and its search index from this iPhone and can't be undone. Exported files and older backups aren't affected.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usuwa z tego iPhone’a wszystkie wspomnienia i ich indeks wyszukiwania i nie da się tego cofnąć. Wyeksportowane pliki i starsze kopie zapasowe pozostają bez zmian."
          }
        }
      }
    },
    "This removes what you told Doddy in the introduction from this iPhone. Your saved memories stay.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usuwa z tego iPhone’a to, co powiedziałeś Doddy’emu na powitanie. Zapisane wspomnienia zostają."
          }
        }
      }
    },
    "This sample is missing from the app.": {
      "extractionState": "manual",
      "localizations": {
