        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di ciò che ha imparato viene condiviso. Doddy non può usarlo in una conversazione finché non attivi questa opzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学んだことは何も共有されません。これをオンにするまで、Doddyは会話の中でそれを使えません。"
