      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ"
          }
        }
      }
    },
    "End conversation with Doddy": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ rozmowę z Doddym"
          }
        }
      }
    },
    "Ended": {
      "extractionState": "manual",
      "localizations": {
