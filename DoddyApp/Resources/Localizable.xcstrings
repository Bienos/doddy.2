    "None yet. After you do the same few things in the same order on three different days, Doddy may offer to save them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine. Wenn du an drei verschiedenen Tagen dieselben paar Dinge in derselben Reihenfolge machst, bietet Doddy vielleicht an, sie zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ninguna. Cuando hagas las mismas cosas en el mismo orden en tres días distintos, Doddy puede ofrecerse a guardarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune pour l’instant. Quand tu auras fait les mêmes quelques choses dans le même ordre trois jours différents, Doddy pourra proposer de les enregistrer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još ništa. Nakon što istih nekoliko stvari napraviš istim redoslijedom u tri različita dana, Doddy ti može ponuditi da ih spremi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna. Dopo che avrai fatto le stesse poche cose nello stesso ordine in tre giorni diversi, Doddy potrebbe proporti di salvarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだありません。3日間別々の日に、同じいくつかのことを同じ順番で行うと、Doddyが保存を提案することがあります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze żadnych. Gdy w trzy różne dni zrobisz te same rzeczy w tej samej kolejności, Doddy może zaproponować ich zapisanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma ainda. Depois que você fizer as mesmas poucas coisas na mesma ordem em três dias diferentes, o Doddy pode se oferecer para salvá-las."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有。当你在三个不同的日子以相同顺序做了同样几件事后，Doddy 可能会提议保存它们。"
          }
        }
      }
    },
