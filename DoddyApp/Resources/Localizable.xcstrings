    "This line shows on your Lock Screen and in the Dynamic Island while the timer runs. Leave it empty to show only the time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zeile erscheint auf deinem Sperrbildschirm und in der Dynamic Island, während der Timer läuft. Lass sie leer, um nur die Zeit zu zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta línea se muestra en tu Pantalla de bloqueo y en la Isla Dinámica mientras corre el temporizador. Déjala vacía para mostrar solo el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette ligne s’affiche sur ton Écran verrouillé et dans la Dynamic Island pendant que le minuteur tourne. Laisse vide pour n’afficher que le temps."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj se redak prikazuje na tvojem Zaključanom zaslonu i u Dynamic Islandu dok timer radi. Ostavi prazno da se prikazuje samo vrijeme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa riga compare sul tuo Blocco schermo e nella Dynamic Island mentre il timer va. Lasciala vuota per mostrare solo il tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この1行は、タイマーの動作中にロック画面とDynamic Islandに表示されます。空のままにすると、時間だけが表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten tekst widać na ekranie blokady i w Dynamic Island, gdy odliczanie trwa. Zostaw puste, żeby pokazywać tylko czas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta linha aparece na sua Tela Bloqueada e na Dynamic Island enquanto o timer roda. Deixe vazia para mostrar só o tempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计时器运行时，这行文字会显示在锁定屏幕和灵动岛上。留空则只显示时间。"
          }
        }
      }
    },
