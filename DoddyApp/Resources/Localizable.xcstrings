    },
    "The note text stays hidden on your Lock Screen unless you turn it on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Notiztext bleibt auf deinem Sperrbildschirm verborgen, außer du schaltest ihn ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de la nota permanece oculto en tu Pantalla de bloqueo a menos que lo actives."
