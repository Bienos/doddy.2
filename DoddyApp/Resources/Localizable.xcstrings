        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も保存されていません。Doddyが残すのは、あなたが確認して保存したものだけです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zapisano. Doddy zachowuje tylko to, co przejrzysz i zapiszesz."
