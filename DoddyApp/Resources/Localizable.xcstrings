    "Twilio keeps its call log (numbers, times, duration, price) under its own retention. No audio is recorded anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twilio przechowuje swój rejestr połączeń (numery, godziny, czas trwania, cena) według własnych zasad. Dźwięk nie jest nigdzie nagrywany."
          }
        }
      }
    },
    "Twilio sends a one-time code to check the number is yours. Texts with updates only start after you turn them on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Twilio sendet einen einmaligen Code, um zu prüfen, dass die Nummer deine ist. SMS mit Updates kommen erst, wenn du sie einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Twilio envía un código de un solo uso para comprobar que el número es tuyo. Los SMS con novedades solo empiezan cuando los actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Twilio envoie un code à usage unique pour vérifier que le numéro est bien le tien. Les SMS d’infos ne commencent qu’après que tu les as activés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Twilio šalje jednokratni kod da provjeri je li broj tvoj. SMS poruke s ažuriranjima počinju tek kad ih uključiš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Twilio invia un codice monouso per verificare che il numero sia tuo. Gli SMS con gli aggiornamenti iniziano solo dopo che li attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Twilioが、番号があなたのものか確認するためにワンタイムコードを送ります。更新のSMSは、あなたがオンにした後に初めて届きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twilio wysyła jednorazowy kod, aby sprawdzić, że numer jest Twój. SMS-y z aktualnościami zaczną przychodzić dopiero, gdy je włączysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Twilio envia um código de uso único para verificar que o número é seu. Os SMS com atualizações só começam depois que você os ativar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Twilio 会发送一次性验证码来确认号码是你的。只有在你开启后，才会开始发送包含更新的短信。"
          }
        }
      }
    },
    "Two quick questions. Skip either one. Change your answers anytime.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei kurze Fragen. Du kannst jede überspringen und deine Antworten jederzeit ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos preguntas rápidas. Puedes saltarte cualquiera y cambiar tus respuestas cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux questions rapides. Tu peux passer l’une ou l’autre et modifier tes réponses à tout moment."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva kratka pitanja. Možeš preskočiti bilo koje i promijeniti odgovore kad god želiš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due domande veloci. Puoi saltarne una e cambiare le risposte quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い質問が2つあります。どちらもスキップでき、回答はいつでも変更できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa krótkie pytania. Możesz pominąć dowolne i zmienić odpowiedzi w każdej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas perguntas rápidas. Você pode pular qualquer uma e mudar suas respostas quando quiser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个简短问题。你可以跳过任意一个，也可以随时更改答案。"
          }
        }
      }
    },
