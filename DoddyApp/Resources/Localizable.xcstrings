    "This call was already answered. For another call, make a new card.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na to połączenie już odpowiedziano. Na kolejne przygotuj nową kartę."
          }
        }
      }
    },
    "This can't be undone from Doddy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich in Doddy nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer desde Doddy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible à annuler depuis Doddy."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To se iz Doddyja ne može poništiti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare da Doddy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyからは元に戻せません。"
          }
        },
        "pl": {
