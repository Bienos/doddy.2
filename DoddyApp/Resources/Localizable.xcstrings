    "Couldn't search your notes this time, so none were used.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Notizen konnten diesmal nicht durchsucht werden, also wurde keine verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vez no se ha podido buscar en tus notas, así que no se ha usado ninguna."
          }
        },
        "fr": {
