    "Where your information goes, based on your settings right now. Nothing is sold, and there are no ads or analytics.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin deine Informationen gehen, nach deinen aktuellen Einstellungen. Nichts wird verkauft, und es gibt keine Werbung und keine Analyse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adónde va tu información, según tus ajustes actuales. No se vende nada, y no hay anuncios ni analíticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où vont tes informations, selon tes réglages actuels. Rien n’est vendu, et il n’y a ni publicité ni analyse d’usage."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamo idu tvoji podaci, prema tvojim trenutačnim postavkama. Ništa se ne prodaje i nema oglasa ni analitike."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove vanno le tue informazioni, in base alle tue impostazioni attuali. Niente viene venduto, e non ci sono pubblicità né analisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の設定に基づいて、あなたの情報がどこへ行くかを示します。何も販売されず、広告も分析もありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokąd trafiają Twoje informacje, zgodnie z obecnymi ustawieniami. Nic nie jest sprzedawane, nie ma reklam ani analityki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para onde suas informações vão, com base nos seus ajustes de agora. Nada é vendido, e não há anúncios nem análises."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你当前的设置，你的信息会去向哪里。不会出售任何内容，也没有广告或分析。"
          }
        }
      }
    },
    "Which language feels natural to you?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Sprache fühlt sich für dich natürlich an?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué idioma te resulta natural?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle langue te semble naturelle ?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koji ti je jezik prirodan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale lingua ti viene naturale?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの言語が自然に感じますか？"
          }
        },
        "pl": {
