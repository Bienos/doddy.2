    "Words": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa"
          }
        }
      }
    },
    "Words already added stay in the note until you change them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits hinzugefügte Wörter bleiben in der Notiz, bis du sie änderst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras ya añadidas se quedan en la nota hasta que las cambies."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots déjà ajoutés restent dans la note tant que tu ne les modifies pas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već dodane riječi ostaju u bilješci dok ih ne promijeniš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole già aggiunte restano nella nota finché non le modifichi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに追加された言葉は、変更するまでメモに残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodane już słowa zostają w notatce, dopóki ich nie zmienisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras já adicionadas ficam na nota até você alterá-las."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加的文字会留在笔记中，直到你更改它们。"
          }
        }
      }
    },
    "Words are kept exactly as in the file. Keep checklists become lists. Photos, recordings and labels from Keep aren't imported. Imported notes are marked “Imported from a file”.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörter bleiben genau wie in der Datei. Keep-Checklisten werden zu Listen. Fotos, Aufnahmen und Labels aus Keep werden nicht importiert. Importierte Notizen sind mit „Aus einer Datei importiert“ markiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras se conservan exactamente como en el archivo. Las listas de verificación de Keep se convierten en listas. Las fotos, grabaciones y etiquetas de Keep no se importan. Las notas importadas se marcan como “Importada de un archivo”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots sont gardés exactement comme dans le fichier. Les listes à cocher de Keep deviennent des listes. Les photos, enregistrements et libellés de Keep ne sont pas importés. Les notes importées sont marquées « Importé depuis un fichier »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Riječi ostaju točno kakve su u datoteci. Keep popisi za provjeru postaju popisi. Fotografije, snimke i oznake iz Keepa ne uvoze se. Uvezene bilješke označene su kao „Uvezeno iz datoteke“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole restano esattamente come nel file. Le checklist di Keep diventano liste. Foto, registrazioni ed etichette di Keep non vengono importate. Le note importate sono contrassegnate “Importato da un file”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言葉はファイルのまま正確に残ります。Keepのチェックリストはリストになります。Keepの写真、録音、ラベルは読み込まれません。読み込んだメモには「ファイルから読み込み」と表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa zostają dokładnie takie jak w pliku. Listy kontrolne z Keep stają się listami. Zdjęcia, nagrania i etykiety z Keep nie są importowane. Zaimportowane notatki są oznaczone „Zaimportowano z pliku”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras ficam exatamente como no arquivo. As listas de verificação do Keep viram listas. Fotos, gravações e marcadores do Keep não são importados. As notas importadas recebem a marca “Importado de um arquivo”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字会与文件中完全一致地保留。Keep 的清单会变成清单。Keep 中的照片、录音和标签不会导入。导入的笔记会标记为“从文件导入”。"
          }
        }
      }
    },
