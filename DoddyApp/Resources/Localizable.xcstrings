    "The microphone is off for Doddy. Turn it on in the Settings app to record.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist für Doddy aus. Schalte es in der App Einstellungen ein, um aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono está desactivado para Doddy. Actívalo en la app Ajustes para grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro est désactivé pour Doddy. Active-le dans l’app Réglages pour enregistrer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon je za Doddyja isključen. Uključi ga u aplikaciji Postavke za snimanje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è disattivato per Doddy. Attivalo nell'app Impostazioni per registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyのマイクがオフになっています。録音するには、設定アプリでオンにしてください。"
