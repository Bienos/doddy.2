    "No conversations kept. Private conversations and empty ones are never kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Gespräche behalten. Private und leere Gespräche werden nie behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay conversaciones guardadas. Las conversaciones privadas y las vacías nunca se guardan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune conversation conservée. Les conversations privées et les conversations vides ne sont jamais conservées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema sačuvanih razgovora. Privatni i prazni razgovori nikad se ne čuvaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna conversazione conservata. Le conversazioni private e quelle vuote non vengono mai conservate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された会話はありません。プライベートな会話と空の会話は保存されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zachowanych rozmów. Rozmowy prywatne i puste nigdy nie są zachowywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conversa guardada. Conversas privadas e vazias nunca são guardadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有保留的对话。私密对话和空对话绝不会被保留。"
          }
        }
      }
    },
