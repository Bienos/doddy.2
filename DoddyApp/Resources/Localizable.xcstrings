    "Their half, facing them": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Hälfte, zu ihnen gerichtet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su mitad, mirando hacia ellos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leur moitié, tournée vers eux"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njihova polovica, okrenuta prema njima"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La loro metà, rivolta verso di loro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手側の半分（相手に向ける）"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich połowa, zwrócona do nich"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A metade da outra pessoa, virada para ela"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方的一半，朝向对方"
          }
        }
      }
    },
    "Then Doddy listens, may ask one short follow-up question, thanks and ends the call.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem Doddy słucha, może raz krótko dopytać, dziękuje i kończy rozmowę."
          }
        }
      }
    },
    "There are no words in it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind keine Wörter darin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tiene texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a aucun mot dedans."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U njoj nema riječi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non contiene parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言葉が含まれていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma w nim żadnych słów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há palavras nele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "里面没有文字。"
          }
        }
      }
    },
    "There are no words to show.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma słów do pokazania."
          }
        }
      }
    },
    "There they are.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Da sind sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahí están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voilà."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eno ih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eccole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O, są."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olha elas aí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到了。"
          }
        }
      }
    },
    "There's no text or web link here that Doddy can keep. Nothing was saved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist kein Text und kein Weblink, den Doddy behalten kann. Nichts wurde gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay texto ni enlace web que Doddy pueda guardar. No se ha guardado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a ici ni texte ni lien web que Doddy puisse garder. Rien n’a été enregistré."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje nema teksta ni web-poveznice koje bi Doddy mogao sačuvati. Ništa nije spremljeno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c'è testo o link web che Doddy possa conservare. Niente è stato salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはDoddyが残せるテキストやWebリンクがありません。何も保存されていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma tu tekstu ani linku, który Doddy mógłby zachować. Nic nie zostało zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há texto nem link aqui que o Doddy possa guardar. Nada foi salvo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没有 Doddy 可以保留的文字或网页链接。没有保存任何内容。"
          }
        }
      }
    },
    "These stay on this iPhone. Doddy's voice hears only how many there are and when they were taken.": {
