    "Every month works for days 1 to 28, so every month has the day.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Monat geht für die Tage 1 bis 28, damit jeder Monat den Tag hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mes funciona para los días 1 a 28, para que todos los meses tengan ese día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les mois fonctionne pour les jours 1 à 28, pour que chaque mois ait ce jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki mjesec radi za dane od 1. do 28., tako da svaki mjesec ima taj dan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni mese funziona per i giorni da 1 a 28, così ogni mese ha quel giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「毎月」は1日から28日までに対応しています。どの月にもその日があるためです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co miesiąc działa dla dni od 1 do 28, żeby każdy miesiąc miał ten dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo mês funciona para os dias 1 a 28, para que todo mês tenha o dia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“每月”适用于 1 到 28 日，这样每个月都有这一天。"
          }
        }
      }
    },
    "Every recording on this iPhone is removed, with its audio and its words. A recording in progress is stopped first. Notes you saved from them stay. This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Every recording on this iPad is removed, with its audio and its words. A recording in progress is stopped first. Notes you saved from them stay. This can't be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Every recording on this iPhone is removed, with its audio and its words. A recording in progress is stopped first. Notes you saved from them stay. This can't be undone."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Wszystkie nagrania na tym iPadzie zostaną usunięte razem z dźwiękiem i zapisem słów. Nagranie w toku zostanie najpierw zatrzymane. Notatki zapisane z nagrań zostają. Nie da się tego cofnąć."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Wszystkie nagrania na tym iPhonie zostaną usunięte razem z dźwiękiem i zapisem słów. Nagranie w toku zostanie najpierw zatrzymane. Notatki zapisane z nagrań zostają. Nie da się tego cofnąć."
                }
              }
            }
          }
        }
      }
    },
