        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyのライブアクティビティがオフになっています。設定アプリのDoddyの項目でオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywności na żywo są wyłączone dla Doddy’ego. Włącz je w aplikacji Ustawienia, w sekcji Doddy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Atividades ao Vivo estão desativadas para o Doddy. Ative no app Ajustes, em Doddy."
