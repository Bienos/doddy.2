          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće dohvatiti Doddyjev poslužitelj za poruke. Provjeri vezu i pokušaj ponovno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile raggiungere il server di messaggistica di Doddy. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyのメッセージサーバーに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z serwerem wiadomości Doddy’ego. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o servidor de mensagens do Doddy. Verifique sua conexão e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 Doddy 消息服务器。请检查网络连接后重试。"
          }
        }
      }
    },
    "Couldn't search Apple Maps. Check your internet connection and try again.": {
      "extractionState": "manual",
