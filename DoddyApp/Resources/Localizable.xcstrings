            "state": "translated",
            "value": "まとめを設定できませんでした。もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ustawić podsumowania. Spróbuj jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fechamento do dia não pôde ser definido. Tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法设置晚间总结。请重试。"
          }
        }
      }
    },
    "The wrap-up shows your open reminders from the Reminders app. Turn on Reminders in Settings, Connections; they're read on this iPhone only.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Der Tagesabschluss zeigt deine offenen Erinnerungen aus der App Erinnerungen. Schalte Erinnerungen unter Einstellungen, Verbindungen ein; sie werden nur auf diesem iPad gelesen."
                }
              },
              "other": {
                "stringUnit": {
