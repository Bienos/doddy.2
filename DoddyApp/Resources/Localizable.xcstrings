      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geburtstagserinnerungen konnten nicht gestellt werden. Versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido programar los recordatorios de cumpleaños. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels d’anniversaire n’ont pas pu être réglés. Réessaie."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnike na rođendane nije bilo moguće postaviti. Pokušaj ponovno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile impostare i promemoria dei compleanni. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誕生日のリマインダーを設定できませんでした。もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ustawić przypomnień o urodzinach. Spróbuj jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes de aniversário não puderam ser definidos. Tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法设置生日提醒。请重试。"
          }
        }
      }
    },
    "The call can't be taken over now: it hasn't started talking, or less than 30 seconds are left.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz nie można przejąć rozmowy: jeszcze się nie zaczęła albo zostało mniej niż 30 sekund."
          }
        }
      }
    },
    "The call ended, but the answer card isn't here yet.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmowa się zakończyła, ale karty odpowiedzi jeszcze tu nie ma."
          }
        }
      }
    },
    "The call ended. Doddy is preparing the answer card…": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmowa się zakończyła. Doddy przygotowuje kartę odpowiedzi…"
          }
        }
      }
    },
    "The call failed": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie się nie udało"
          }
        }
      }
    },
    "The call is on. End it first.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmowa trwa. Najpierw ją zakończ."
          }
        }
      }
    },
    "The call isn't on any more.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmowa już się nie toczy."
          }
        }
      }
    },
    "The call reached its time limit.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmowa osiągnęła limit czasu."
          }
        }
      }
    },
    "The camera is off for Doddy. You can allow it in iPhone Settings, Doddy, Camera.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparat jest wyłączony dla Doddy’ego. Możesz go włączyć w Ustawieniach iPhone’a, Doddy, Aparat."
          }
        }
      }
    },
    "The card couldn't be saved on this iPhone, so it was withdrawn. Nothing was dialled. %@": {
      "extractionState": "manual",
