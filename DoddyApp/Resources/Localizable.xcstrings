        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, he usado Tocar atrás dos veces"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, j’ai utilisé le double toucher au dos"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
