    "The Doddy messaging server isn't set up for this yet (missing provider keys). Nothing was sent.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Doddy-Nachrichtenserver ist dafür noch nicht eingerichtet (Anbieter-Schlüssel fehlen). Nichts wurde gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de mensajes de Doddy aún no está configurado para esto (faltan claves del proveedor). No se ha enviado nada."
