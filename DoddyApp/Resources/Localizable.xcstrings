    "A received shortcut proves the route reached Doddy. You then say whether Double Back Tap triggered it.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrany skrót dowodzi, że droga dotarła do Doddy’ego. Potem sam mówisz, czy uruchomiło go podwójne stuknięcie w tył."
          }
        }
      }
    },
    "A rehearsal needs the microphone. Turn it on in Settings › Doddy.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Próba potrzebuje mikrofonu. Włącz go w Ustawieniach › Doddy."
          }
        }
      }
    },
    "A repeating alarm stops for every day, not just the next one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein wiederholter Wecker wird für alle Tage ausgeschaltet, nicht nur für den nächsten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una alarma que se repite se detiene para todos los días, no solo para el siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alarme répétée s’arrête pour tous les jours, pas seulement le prochain."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm koji se ponavlja prestaje za sve dane, ne samo za sljedeći."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sveglia ricorrente si ferma per tutti i giorni, non solo per il prossimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しのアラームは、次の1回だけでなく毎日分が止まります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powtarzający się budzik wyłącza się na wszystkie dni, nie tylko na najbliższy."
          }
        },
