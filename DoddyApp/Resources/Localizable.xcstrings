        "it": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Unendoti aggiungi questa lista a Doddy su questo iPad. Le sue voci, e le modifiche fatte da chiunque, passano tramite iCloud a tutti quelli che la condividono. Le tue note e le altre liste non vengono condivise."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Unendoti aggiungi questa lista a Doddy su questo iPhone. Le sue voci, e le modifiche fatte da chiunque, passano tramite iCloud a tutti quelli che la condividono. Le tue note e le altre liste non vengono condivise."
                }
