    },
    "Nothing to keep. That's fine: you can use Doddy without any of this.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu behalten. Das ist in Ordnung: Du kannst Doddy ohne all das nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que guardar. No pasa nada: puedes usar Doddy sin nada de esto."
