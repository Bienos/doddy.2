          "stringUnit": {
            "state": "translated",
            "value": "Na razie nic. Gdy Doddy coś dla Ciebie sprawdzi lub doda, pojawi się to tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada ainda. Quando o Doddy consultar ou adicionar algo para você, aparece aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有。当 Doddy 为你查找或添加了什么，就会显示在这里。"
          }
        }
      }
    },
