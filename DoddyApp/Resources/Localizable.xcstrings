    "Done": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe"
          }
        }
      }
    },
    "Double Back Tap": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podwójne stuknięcie w tył"
          }
        }
      }
    },
    "Double-tap the back of your iPhone to start talking to Doddy. \"Talk to Doddy\" also works with Siri, in the Shortcuts app and from the Action Button on iPhones that have one.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dwukrotnie w tył iPhone’a, żeby zacząć rozmowę z Doddym. „Porozmawiaj z Doddym” działa też z Siri, w aplikacji Skróty i z przycisku czynności na iPhone’ach, które go mają."
          }
        }
      }
    },
    "Double-tap the back of your iPhone to start talking. It takes a minute in Settings, and Doddy walks you through it.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dwa razy w tył iPhone’a, aby zacząć rozmowę. To minuta w Ustawieniach, a Doddy Cię przez to przeprowadzi."
          }
        }
      }
    },
    "Double-tap to skip.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dwukrotnie, aby pominąć."
          }
        }
      }
    },
    "Due": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Termin"
          }
        }
      }
    },
    "Due date": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Termin"
          }
        }
      }
    },
    "Due now": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz"
          }
        }
      }
    },
    "Each time you open Doddy: a two-second cartoon. A pen sketches Doddy in, he scores a basket and pops up ready to talk, then the buttons slide in. Tap it to skip. With Reduce Motion on it's a still picture; with character artwork hidden or VoiceOver on it doesn't play.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy każdym otwarciu Doddy’ego: dwusekundowa animacja. Pióro rysuje Doddy’ego, on trafia do kosza i wyskakuje gotowy do rozmowy, a potem wjeżdżają przyciski. Stuknij, aby pominąć. Przy włączonym Ograniczeniu ruchu to nieruchomy obrazek; przy ukrytej grafice postaci lub włączonym VoiceOver się nie odtwarza."
          }
        }
      }
    },
    "Edit or remove anything. Only what's here when you tap Save is kept, on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień lub usuń, co chcesz. Zostaje tylko to, co jest tu w chwili stuknięcia Zapisz, na tym iPhonie."
          }
        }
      }
    },
    "Edit this note": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj tę notatkę"
          }
        }
      }
    },
    "ElevenLabs agent ID": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ID agenta ElevenLabs"
          }
        }
      }
    },
    "Encrypted backup": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaszyfrowana kopia zapasowa"
