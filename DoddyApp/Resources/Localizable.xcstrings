    "Clearing removes this list only. Reminders, events and notes Doddy added stay where they are.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeren entfernt nur diese Liste. Erinnerungen, Termine und Notizen, die Doddy hinzugefügt hat, bleiben, wo sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaciar solo vacía esta lista. Los recordatorios, eventos y notas que añadió Doddy se quedan donde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider ne supprime que cette liste. Les rappels, événements et notes ajoutés par Doddy restent où ils sont."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čišćenje uklanja samo ovaj popis. Podsjetnici, događaji i bilješke koje je Doddy dodao ostaju gdje jesu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuotare rimuove solo questa lista. I promemoria, gli eventi e le note aggiunti da Doddy restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消去されるのはこのリストだけです。Doddyが追加したリマインダー、イベント、メモはそのまま残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyszczenie usuwa tylko tę listę. Przypomnienia, wydarzenia i notatki dodane przez Doddy’ego zostają tam, gdzie są."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar remove só esta lista. Lembretes, eventos e notas que o Doddy adicionou ficam onde estão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空只会移除这个清单。Doddy 添加的提醒、日程和笔记会留在原处。"
          }
        }
      }
    },
