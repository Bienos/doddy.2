            }
          }
        },
        "hr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vidiš svaku bilješku prije nego što se išta spremi. Datoteke se čitaju samo na ovom iPadu."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vidiš svaku bilješku prije nego što se išta spremi. Datoteke se čitaju samo na ovom iPhoneu."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vedi ogni nota prima che qualcosa venga salvato. I file vengono letti solo su questo iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vedi ogni nota prima che qualcosa venga salvato. I file vengono letti solo su questo iPhone."
                }
