    "Updates need a Doddy messaging server, and none is connected in this build yet. Nothing is sent anywhere until one is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates brauchen einen Doddy-Nachrichtenserver, und in dieser Version ist noch keiner verbunden. Nichts wird irgendwohin gesendet, bis einer da ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las novedades necesitan un servidor de mensajes de Doddy, y en esta versión aún no hay ninguno conectado. No se envía nada a ningún sitio hasta que lo haya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les infos ont besoin d’un serveur de messagerie Doddy, et aucun n’est encore connecté dans cette version. Rien n’est envoyé nulle part tant qu’il n’y en a pas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriranja trebaju Doddyjev poslužitelj za poruke, a u ovoj verziji još nijedan nije povezan. Ništa se nikamo ne šalje dok ga ne bude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti richiedono un server di messaggistica di Doddy, e in questa versione non ne è ancora collegato nessuno. Niente viene inviato da nessuna parte finché non ce n'è uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新にはDoddyのメッセージサーバーが必要ですが、このビルドではまだ接続されていません。接続されるまで、どこにも何も送信されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualności wymagają serwera wiadomości Doddy’ego, a w tej wersji żaden nie jest jeszcze podłączony. Nic nie jest nigdzie wysyłane, dopóki nie będzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizações precisam de um servidor de mensagens do Doddy, e nenhum está conectado nesta versão ainda. Nada é enviado a lugar nenhum até haver um."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新需要一台 Doddy 消息服务器，而此版本尚未连接任何服务器。在连接之前，不会向任何地方发送任何内容。"
          }
        }
      }
    },
    "Use 6 to 8 digits that are harder to guess: not one repeated digit or a run like 123456.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm 6 bis 8 Ziffern, die schwerer zu erraten sind: keine einzelne wiederholte Ziffer und keine Folge wie 123456."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa de 6 a 8 dígitos difíciles de adivinar: ni un dígito repetido ni una secuencia como 123456."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise 6 à 8 chiffres difficiles à deviner : pas un chiffre répété ni une suite comme 123456."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi 6 do 8 znamenki koje je teže pogoditi: ne jednu ponovljenu znamenku ni niz poput 123456."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa da 6 a 8 cifre difficili da indovinare: non una sola cifra ripetuta né una sequenza come 123456."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推測されにくい6〜8桁を使ってください。同じ数字の繰り返しや、123456のような連番は避けてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj od 6 do 8 cyfr, trudniejszych do zgadnięcia: nie jednej powtarzanej cyfry ani ciągu w rodzaju 123456."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use de 6 a 8 dígitos mais difíceis de adivinhar: não um dígito repetido nem uma sequência como 123456."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 6 到 8 位较难猜到的数字：不要用同一个数字重复，也不要用 123456 这样的连续数字。"
          }
        }
      }
    },
