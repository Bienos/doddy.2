                  "state": "translated",
                  "value": "Você vê cada nota antes de qualquer coisa ser salva. Os arquivos são lidos só neste iPhone."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "在保存任何内容之前，你会看到每一条笔记。文件只在这台 iPad 上读取。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
