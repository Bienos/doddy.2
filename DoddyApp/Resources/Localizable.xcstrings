    "Nothing learned is shared. Doddy can't use it in a conversation until you turn this on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Gelerntes wird weitergegeben. Doddy kann es in einem Gespräch erst nutzen, wenn du das einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de lo aprendido se comparte. Doddy no puede usarlo en una conversación hasta que actives esto."
