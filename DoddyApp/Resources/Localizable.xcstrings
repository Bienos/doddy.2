    "Ticks one item on one of your Doddy lists. If it could be more than one item, nothing is ticked.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakt einen Eintrag auf einer deiner Doddy-Listen ab. Könnte mehr als ein Eintrag gemeint sein, wird nichts abgehakt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca un elemento de una de tus listas de Doddy. Si pudiera ser más de un elemento, no se marca nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coche un élément sur l’une de tes listes Doddy. Si ça pourrait être plus d’un élément, rien n’est coché."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označava jednu stavku na jednom od tvojih popisa u Doddyju. Ako bi to mogla biti više od jedne stavke, ništa se ne označava."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spunta una voce in una delle tue liste in Doddy. Se potrebbe trattarsi di più di una voce, niente viene spuntato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyのリストのひとつで、項目を1つチェックします。複数の項目に当てはまる可能性がある場合は、何もチェックされません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhacza jedną pozycję na jednej z Twoich list w Doddym. Jeśli może chodzić o więcej niż jedną pozycję, nic nie jest odhaczane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca um item em uma das suas listas do Doddy. Se puder ser mais de um item, nada é marcado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选你某个 Doddy 清单上的一个项目。如果可能匹配多个项目，则不勾选任何项目。"
          }
        }
      }
    },
