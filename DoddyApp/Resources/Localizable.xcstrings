        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst s fotografije dodan je ispod. Čitanje fotografija griješi, pa provjeri prije spremanja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo della foto è stato aggiunto qui sotto. La lettura delle foto fa errori, quindi controllalo prima di salvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の文字を下に追加しました。写真の読み取りは間違えることがあるので、保存する前に確認してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst ze zdjęcia został dodany poniżej. Odczytywanie zdjęć popełnia błędy, więc sprawdź go przed zapisaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
