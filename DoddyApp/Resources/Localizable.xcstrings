    "Text size follows your iPhone's settings. With Reduce Motion on, Doddy stays still.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmiar tekstu zgodny z ustawieniami iPhone’a. Przy włączonym Ograniczeniu ruchu Doddy się nie rusza."
          }
        }
      }
    },
    "Texts aren't on. Verify your number and turn on texts first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS sind nicht an. Bestätige zuerst deine Nummer und schalte SMS ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los SMS no están activados. Verifica tu número y activa los SMS primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les SMS ne sont pas activés. Vérifie d’abord ton numéro et active les SMS."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS poruke nisu uključene. Prvo potvrdi broj i uključi SMS poruke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli SMS non sono attivi. Verifica prima il tuo numero e attiva gli SMS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SMSがオンになっていません。先に番号を確認して、SMSをオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS-y nie są włączone. Najpierw potwierdź numer i włącz SMS-y."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os SMS não estão ativados. Verifique seu número e ative os SMS primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短信未开启。请先验证你的号码并开启短信。"
          }
        }
      }
    },
