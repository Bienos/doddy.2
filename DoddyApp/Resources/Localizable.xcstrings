    "Kept so you can see them. Doddy doesn't use anything here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufbewahrt, damit du sie sehen kannst. Doddy nutzt hier nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan para que puedas verlos. Doddy no usa nada de aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservés pour que tu puisses les voir. Doddy n’utilise rien d’ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržano da ih možeš vidjeti. Doddy ne koristi ništa odavde."
