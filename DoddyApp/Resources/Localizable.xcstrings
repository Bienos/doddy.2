    "Cards you tapped Not now on. They go away by themselves after 7 days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten, bei denen du auf „Jetzt nicht“ getippt hast. Sie verschwinden nach 7 Tagen von selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjetas en las que tocaste Ahora no. Desaparecen solas a los 7 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes sur lesquelles tu as touché Pas maintenant. Elles disparaissent d’elles-mêmes au bout de 7 jours."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartice na kojima je odabrano „Ne sad“. Same nestaju nakon 7 dana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede su cui hai toccato “Non ora”. Spariscono da sole dopo 7 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今はしない」をタップしたカードです。7日経つと自動で消えます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Propozycje, przy których wybrano Nie teraz. Same znikają po 7 dniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartões em que você tocou em Agora não. Eles somem sozinhos depois de 7 dias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你轻点过“暂不”的卡片。7 天后会自动消失。"
          }
        }
      }
    },
