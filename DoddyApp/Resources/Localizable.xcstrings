            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "何かが保存される前に、すべてのメモを確認できます。ファイルの読み取りはこのiPad上でのみ行われます。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "何かが保存される前に、すべてのメモを確認できます。ファイルの読み取りはこのiPhone上でのみ行われます。"
                }
              }
            }
          }
        },
        "pl": {
