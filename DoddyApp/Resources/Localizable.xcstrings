    },
    "This card doesn't match what the server holds. Make a new one.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta karta nie zgadza się z tym, co ma serwer. Przygotuj nową."
          }
        }
      }
    },
    "This card has expired. Make a new one from the same brief.": {
      "extractionState": "manual",
      "localizations": {
