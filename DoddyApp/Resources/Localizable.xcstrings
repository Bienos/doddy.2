        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivnosti uživo isključene su za Doddyja. Uključi ih u aplikaciji Postavke, pod Doddy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Attività in tempo reale sono disattivate per Doddy. Attivale nell'app Impostazioni, sotto Doddy."
          }
