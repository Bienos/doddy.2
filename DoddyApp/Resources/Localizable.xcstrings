    "Go to your Home Screen, then double-tap the back of your iPhone. The shortcut should bring you back to Doddy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh zum Home-Bildschirm und tippe dann zweimal auf die Rückseite deines iPhones. Der Kurzbefehl sollte dich zurück zu Doddy bringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a tu pantalla de inicio y toca dos veces la parte trasera de tu iPhone. El atajo debería traerte de vuelta a Doddy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Va sur ton écran d’accueil, puis touche deux fois le dos de ton iPhone. Le raccourci devrait te ramener dans Doddy."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idi na Početni zaslon, a zatim dvaput dodirni stražnju stranu iPhonea. Prečac bi te trebao vratiti Doddyju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai alla schermata Home, poi tocca due volte il retro del tuo iPhone. Il comando dovrebbe riportarti a Doddy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面に戻って、iPhoneの背面をダブルタップしてください。ショートカットでDoddyに戻ってくるはずです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź do ekranu początkowego i stuknij dwa razy w tył iPhone’a. Skrót powinien przenieść Cię z powrotem do Doddy’ego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá para a Tela de Início e toque duas vezes na parte de trás do seu iPhone. O atalho deve trazer você de volta ao Doddy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到主屏幕，然后轻点两下 iPhone 背面。快捷指令应该会把你带回 Doddy。"
          }
        }
      }
    },
