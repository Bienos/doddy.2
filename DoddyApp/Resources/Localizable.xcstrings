    },
    "Add camera shortcut": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj skrót aparatu"
          }
        }
      }
    },
    "Add my own topic": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj własny temat"
          }
        }
      }
    },
    "Add the shortcut once. Shortcuts shows it first, and you tap Add Shortcut.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj skrót raz. Skróty najpierw go pokażą, a potem stukasz „Dodaj skrót”."
          }
        }
      }
    },
    "Add this event?": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodać to wydarzenie?"
          }
        }
      }
    },
    "Add this reminder?": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodać to przypomnienie?"
          }
        }
      }
    },
    "Add to": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj do"
          }
        }
