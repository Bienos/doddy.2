    "Development (public agent)": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deweloperski (publiczny agent)"
          }
        }
      }
    },
    "Development build. DODDY is an AI assistant, not a person. This memory interface uses your approved numbered-asset design; physical-device and release checks remain outstanding.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja deweloperska. DODDY to asystent AI, nie człowiek. Ten interfejs pamięci korzysta z zatwierdzonego projektu z numerowanymi zasobami; testy na fizycznym urządzeniu i przed wydaniem jeszcze się nie odbyły."
          }
        }
      }
    },
    "Development setting. Use https, or http://localhost with the Simulator. The token comes from the server owner and is stored only in this iPhone's Keychain, for the server address set when you saved it; it is never sent to another address.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Development setting. Use https, or http://localhost with the Simulator. The token comes from the server owner and is stored only in this iPad's Keychain, for the server address set when you saved it; it is never sent to another address."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Development setting. Use https, or http://localhost with the Simulator. The token comes from the server owner and is stored only in this iPhone's Keychain, for the server address set when you saved it; it is never sent to another address."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ustawienie deweloperskie. Użyj https albo http://localhost w Symulatorze. Token pochodzi od właściciela serwera i jest przechowywany tylko w pęku kluczy tego iPada, dla adresu serwera ustawionego przy zapisie; nigdy nie jest wysyłany pod inny adres."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ustawienie deweloperskie. Użyj https albo http://localhost w Symulatorze. Token pochodzi od właściciela serwera i jest przechowywany tylko w pęku kluczy tego iPhone’a, dla adresu serwera ustawionego przy zapisie; nigdy nie jest wysyłany pod inny adres."
                }
              }
            }
          }
        }
      }
    },
