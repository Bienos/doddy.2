    "Notifications are off for Doddy or iOS didn't confirm the alert, so there may be no alert when time's up. The island and this screen still show it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Doddy aus oder iOS hat den Alarm nicht bestätigt, also gibt es vielleicht keinen Alarm, wenn die Zeit um ist. Die Island und dieser Bildschirm zeigen es trotzdem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Doddy o iOS no ha confirmado el aviso, así que puede que no haya aviso cuando acabe el tiempo. La isla y esta pantalla lo siguen mostrando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Doddy, ou iOS n’a pas confirmé l’alerte, donc il n’y aura peut-être pas d’alerte à la fin du temps. L’île et cet écran l’affichent quand même."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su za Doddyja isključene ili iOS nije potvrdio upozorenje, pa upozorenja možda neće biti kad vrijeme istekne. Otok i ovaj zaslon i dalje ga prikazuju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate per Doddy o iOS non ha confermato l'avviso, quindi allo scadere del tempo potrebbe non esserci nessun avviso. L'isola e questa schermata lo mostrano comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyの通知がオフになっているか、iOSがアラートを確認しなかったため、時間になってもアラートが出ないことがあります。アイランドとこの画面には引き続き表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia Doddy’ego są wyłączone albo iOS nie potwierdził alertu, więc po upływie czasu alert może się nie pojawić. Wyspa i ten ekran nadal to pokażą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Doddy ou o iOS não confirmou o alerta, então pode não haver alerta quando o tempo acabar. A ilha e esta tela ainda mostram."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 的通知已关闭，或 iOS 未确认提醒，所以时间到时可能不会有提醒。灵动岛和这个界面仍会显示。"
          }
        }
      }
    },
    "Notifications are off for Doddy, so birthdays can't be reminded. Turn them on in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Doddy aus, also kann er nicht an Geburtstage erinnern. Schalte sie in den iOS-Einstellungen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Doddy, así que no se pueden recordar los cumpleaños. Actívalas en los Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Doddy, donc il ne peut pas rappeler les anniversaires. Active-les dans Réglages iOS."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su za Doddyja isključene, pa ne može podsjećati na rođendane. Uključi ih u Postavkama iOS-a."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate per Doddy, quindi non può ricordarti i compleanni. Attivale nelle Impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyの通知がオフになっているため、誕生日をリマインドできません。iOSの設定でオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia Doddy’ego są wyłączone, więc nie może przypominać o urodzinach. Włącz je w Ustawieniach iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Doddy, então os aniversários não podem ser lembrados. Ative nos Ajustes do iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 的通知已关闭，所以无法提醒生日。请在 iOS 设置中开启。"
          }
        }
      }
    },
    "Notifications are off for Doddy, so it can't remind you at a place. Nothing was set. Turn them on in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Doddy aus, also kann er dich nicht an einem Ort erinnern. Nichts wurde gestellt. Schalte sie in den Einstellungen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Doddy, así que no puede recordártelo en un lugar. No se ha programado nada. Actívalas en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Doddy, donc il ne peut pas te faire de rappel à un lieu. Rien n’a été réglé. Active-les dans Réglages."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su za Doddyja isključene, pa te ne može podsjetiti na mjestu. Ništa nije postavljeno. Uključi ih u Postavkama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate per Doddy, quindi non può ricordartelo in un luogo. Non è stato impostato niente. Attivale in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyの通知がオフになっているため、場所でリマインドできません。何も設定されていません。「設定」でオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia Doddy’ego są wyłączone, więc nie może przypomnieć Ci w danym miejscu. Nic nie zostało ustawione. Włącz je w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Doddy, então ele não pode lembrar você em um lugar. Nada foi definido. Ative nos Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 的通知已关闭，所以他无法在某个地点提醒你。没有设置任何内容。请在设置中开启。"
          }
        }
      }
    },
    "Notifications are off for Doddy, so the check-in can't ring. Turn them on in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Doddy aus, also kann sich der Check-in nicht melden. Schalte sie in den iOS-Einstellungen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Doddy, así que el repaso de la mañana no puede sonar. Actívalas en los Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Doddy, donc le point du matin ne peut pas sonner. Active-les dans Réglages iOS."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su za Doddyja isključene, pa se pregled ne može oglasiti. Uključi ih u Postavkama iOS-a."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate per Doddy, quindi il punto del mattino non può suonare. Attivale nelle Impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyの通知がオフになっているため、チェックインを鳴らせません。iOSの設定でオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia Doddy’ego są wyłączone, więc poranne podsumowanie nie zadzwoni. Włącz je w Ustawieniach iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Doddy, então o check-in não pode tocar. Ative nos Ajustes do iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 的通知已关闭，所以早间概览无法提醒。请在 iOS 设置中开启。"
          }
        }
      }
    },
    "Notifications are off for Doddy, so the look-back can't arrive. Turn them on in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Doddy aus, also kann der Rückblick nicht ankommen. Schalte sie in den iOS-Einstellungen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Doddy, así que el resumen semanal no puede llegar. Actívalas en los Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Doddy, donc le retour sur la semaine ne peut pas arriver. Active-les dans Réglages iOS."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su za Doddyja isključene, pa osvrt ne može stići. Uključi ih u Postavkama iOS-a."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate per Doddy, quindi il bilancio settimanale non può arrivare. Attivale nelle Impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyの通知がオフになっているため、ふり返りが届きません。iOSの設定でオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia Doddy’ego są wyłączone, więc podsumowanie nie dotrze. Włącz je w Ustawieniach iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Doddy, então a retrospectiva não pode chegar. Ative nos Ajustes do iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 的通知已关闭，所以每周回顾无法送达。请在 iOS 设置中开启。"
          }
        }
      }
    },
    "Notifications are off for Doddy, so the tidy-up can't ring. Turn them on in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Doddy aus, also kann sich das Aufräumen nicht melden. Schalte sie in den iOS-Einstellungen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Doddy, así que la limpieza semanal no puede sonar. Actívalas en los Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Doddy, donc le rangement ne peut pas sonner. Active-les dans Réglages iOS."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su za Doddyja isključene, pa se pospremanje ne može oglasiti. Uključi ih u Postavkama iOS-a."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate per Doddy, quindi il riordino non può suonare. Attivale nelle Impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyの通知がオフになっているため、片づけを鳴らせません。iOSの設定でオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia Doddy’ego są wyłączone, więc porządki nie zadzwonią. Włącz je w Ustawieniach iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Doddy, então a arrumação não pode tocar. Ative nos Ajustes do iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 的通知已关闭，所以每周整理无法提醒。请在 iOS 设置中开启。"
          }
        }
      }
    },
    "Notifications are off for Doddy, so the wrap-up can't ring. Turn them on in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Doddy aus, also kann sich der Tagesabschluss nicht melden. Schalte sie in den iOS-Einstellungen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Doddy, así que el cierre del día no puede sonar. Actívalas en los Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Doddy, donc le bilan du soir ne peut pas sonner. Active-les dans Réglages iOS."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su za Doddyja isključene, pa se sažetak ne može oglasiti. Uključi ih u Postavkama iOS-a."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate per Doddy, quindi il riepilogo serale non può suonare. Attivale nelle Impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyの通知がオフになっているため、まとめを鳴らせません。iOSの設定でオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia Doddy’ego są wyłączone, więc podsumowanie nie może się pojawić. Włącz je w Ustawieniach iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Doddy, então o fechamento do dia não pode tocar. Ative nos Ajustes do iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 的通知已关闭，所以晚间总结无法提醒。请在 iOS 设置中开启。"
          }
        }
      }
    },
    "Notifications are off for Doddy, so your iPhone won't alert you. When it's due, the note waits at the top of Home.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Doddy aus, also wird dich dein iPhone nicht benachrichtigen. Wenn es so weit ist, wartet die Notiz oben auf Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Doddy, así que tu iPhone no te avisará. Cuando llegue la hora, la nota esperará arriba del todo en Inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Doddy, donc ton iPhone ne t’alertera pas. À l’échéance, la note attend en haut de l’Accueil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su za Doddyja isključene, pa te iPhone neće upozoriti. Kad dođe vrijeme, bilješka čeka na vrhu Početne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate per Doddy, quindi il tuo iPhone non ti avviserà. Quando è il momento, la nota aspetta in cima alla Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyの通知がオフになっているため、iPhoneからのお知らせはありません。時間になると、メモはホームの一番上で待っています。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia Doddy’ego są wyłączone, więc iPhone Cię nie zaalarmuje. Gdy nadejdzie pora, notatka poczeka na górze ekranu Start."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Doddy, então seu iPhone não vai avisar você. Na hora, a nota espera no topo do Início."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 的通知已关闭，所以你的 iPhone 不会提醒你。到期时，这条笔记会在首页顶部等你。"
          }
        }
      }
    },
    "Notifications are off for Doddy. Turn them on in iPhone Settings, Notifications, Doddy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Doddy aus. Schalte sie in den iPhone-Einstellungen unter Mitteilungen, Doddy ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Doddy. Actívalas en los Ajustes del iPhone, Notificaciones, Doddy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Doddy. Active-les dans Réglages de l’iPhone, Notifications, Doddy."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su za Doddyja isključene. Uključi ih u Postavkama iPhonea, Obavijesti, Doddy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate per Doddy. Attivale in Impostazioni di iPhone, Notifiche, Doddy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyの通知がオフになっています。iPhoneの設定 › 通知 › Doddyでオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia Doddy’ego są wyłączone. Włącz je w Ustawieniach iPhone’a, Powiadomienia, Doddy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Doddy. Ative em Ajustes do iPhone, Notificações, Doddy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
