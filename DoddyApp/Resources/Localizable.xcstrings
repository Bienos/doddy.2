        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst bilješke ostaje skriven na tvojem Zaključanom zaslonu osim ako ga uključiš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo della nota resta nascosto sul tuo Blocco schermo a meno che tu non lo attivi."
