    "Add the shortcut once. Shortcuts shows it first, and you tap Add Shortcut.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge den Kurzbefehl einmal hinzu. Kurzbefehle zeigt ihn zuerst, und du tippst auf „Kurzbefehl hinzufügen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el atajo una vez. Atajos lo muestra primero y tú tocas Añadir atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute le raccourci une seule fois. Raccourcis l’affiche d’abord, et tu touches Ajouter le raccourci."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj prečac jednom. Prečaci ga prvo prikažu, a ti dodirneš „Dodaj prečac“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il comando una volta sola. Comandi Rapidi te lo mostra per primo, e tu tocchi “Aggiungi comando rapido”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットは一度追加すれば大丈夫です。ショートカットアプリが最初に表示するので、「ショートカットを追加」をタップしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj skrót raz. Skróty najpierw go pokażą, a potem stukasz „Dodaj skrót”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o atalho uma vez. O Atalhos mostra ele primeiro, e você toca em Adicionar Atalho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需添加一次快捷指令。“快捷指令”会先显示它，你再轻点“添加快捷指令”。"
          }
        }
      }
    },
