    "Things you said that might be useful later, in your words. Tick what to save; nothing is saved otherwise. Doddy picked these on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dinge, die du gesagt hast und die später nützlich sein könnten, in deinen Worten. Hake an, was gespeichert werden soll; sonst wird nichts gespeichert. Doddy hat sie auf diesem iPad ausgewählt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dinge, die du gesagt hast und die später nützlich sein könnten, in deinen Worten. Hake an, was gespeichert werden soll; sonst wird nichts gespeichert. Doddy hat sie auf diesem iPhone ausgewählt."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Things you said that might be useful later, in your words. Tick what to save; nothing is saved otherwise. Doddy picked these on this iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Things you said that might be useful later, in your words. Tick what to save; nothing is saved otherwise. Doddy picked these on this iPhone."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cosas que dijiste que podrían ser útiles más adelante, con tus palabras. Marca lo que quieras guardar; si no, no se guarda nada. Doddy las eligió en este iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cosas que dijiste que podrían ser útiles más adelante, con tus palabras. Marca lo que quieras guardar; si no, no se guarda nada. Doddy las eligió en este iPhone."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Des choses que tu as dites et qui pourraient servir plus tard, avec tes mots. Coche ce qu’il faut enregistrer ; sinon rien n’est enregistré. Doddy les a choisies sur cet iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Des choses que tu as dites et qui pourraient servir plus tard, avec tes mots. Coche ce qu’il faut enregistrer ; sinon rien n’est enregistré. Doddy les a choisies sur cet iPhone."
                }
              }
            }
          }
        },
        "hr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Stvari iz razgovora koje bi poslije mogle biti korisne, tvojim riječima. Označi što spremiti; inače se ništa ne sprema. Doddy ih je odabrao na ovom iPadu."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Stvari iz razgovora koje bi poslije mogle biti korisne, tvojim riječima. Označi što spremiti; inače se ništa ne sprema. Doddy ih je odabrao na ovom iPhoneu."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cose che hai detto e che potrebbero servire più avanti, con parole tue. Spunta cosa salvare; altrimenti niente viene salvato. Doddy le ha scelte su questo iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cose che hai detto e che potrebbero servire più avanti, con parole tue. Spunta cosa salvare; altrimenti niente viene salvato. Doddy le ha scelte su questo iPhone."
