            }
          }
        },
        "zh-Hans": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "为了发送更新，Doddy 消息服务器会保存这台 iPad 的匿名账户 ID、通知令牌，以及（如果你添加了）你的手机号码和短信同意记录。更新的文字内容只保留到发送为止。通知由 Apple 投递；短信由 Twilio 发送并验证你的号码。你的记忆只留在这台 iPad 上。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "为了发送更新，Doddy 消息服务器会保存这台 iPhone 的匿名账户 ID、通知令牌，以及（如果你添加了）你的手机号码和短信同意记录。更新的文字内容只保留到发送为止。通知由 Apple 投递；短信由 Twilio 发送并验证你的号码。你的记忆只留在这台 iPhone 上。"
