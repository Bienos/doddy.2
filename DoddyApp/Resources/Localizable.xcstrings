    "Doddy is using only your notes: no calendar, reminders, contacts, other apps or online accounts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy nutzt nur deine Notizen: keinen Kalender, keine Erinnerungen, Kontakte, anderen Apps oder Online-Konten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy usa solo tus notas: nada de calendario, recordatorios, contactos, otras apps ni cuentas online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy n’utilise que tes notes : ni calendrier, ni rappels, ni contacts, ni autres apps, ni comptes en ligne."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy koristi samo tvoje bilješke: bez kalendara, podsjetnika, kontakata, drugih aplikacija ili online računa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy usa solo le tue note: niente calendario, promemoria, contatti, altre app o account online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyが使っているのはあなたのメモだけです。カレンダー、リマインダー、連絡先、ほかのアプリ、オンラインアカウントは使っていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy korzysta tylko z Twoich notatek: bez kalendarza, przypomnień, kontaktów, innych aplikacji i kont online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy está usando só suas notas: sem calendário, lembretes, contatos, outros apps ou contas online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 只使用你的笔记：不使用日历、提醒事项、通讯录、其他应用或在线账户。"
          }
        }
      }
    },
    "Doddy is working on it": {
