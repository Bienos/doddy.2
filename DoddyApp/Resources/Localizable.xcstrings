    "Still open from today or earlier. Tick the ones to move; each keeps its time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch offen von heute oder früher. Hake die an, die verschoben werden sollen; jede behält ihre Uhrzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguen abiertos de hoy o de antes. Marca los que quieras mover; cada uno conserva su hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore ouverts, d’aujourd’hui ou d’avant. Coche ceux à reporter ; chacun garde son heure."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još otvoreni od danas ili ranije. Označi one za premještanje; svaki zadržava svoje vrijeme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora aperti da oggi o prima. Spunta quelli da spostare; ognuno mantiene il suo orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日またはそれ以前から未完了のものです。移すものにチェックを付けてください。それぞれ時刻はそのままです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wciąż otwarte z dzisiaj lub wcześniej. Zaznacz te do przeniesienia; każde zachowa swoją godzinę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda abertos de hoje ou antes. Marque os que quer mover; cada um mantém seu horário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天或更早的仍未完成的提醒。勾选要移动的；每条都会保留原来的时间。"
          }
        }
      }
    },
    "Still true?": {
