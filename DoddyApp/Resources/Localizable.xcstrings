    "A passkey opens Doddy on this iPhone. Doddy only learns that it matched.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
