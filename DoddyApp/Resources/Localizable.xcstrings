    "Nothing saved. Doddy only keeps what you review and save.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts gespeichert. Doddy behält nur, was du prüfst und speicherst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada guardado. Doddy solo conserva lo que revisas y guardas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’enregistré. Doddy ne garde que ce que tu relis et enregistres."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije spremljeno. Doddy čuva samo ono što pregledaš i spremiš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
