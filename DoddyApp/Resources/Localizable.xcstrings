    "Changes made before Doddy kept every version weren't stored, so only the original and the current wording are shown.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen aus der Zeit, bevor Doddy jede Version behielt, wurden nicht gespeichert; deshalb siehst du nur den ursprünglichen und den aktuellen Wortlaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios hechos antes de que Doddy guardara todas las versiones no se almacenaron, así que solo se muestran el original y la redacción actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications faites avant que Doddy conserve chaque version n’ont pas été stockées, donc seules la formulation d’origine et l’actuelle sont affichées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjene prije nego što je Doddy počeo čuvati svaku verziju nisu spremljene, pa se prikazuju samo izvorni i trenutačni tekst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche fatte prima che Doddy conservasse ogni versione non sono state salvate, quindi vengono mostrati solo il testo originale e quello attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyがすべてのバージョンを保存するようになる前の変更は記録されていないため、元の文と現在の文だけを表示しています。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany sprzed czasu, gdy Doddy zaczął zapisywać każdą wersję, nie zostały zachowane, więc widać tylko pierwotną i obecną treść."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações feitas antes de o Doddy guardar cada versão não foram armazenadas, então só o texto original e o atual aparecem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Doddy 开始保留每个版本之前所做的更改没有存储，因此只显示原文和当前内容。"
          }
        }
      }
    },
