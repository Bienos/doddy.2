      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja"
          }
        }
      }
    },
    "View the note": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz notatkę"
          }
        }
      }
    },
    "View the saved note": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz zapisaną notatkę"
          }
        }
