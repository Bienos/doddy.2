    "Online accounts need a Doddy server. Set its address and a session token in Settings › Connected Apps server.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Online-Konten brauchen einen Doddy-Server. Lege seine Adresse und ein Sitzungstoken unter Einstellungen › Server für verbundene Apps fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas online necesitan un servidor de Doddy. Pon su dirección y un token de sesión en Ajustes › Servidor de Apps conectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes en ligne ont besoin d’un serveur Doddy. Règle son adresse et un jeton de session dans Réglages › Serveur des apps connectées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Online računi trebaju Doddyjev poslužitelj. Postavi njegovu adresu i token sesije u Postavke › Poslužitelj povezanih aplikacija."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli account online richiedono un server Doddy. Imposta il suo indirizzo e un token di sessione in Impostazioni › Server App collegate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインアカウントにはDoddyサーバーが必要です。設定 › 連携アプリサーバーで、アドレスとセッショントークンを設定してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konta online potrzebują serwera Doddy’ego. Ustaw jego adres i token sesji w Ustawieniach › Serwer połączonych aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas online precisam de um servidor do Doddy. Defina o endereço e um token de sessão em Ajustes › Servidor de Apps Conectados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
