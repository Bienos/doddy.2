    "A project, hobby or routine. Share only what would help.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Projekt, ein Hobby oder eine Routine. Teile nur, was hilft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un proyecto, una afición o una rutina. Comparte solo lo que pueda ayudar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un projet, un loisir ou une routine. Ne partage que ce qui peut aider."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt, hobi ili rutina. Podijeli samo ono što bi pomoglo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un progetto, un hobby o un'abitudine. Condividi solo ciò che può essere utile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクト、趣味、日課など。役に立つことだけ教えてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt, hobby albo stały rytm dnia. Podaj tylko to, co pomoże."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um projeto, hobby ou rotina. Compartilhe só o que ajudaria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个项目、爱好或日常习惯。只分享有帮助的部分就好。"
          }
        }
      }
    },
    "A quick way to find me": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schneller Weg zu mir"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una forma rápida de encontrarme"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moyen rapide de me trouver"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brz način da me nađeš"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modo rapido per trovarmi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぼくをすぐ呼べる方法"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybki sposób, żeby mnie znaleźć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jeito rápido de me encontrar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速找到我的方法"
          }
        }
      }
    },
    "A quiet week: nothing saved, ticked or changed, and nothing coming up that Doddy can see.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ruhige Woche: nichts gespeichert, abgehakt oder geändert, und nichts Anstehendes, das Doddy sehen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una semana tranquila: nada guardado, marcado ni cambiado, y nada a la vista que Doddy pueda ver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une semaine calme : rien d’enregistré, de coché ni de modifié, et rien à venir que Doddy puisse voir."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miran tjedan: ništa spremljeno, označeno ni promijenjeno, a Doddy ne vidi ništa što dolazi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una settimana tranquilla: niente salvato, spuntato o modificato, e niente in arrivo che Doddy possa vedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かな一週間でした。保存、チェック、変更はなく、Doddyに見える範囲ではこれからの予定もありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spokojny tydzień: nic nie zapisano, nie odhaczono ani nie zmieniono, a Doddy nie widzi nic nadchodzącego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma semana tranquila: nada salvo, marcado ou alterado, e nada à vista que o Doddy consiga ver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平静的一周：没有保存、勾选或更改任何内容，Doddy 也看不到即将到来的事。"
          }
        }
      }
    },
