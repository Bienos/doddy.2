    "Keep Precise Location on, or iOS can't tell when you get there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass „Genauer Standort“ an, sonst kann iOS nicht erkennen, wann du ankommst."
          }
        },
        "es": {
