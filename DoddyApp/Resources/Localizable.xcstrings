    "Doddy is a practical, curious mate who spots small hassles, answers first and admits when he got something wrong. Pick how he comes across.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy ist ein praktischer, neugieriger Begleiter, der kleine Ärgernisse bemerkt, zuerst antwortet und zugibt, wenn er etwas falsch hatte. Wähle, wie er rüberkommt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy es un compañero práctico y curioso que detecta pequeños engorros, responde primero y admite cuando se ha equivocado. Elige cómo se muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy est un compagnon pratique et curieux, qui repère les petits tracas, répond d’abord et reconnaît quand il s’est trompé. Choisis comment il se présente."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy je praktičan, znatiželjan tip koji uočava male gnjavaže, prvo odgovara i priznaje kad je nešto pogriješio. Odaberi kako će djelovati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy è un tipo pratico e curioso che nota le piccole seccature, risponde subito e ammette quando ha sbagliato. Scegli come si presenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyは実用的で好奇心旺盛な相棒です。小さな面倒に気づき、まず答えを言い、間違えたときは認めます。どんな話し方にするか選んでください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy to praktyczny, ciekawy świata kumpel, który wyłapuje drobne kłopoty, najpierw odpowiada i przyznaje się do błędu. Wybierz, jak ma wypadać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy é um companheiro prático e curioso que repara em pequenos aborrecimentos, responde primeiro e admite quando errou. Escolha como ele se apresenta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 是个务实、好奇的伙伴，能发现小麻烦，先回答问题，出错时会承认。选一选他给人的感觉。"
          }
        }
      }
    },
