    },
    "Doddy's opening. Doddy scores a basket.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powitanie Doddy’ego. Doddy trafia do kosza."
          }
        }
      }
    },
    "Doddy's phone line isn't set up on the server yet.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linia telefoniczna Doddy’ego nie jest jeszcze skonfigurowana na serwerze."
          }
        }
      }
    },
    "Doddy's phone line isn't set up on the server yet. Everything below starts working once it is.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linia telefoniczna Doddy’ego nie jest jeszcze ustawiona na serwerze. Wszystko poniżej zacznie działać, gdy będzie."
          }
        }
      }
    },
    "Doddy's screens follow your iPhone's language. This is for Doddy's replies.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrany Doddy’ego są w języku Twojego iPhone’a. To ustawienie dotyczy odpowiedzi Doddy’ego."
          }
        }
      }
    },
    "Don't add": {
      "extractionState": "manual",
      "localizations": {
