    },
    "Sign in once with Apple to set up your Doddy voice account. Apple sends a signed identity token to Doddy only to verify your account and create the session. The protected session stays on this iPhone, so you won’t need to sign in every time. Sign-in doesn’t share your voice or notes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sign in once with Apple to set up your Doddy voice account. Apple sends a signed identity token to Doddy only to verify your account and create the session. The protected session stays on this iPad, so you won’t need to sign in every time. Sign-in doesn’t share your voice or notes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sign in once with Apple to set up your Doddy voice account. Apple sends a signed identity token to Doddy only to verify your account and create the session. The protected session stays on this iPhone, so you won’t need to sign in every time. Sign-in doesn’t share your voice or notes."
                }
              }
            }
          }
        }
      }
    },
    "Sign in to iCloud in iOS Settings to keep shared lists up to date.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in den iOS-Einstellungen bei iCloud an, damit geteilte Listen aktuell bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud en los Ajustes de iOS para mantener al día las listas compartidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à iCloud dans Réglages iOS pour garder les listes partagées à jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavi se u iCloud u Postavkama iOS-a da dijeljeni popisi ostanu ažurni."
