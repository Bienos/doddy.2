    "Your message is in the conversation. Tap it to send it again. Your saved notes are not affected.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht steht im Gespräch. Tippe darauf, um sie erneut zu senden. Deine gespeicherten Notizen sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje está en la conversación. Tócalo para enviarlo de nuevo. Tus notas guardadas no se ven afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton message est dans la conversation. Touche-le pour l’envoyer à nouveau. Tes notes enregistrées ne sont pas affectées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja je poruka u razgovoru. Dodirni je da je ponovno pošalješ. Tvoje spremljene bilješke nisu zahvaćene."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo messaggio è nella conversazione. Toccalo per inviarlo di nuovo. Le tue note salvate non vengono toccate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは会話に残っています。タップするともう一度送信します。保存したメモには影響ありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
