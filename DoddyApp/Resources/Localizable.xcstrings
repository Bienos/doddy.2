    "Your notes and lists can be found from the iPhone's search. The index stays on this iPhone. Private notes are never included, and turning this off removes them all from search.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deine Notizen und Listen lassen sich über die iPad-Suche finden. Der Index bleibt auf diesem iPad. Private Notizen sind nie enthalten, und Ausschalten entfernt alle aus der Suche."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deine Notizen und Listen lassen sich über die iPhone-Suche finden. Der Index bleibt auf diesem iPhone. Private Notizen sind nie enthalten, und Ausschalten entfernt alle aus der Suche."
                }
              }
