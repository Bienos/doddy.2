    "Apple Maps worked out the travel time just now, from where your iPhone is; traffic can change. Your position isn't kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Karten hat die Fahrzeit gerade eben berechnet, von dort, wo dein iPhone ist; der Verkehr kann sich ändern. Dein Standort wird nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapas de Apple acaba de calcular el tiempo de trayecto desde donde está tu iPhone; el tráfico puede cambiar. Tu posición no se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Plans vient de calculer le temps de trajet, depuis l’endroit où se trouve ton iPhone ; la circulation peut changer. Ta position n’est pas conservée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleove Karte upravo su izračunale vrijeme puta, od mjesta gdje je tvoj iPhone; promet se može promijeniti. Tvoj položaj se ne čuva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappe di Apple ha calcolato il tempo di viaggio proprio ora, da dove si trova il tuo iPhone; il traffico può cambiare. La tua posizione non viene conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのマップが、iPhoneの現在地からたった今の所要時間を計算しました。交通状況は変わることがあります。位置情報は保存されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapy Apple obliczyły czas dojazdu przed chwilą, z miejsca, gdzie jest Twój iPhone; ruch może się zmienić. Twoja pozycja nie jest przechowywana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mapas da Apple calculou o tempo de trajeto agora há pouco, a partir de onde seu iPhone está; o trânsito pode mudar. Sua posição não é guardada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 地图刚刚根据你 iPhone 所在的位置计算了路程时间；路况可能会变化。你的位置不会被保留。"
          }
        }
      }
    },
