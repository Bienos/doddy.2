                  "state": "translated",
                  "value": "Otwiera Doddy’ego i zaczyna nagrywać. Nagrywanie trwa dalej w Dynamic Island. Dźwięk zostaje na tym iPadzie."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
