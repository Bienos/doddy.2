    "That address didn't return a news feed. Look for an RSS or Atom link on the site.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse hat keinen News-Feed geliefert. Such auf der Website nach einem RSS- oder Atom-Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa dirección no ha devuelto una fuente de noticias. Busca un enlace RSS o Atom en el sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse n’a pas renvoyé de flux d’actualités. Cherche un lien RSS ou Atom sur le site."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta adresa nije vratila kanal vijesti. Potraži RSS ili Atom poveznicu na stranici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quell'indirizzo non ha restituito un feed di notizie. Cerca un link RSS o Atom sul sito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのアドレスからニュースフィードが返ってきませんでした。サイトでRSSまたはAtomのリンクを探してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten adres nie zwrócił kanału z newsami. Poszukaj na stronie linku RSS lub Atom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse endereço não retornou um feed de notícias. Procure um link RSS ou Atom no site."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该地址没有返回新闻订阅源。请在网站上查找 RSS 或 Atom 链接。"
          }
        }
      }
    },
    "That alarm couldn't be turned off. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Wecker konnte nicht ausgeschaltet werden. Versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido desactivar esa alarma. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette alarme n’a pas pu être désactivée. Réessaie."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taj alarm nije bilo moguće isključiti. Pokušaj ponovno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile disattivare quella sveglia. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのアラームをオフにできませんでした。もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wyłączyć tego budzika. Spróbuj jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse alarme não pôde ser desligado. Tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法关闭该闹钟。请重试。"
          }
        }
      }
    },
    "That backup was made by a newer Doddy. Update Doddy, then try again. Nothing was added.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup stammt von einem neueren Doddy. Aktualisiere Doddy und versuch es dann noch einmal. Nichts wurde hinzugefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa copia de seguridad la hizo un Doddy más nuevo. Actualiza Doddy y vuelve a intentarlo. No se ha añadido nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a été faite par un Doddy plus récent. Mets Doddy à jour, puis réessaie. Rien n’a été ajouté."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu je sigurnosnu kopiju napravio noviji Doddy. Ažuriraj Doddyja, pa pokušaj ponovno. Ništa nije dodano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel backup è stato fatto da una versione più recente di Doddy. Aggiorna Doddy, poi riprova. Niente è stato aggiunto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのバックアップは、より新しいDoddyで作られたものです。Doddyをアップデートしてから、もう一度お試しください。何も追加されていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia zapasowa została zrobiona w nowszym Doddym. Zaktualizuj Doddy’ego i spróbuj ponownie. Nic nie zostało dodane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
