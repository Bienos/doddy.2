    "Phone calls need a Doddy messaging server, and none is connected in this build yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonanrufe brauchen einen Doddy-Nachrichtenserver, und in dieser Version ist noch keiner verbunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas necesitan un servidor de mensajes de Doddy, y en esta versión aún no hay ninguno conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
