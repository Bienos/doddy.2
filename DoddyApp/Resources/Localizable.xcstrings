    },
    "This clears Doddy's list only. Nothing in Reminders, Calendar or your notes changes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das leert nur die Liste von Doddy. Nichts in Erinnerungen, Kalender oder deinen Notizen ändert sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo vacía la lista de Doddy. No cambia nada en Recordatorios, Calendario ni en tus notas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci vide seulement la liste de Doddy. Rien ne change dans Rappels, Calendrier ni tes notes."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo briše samo Doddyjev popis. Ništa se u Podsjetnicima, Kalendaru ili tvojim bilješkama ne mijenja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo svuota solo la lista di Doddy. Niente cambia in Promemoria, Calendario o nelle tue note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消去されるのはDoddyのリストだけです。リマインダー、カレンダー、メモは何も変わりません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To czyści tylko listę Doddy’ego. Nic w Przypomnieniach, Kalendarzu ani Twoich notatkach się nie zmienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto limpa só a lista do Doddy. Nada muda no Lembretes, no Calendário ou nas suas notas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只会清空 Doddy 的清单。提醒事项、日历或你的笔记中的内容都不会改变。"
          }
        }
      }
    },
    "This doesn't turn anything on. Doddy asks separately before using the microphone or sending anything.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To niczego nie włącza. Doddy pyta osobno, zanim użyje mikrofonu albo cokolwiek wyśle."
