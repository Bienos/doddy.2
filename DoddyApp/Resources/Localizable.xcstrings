            "value": "Proponuj notatki po rozmowie"
          }
        }
      }
    },
    "Suggestions only. Nothing changes until you tap it.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To tylko propozycje. Nic się nie zmienia, dopóki tego nie stukniesz."
          }
        }
      }
    },
    "Switch off in Doddy": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
