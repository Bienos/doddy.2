        }
      }
    },
    "The fact marked PESEL doesn't hold a valid PESEL.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacja oznaczona jako PESEL nie zawiera poprawnego numeru PESEL."
          }
        }
      }
    },
    "The facts and routines you confirmed are handed to the voice service at the start of a conversation, like your notes. You can see this under Privacy, What leaves this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Fakten und Routinen, die du bestätigt hast, werden zu Beginn eines Gesprächs an den Sprachdienst übergeben, wie deine Notizen. Du siehst das unter Datenschutz, Was dieses iPad verlässt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die Fakten und Routinen, die du bestätigt hast, werden zu Beginn eines Gesprächs an den Sprachdienst übergeben, wie deine Notizen. Du siehst das unter Datenschutz, Was dieses iPhone verlässt."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The facts and routines you confirmed are handed to the voice service at the start of a conversation, like your notes. You can see this under Privacy, What leaves this iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The facts and routines you confirmed are handed to the voice service at the start of a conversation, like your notes. You can see this under Privacy, What leaves this iPhone."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los datos y rutinas que confirmaste se entregan al servicio de voz al empezar una conversación, como tus notas. Puedes verlo en Privacidad, Qué sale de este iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los datos y rutinas que confirmaste se entregan al servicio de voz al empezar una conversación, como tus notas. Puedes verlo en Privacidad, Qué sale de este iPhone."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les faits et les routines que tu as confirmés sont transmis au service vocal au début d’une conversation, comme tes notes. Tu peux le voir sous Confidentialité, Ce qui quitte cet iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les faits et les routines que tu as confirmés sont transmis au service vocal au début d’une conversation, comme tes notes. Tu peux le voir sous Confidentialité, Ce qui quitte cet iPhone."
                }
              }
            }
          }
        },
        "hr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Potvrđene činjenice i rutine predaju se glasovnoj usluzi na početku razgovora, kao i tvoje bilješke. To možeš vidjeti pod Privatnost, Što napušta ovaj iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Potvrđene činjenice i rutine predaju se glasovnoj usluzi na početku razgovora, kao i tvoje bilješke. To možeš vidjeti pod Privatnost, Što napušta ovaj iPhone."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "I fatti e le routine che hai confermato vengono passati al servizio vocale all'inizio di una conversazione, come le tue note. Puoi vederlo sotto Privacy, Cosa esce da questo iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "I fatti e le routine che hai confermato vengono passati al servizio vocale all'inizio di una conversazione, come le tue note. Puoi vederlo sotto Privacy, Cosa esce da questo iPhone."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "あなたが確認した事実とルーティンは、メモと同じように会話の開始時に音声サービスに渡されます。これは「プライバシー」の「このiPadから出るもの」で確認できます。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "あなたが確認した事実とルーティンは、メモと同じように会話の開始時に音声サービスに渡されます。これは「プライバシー」の「このiPhoneから出るもの」で確認できます。"
                }
