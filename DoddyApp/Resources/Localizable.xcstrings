      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź do ekranu początkowego i stuknij dwa razy w tył iPhone’a. Skrót powinien przenieść Cię z powrotem do Doddy’ego."
          }
