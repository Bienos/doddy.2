    "No alarms from Doddy. Ask Doddy, for example “Wake me at seven”.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Wecker von Doddy. Bitte Doddy, zum Beispiel „Weck mich um sieben“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay alarmas de Doddy. Pídeselo a Doddy, por ejemplo “Despiértame a las siete”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune alarme de Doddy. Demande à Doddy, par exemple « Réveille-moi à sept heures »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema alarma od Doddyja. Zamoli Doddyja, na primjer „Probudi me u sedam“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna sveglia da Doddy. Chiedi a Doddy, per esempio “Svegliami alle sette”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyのアラームはありません。たとえば「7時に起こして」とDoddyに頼んでください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak budzików od Doddy’ego. Poproś Doddy’ego, na przykład „Obudź mnie o siódmej”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum alarme do Doddy. Peça ao Doddy, por exemplo “Me acorde às sete”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 Doddy 设置的闹钟。可以让 Doddy 设置，例如“七点叫我起床”。"
          }
        }
      }
    },
