    "%lld more unfinished notes; each opens when you start a new note.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld weitere unfertige Notizen; jede öffnet sich, wenn du eine neue Notiz beginnst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld notas sin terminar más; cada una se abre cuando empiezas una nota nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld autres notes inachevées ; chacune s’ouvre quand tu commences une nouvelle note."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nedovršenih bilješki: %lld; svaka se otvara kad počneš novu bilješku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altre %lld note non finite; ognuna si apre quando inizi una nuova nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかに未完成のメモが%lld件あります。新しいメモを始めるたびに1件ずつ開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedokończonych notatek więcej: %lld; każda otworzy się, gdy zaczniesz nową notatkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais %lld notas inacabadas; cada uma abre quando você começa uma nota nova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 条未完成的笔记；每次你开始新笔记时会打开一条。"
          }
        }
      }
    },
    "%lld offers looked at, in %lld shops.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzane oferty: %lld, sklepy: %lld."
          }
        }
      }
    },
    "%lld offers, %lld shops.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofert: %lld, sklepów: %lld."
          }
        }
      }
    },
    "%lld photos and %lld voice memos couldn't be read on this iPhone, so they aren't in this backup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photos and %lld voice memos couldn't be read on this iPad, so they aren't in this backup."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photos and %lld voice memos couldn't be read on this iPhone, so they aren't in this backup."
                }
              }
            }
          }
        }
      }
    },
    "(Doddy asks for: %@)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(Doddy fragt nach: %@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(Doddy pide: %@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(Doddy demande : %@)"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "(Doddy pita za: %@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "(Doddy chiede: %@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（Doddyが聞くこと：%@）"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "(Doddy zapyta o: %@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "(O Doddy pede: %@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（Doddy 会询问：%@）"
          }
        }
      }
    },
    "+%@": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "+%@"
          }
        }
      }
    },
    "3 done": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrobione: 3"
          }
        }
      }
    },
    "A BLIK transfer for you to send": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przelew BLIK do wysłania przez Ciebie"
          }
        }
      }
    },
    "A PESEL can only be sent as a fact marked PESEL.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PESEL można wysłać tylko jako informację oznaczoną jako PESEL."
          }
        }
      }
    },
    "A PESEL-like number was said by Doddy. Check this line.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy powiedział numer podobny do PESEL. Sprawdź tę wypowiedź."
          }
        }
      }
    },
    "A browser": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądarka"
          }
        }
      }
    },
    "A browser stays signed in for 30 days, or until it goes unused for 14. It sees the files Doddy made, your online accounts and Doddy's receipts. It sees your notes and conversations only if you keep them on Doddy's server, below.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądarka zostaje zalogowana przez 30 dni albo do 14 dni bez użycia. Widzi pliki zrobione przez Doddy’ego, Twoje konta online i potwierdzenia Doddy’ego. Widzi Twoje notatki i rozmowy tylko wtedy, gdy przechowujesz je na serwerze Doddy’ego, poniżej."
          }
        }
      }
    },
    "A button\nfor Doddy.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przycisk\ndla Doddy’ego."
          }
        }
      }
    },
    "A call for this card is already on or waiting for its time.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie z tej karty już trwa albo czeka na swoją godzinę."
          }
        }
      }
    },
    "A draft, not a note: it's saved only if you tap Save as note.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Entwurf, keine Notiz: Er wird nur gespeichert, wenn du auf „Als Notiz speichern“ tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un borrador, no una nota: solo se guarda si tocas Guardar como nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brouillon, pas une note : il n’est enregistré que si tu touches Enregistrer comme note."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skica, ne bilješka: sprema se samo ako dodirneš „Spremi kao bilješku“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bozza, non una nota: si salva solo se tocchi “Salva come nota”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは下書きで、メモではありません。「メモとして保存」をタップしたときだけ保存されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To szkic, nie notatka: zapisze się dopiero po stuknięciu „Zapisz jako notatkę”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um rascunho, não uma nota: só é salvo se você tocar em Salvar como nota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是草稿，不是笔记：只有轻点“保存为笔记”才会保存。"
          }
        }
      }
    },
    "A fact, e.g. order number 12345": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacja, np. numer zlecenia 12345"
          }
        }
      }
    },
    "A handwritten or printed list. Doddy reads it on this iPhone; the photo isn't kept or sent anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Eine handgeschriebene oder gedruckte Liste. Doddy liest sie auf diesem iPad; das Foto wird weder behalten noch irgendwohin gesendet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Eine handgeschriebene oder gedruckte Liste. Doddy liest sie auf diesem iPhone; das Foto wird weder behalten noch irgendwohin gesendet."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A handwritten or printed list. Doddy reads it on this iPad; the photo isn't kept or sent anywhere."
                }
              },
