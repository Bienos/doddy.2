    },
    "You speak": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sprichst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú hablas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu parles"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti govoriš"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parli tu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが話す"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mówisz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você fala"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你说"
          }
        }
      }
    },
    "You took over": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejęto rozmowę"
          }
        }
      }
    },
    "You took over, so the rest of the call isn't in the transcript.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmowa została przejęta, więc jej dalszej części nie ma w zapisie."
          }
        }
      }
    },
    "You turned notifications off for Doddy in iOS Settings. Turn them on there to get updates.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Mitteilungen für Doddy in den iOS-Einstellungen ausgeschaltet. Schalte sie dort ein, um Updates zu bekommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivaste las notificaciones de Doddy en los Ajustes de iOS. Actívalas allí para recibir novedades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as désactivé les notifications de Doddy dans Réglages iOS. Active-les là-bas pour recevoir les infos."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti za Doddyja isključene su u Postavkama iOS-a. Uključi ih ondje da dobivaš ažuriranja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai disattivato le notifiche di Doddy nelle Impostazioni di iOS. Attivale lì per ricevere gli aggiornamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの設定でDoddyの通知をオフにしています。更新を受け取るには、そこでオンにしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączyłeś powiadomienia Doddy’ego w Ustawieniach iOS. Włącz je tam, aby dostawać aktualności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você desativou as notificações do Doddy nos Ajustes do iOS. Ative lá para receber atualizações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 iOS 设置中关闭了 Doddy 的通知。请在那里开启以接收更新。"
          }
        }
      }
    },
    "You'd saved “keys under the sofa cushion”.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hattest „Schlüssel unter dem Sofakissen“ gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habías guardado “llaves bajo el cojín del sofá”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu avais enregistré « clés sous le coussin du canapé »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaš spremljeno: „ključevi ispod jastuka na kauču“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avevi salvato “chiavi sotto il cuscino del divano”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「鍵はソファのクッションの下」と保存していました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisałeś „klucze pod poduszką na sofie”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tinha salvado “chaves embaixo da almofada do sofá”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你之前记下了“钥匙在沙发垫下面”。"
          }
        }
      }
    },
    "You're offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es hors ligne"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline si"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline"
          }
        },
