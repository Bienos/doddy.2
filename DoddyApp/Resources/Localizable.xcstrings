    },
    "Apple Maps found these. Pick one:": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapy Apple znalazły te miejsca. Wybierz jedno:"
          }
        }
      }
    },
    "Apple Reminders": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia Apple"
          }
