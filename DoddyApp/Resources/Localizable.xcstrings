              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Zobaczysz każdą notatkę, zanim cokolwiek zostanie zapisane. Pliki są czytane tylko na tym iPadzie."
                }
              },
              "other": {
                "stringUnit": {
