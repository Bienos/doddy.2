      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twilio wysyła jednorazowy kod, aby sprawdzić, że numer jest Twój. SMS-y z aktualnościami zaczną przychodzić dopiero, gdy je włączysz."
