    "Only what you choose to save appears here. Nothing is added automatically.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheint nur, was du speichern willst. Nichts wird automatisch hinzugefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí solo aparece lo que eliges guardar. No se añade nada automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul ce que tu choisis d’enregistrer apparaît ici. Rien n’est ajouté automatiquement."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje se prikazuje samo ono što odlučiš spremiti. Ništa se ne dodaje automatski."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui compare solo ciò che scegli di salvare. Niente viene aggiunto automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに表示されるのは、あなたが保存すると決めたものだけです。自動では何も追加されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawia się tu tylko to, co zdecydujesz się zapisać. Nic nie jest dodawane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o que você escolhe salvar aparece aqui. Nada é adicionado automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只显示你选择保存的内容。不会自动添加任何内容。"
          }
        }
      }
    },
    "Only you can tell which gesture ran it. iOS doesn't report that to apps.": {
