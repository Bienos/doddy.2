{
  "sourceLanguage": "en",
  "strings": {
    " (shared)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " (geteilt)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " (compartida)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " (partagée)"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": " (dijeljeno)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " (condivisa)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（共有中）"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " (udostępniona)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " (compartilhada)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（共享）"
          }
        }
      }
    },
    "\"That's wrong\" keeps it below, out of use, so you can see it. Delete removes it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Das stimmt nicht“ behält es unten, außer Gebrauch, damit du es sehen kannst. Löschen entfernt es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Eso está mal” lo deja abajo, fuera de uso, para que puedas verlo. Eliminar lo quita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« C’est faux » le garde ci-dessous, hors d’usage, pour que tu puisses le voir. Supprimer le retire."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„To je krivo“ ostavlja to ispod, izvan upotrebe, da to možeš vidjeti. Izbriši ga uklanja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Non è così” lo tiene qui sotto, fuori uso, così puoi vederlo. Elimina lo rimuove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「違います」を選ぶと、見えるように下に残したまま使わなくなります。「削除」は完全に消します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„To nieprawda” zostawia pozycję niżej, nieużywaną, żeby można ją było zobaczyć. Usuń kasuje ją całkiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Está errado” deixa o item abaixo, fora de uso, para você poder ver. Apagar remove."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“不对”会把它留在下方，不再使用，但你仍能看到。“删除”则会将其移除。"
          }
        }
      }
    },
    "%@ over your budget": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ponad Twój budżet"
          }
        }
      }
    },
    "%@ shared a reminder at “%@”.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat eine Erinnerung bei „%@“ geteilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha compartido un recordatorio en “%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a partagé un rappel à « %@ »."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dijeli podsjetnik na mjestu „%@“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha condiviso un promemoria a “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんが「%@」でリマインダーを共有しました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ udostępnia przypomnienie w miejscu „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ compartilhou um lembrete em “%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 共享了一条在“%@”的提醒。"
          }
        }
      }
    },
    "%lld calls still have a part of their cost unknown or pending, so no average is shown for them.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenia z częścią kosztu wciąż nieznaną lub w toku: %lld; dla nich średnia nie jest pokazywana."
          }
        }
      }
    },
