    "Lists and notes can't be turned into each other.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen und Notizen lassen sich nicht ineinander umwandeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas y las notas no se pueden convertir unas en otras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes et les notes ne peuvent pas être converties l’une en l’autre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popisi i bilješke ne mogu se pretvarati jedni u druge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste e note non possono essere trasformate le une nelle altre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストとメモは、互いに変換できません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Listy i notatek nie da się zamieniać jednych w drugie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas e notas não podem ser convertidas uma na outra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清单和笔记无法互相转换。"
          }
        }
      }
    },
