    "Not the same words. Check it's the one you meant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht dieselben Wörter. Prüfe, ob es die gemeinte ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No son las mismas palabras. Comprueba que es la que querías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ne sont pas les mêmes mots. Vérifie que c’est bien celle que tu voulais."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisu iste riječi. Provjeri je li to ona na koju misliš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono le stesse parole. Controlla che sia quella che intendevi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ言葉ではありません。意図したものか確認してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie te same słowa. Sprawdź, czy chodziło Ci o tę notatkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não são as mesmas palavras. Confira se é a que você queria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "措辞不一样。请确认这是你想要的那一条。"
          }
        }
      }
    },
