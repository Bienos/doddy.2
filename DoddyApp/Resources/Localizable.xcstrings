            "state": "translated",
            "value": "Tu atajo ha llegado a Doddy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton raccourci a atteint Doddy"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj prečac stigao je do Doddyja"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo comando ha raggiunto Doddy"
          }
        },
