    "Joining adds this list to Doddy on this iPhone. Its items, and the changes anyone makes, go through iCloud to everyone who shares it. Your notes and other lists aren't shared.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Beitreten fügt diese Liste zu Doddy auf diesem iPad hinzu. Ihre Einträge und die Änderungen aller gehen über iCloud an jeden, der sie teilt. Deine Notizen und anderen Listen werden nicht geteilt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Beitreten fügt diese Liste zu Doddy auf diesem iPhone hinzu. Ihre Einträge und die Änderungen aller gehen über iCloud an jeden, der sie teilt. Deine Notizen und anderen Listen werden nicht geteilt."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Joining adds this list to Doddy on this iPad. Its items, and the changes anyone makes, go through iCloud to everyone who shares it. Your notes and other lists aren't shared."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Joining adds this list to Doddy on this iPhone. Its items, and the changes anyone makes, go through iCloud to everyone who shares it. Your notes and other lists aren't shared."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Unirte añade esta lista a Doddy en este iPad. Sus elementos, y los cambios que haga cualquiera, pasan por iCloud a todos los que la comparten. Tus notas y tus otras listas no se comparten."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Unirte añade esta lista a Doddy en este iPhone. Sus elementos, y los cambios que haga cualquiera, pasan por iCloud a todos los que la comparten. Tus notas y tus otras listas no se comparten."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Rejoindre ajoute cette liste à Doddy sur cet iPad. Ses éléments, et les modifications de chacun, passent par iCloud vers tous ceux qui la partagent. Tes notes et tes autres listes ne sont pas partagées."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Rejoindre ajoute cette liste à Doddy sur cet iPhone. Ses éléments, et les modifications de chacun, passent par iCloud vers tous ceux qui la partagent. Tes notes et tes autres listes ne sont pas partagées."
                }
