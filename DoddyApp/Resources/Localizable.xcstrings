      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oto Twoja niedokończona notatka z %@. Nie jest zapisana, dopóki nie stukniesz Zapisz."
          }
        }
      }
    },
    "Here's what I'd do": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oto, co bym zrobił"
