    "Opens Doddy ready for a new note. Nothing is saved until you tap Save.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Doddy bereit für eine neue Notiz. Nichts wird gespeichert, bis du auf Speichern tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Doddy listo para una nota nueva. No se guarda nada hasta que toques Guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Doddy prêt pour une nouvelle note. Rien n’est enregistré tant que tu ne touches pas Enregistrer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara Doddyja spremnog za novu bilješku. Ništa se ne sprema dok ne dodirneš Spremi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Doddy pronto per una nuova nota. Niente viene salvato finché non tocchi Salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいメモを書ける状態でDoddyを開きます。「保存」をタップするまで、何も保存されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Doddy’ego gotowego na nową notatkę. Nic nie jest zapisywane, dopóki nie stukniesz Zapisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Doddy pronto para uma nota nova. Nada é salvo até você tocar em Salvar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Doddy 并准备好新建笔记。在你轻点“保存”之前，不会保存任何内容。"
          }
        }
      }
    },
    "Opens Doddy with this text ready to save. Nothing is saved until you tap Save.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Doddy mit diesem Text bereit zum Speichern. Nichts wird gespeichert, bis du auf Speichern tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Doddy con este texto listo para guardar. No se guarda nada hasta que toques Guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Doddy avec ce texte prêt à enregistrer. Rien n’est enregistré tant que tu ne touches pas Enregistrer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara Doddyja s ovim tekstom spremnim za spremanje. Ništa se ne sprema dok ne dodirneš Spremi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Doddy con questo testo pronto da salvare. Niente viene salvato finché non tocchi Salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテキストを保存できる状態でDoddyを開きます。「保存」をタップするまで、何も保存されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Doddy’ego z tym tekstem gotowym do zapisania. Nic nie jest zapisywane, dopóki nie stukniesz Zapisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Doddy com este texto pronto para salvar. Nada é salvo até você tocar em Salvar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Doddy 并准备好保存这段文字。在你轻点“保存”之前，不会保存任何内容。"
          }
        }
      }
    },
