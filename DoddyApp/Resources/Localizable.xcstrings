          }
        }
      }
    },
    "Doddy looks through what you told it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy sieht durch, was du ihm gesagt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy repasa lo que le has contado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy parcourt ce que tu lui as dit."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy pregledava ono što mu kažeš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy cerca tra ciò che gli hai detto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyが、あなたが伝えたことの中から探します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy przegląda to, co mu powiedziałeś."
          }
        },
