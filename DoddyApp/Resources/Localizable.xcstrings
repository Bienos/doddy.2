    "Recording couldn't start. If you're talking to Doddy or on a call, finish that first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht starten. Wenn du mit Doddy redest oder telefonierst, beende das zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido empezar a grabar. Si estás hablando con Doddy o en una llamada, termina eso primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement n’a pas pu démarrer. Si tu parles à Doddy ou si tu es en appel, termine d’abord."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimanje nije moglo početi. Ako razgovaraš s Doddyjem ili si na pozivu, prvo to završi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione non è potuta partire. Se stai parlando con Doddy o sei al telefono, finisci prima quello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を開始できませんでした。Doddyと話している途中か通話中なら、先にそれを終えてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zacząć nagrywania. Jeśli rozmawiasz z Doddym albo przez telefon, najpierw to zakończ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação não pôde começar. Se você está falando com o Doddy ou em uma chamada, termine isso primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始录音。如果你正在和 Doddy 聊天或正在通话，请先结束。"
