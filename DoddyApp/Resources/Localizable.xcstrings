          }
        }
      }
    },
    "Your memories were saved by a newer version of Doddy, so this version can't open them. Nothing was deleted or reset. Install the latest version of Doddy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gemerktes wurde von einer neueren Version von Doddy gespeichert, also kann diese Version es nicht öffnen. Nichts wurde gelöscht oder zurückgesetzt. Installiere die neueste Version von Doddy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus recuerdos los guardó una versión más nueva de Doddy, así que esta versión no puede abrirlos. No se ha eliminado ni restablecido nada. Instala la última versión de Doddy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes souvenirs ont été enregistrés par une version plus récente de Doddy, donc cette version ne peut pas les ouvrir. Rien n’a été supprimé ni réinitialisé. Installe la dernière version de Doddy."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja je sjećanja spremila novija verzija Doddyja, pa ih ova verzija ne može otvoriti. Ništa nije izbrisano ni resetirano. Instaliraj najnoviju verziju Doddyja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi ricordi sono stati salvati da una versione più recente di Doddy, quindi questa versione non può aprirli. Niente è stato eliminato o azzerato. Installa l'ultima versione di Doddy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶はより新しいバージョンのDoddyで保存されたため、このバージョンでは開けません。何も削除もリセットもされていません。最新バージョンのDoddyをインストールしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje notatki zostały zapisane przez nowszą wersję Doddy’ego, więc ta wersja nie może ich otworzyć. Nic nie zostało usunięte ani zresetowane. Zainstaluj najnowszą wersję Doddy’ego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas memórias foram salvas por uma versão mais nova do Doddy, então esta versão não consegue abri-las. Nada foi apagado ou redefinido. Instale a versão mais recente do Doddy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的记忆是由更新版本的 Doddy 保存的，所以此版本无法打开。没有删除或重置任何内容。请安装最新版本的 Doddy。"
          }
        }
      }
    },
    "Your memories.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
