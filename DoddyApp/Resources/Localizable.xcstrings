    "Notifications and texts stop. Your memories on this iPhone stay.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Mitteilungen und SMS hören auf. Dein Gemerktes auf diesem iPad bleibt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Mitteilungen und SMS hören auf. Dein Gemerktes auf diesem iPhone bleibt."
