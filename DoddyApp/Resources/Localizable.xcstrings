      }
    },
    "Verify your phone number first, in Settings → Notifications and texts.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw potwierdź numer telefonu w Ustawieniach → Powiadomienia i SMS-y."
          }
        }
      }
    },
    "Verify your phone number first.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw potwierdź numer telefonu."
          }
        }
