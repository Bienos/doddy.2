                  "state": "translated",
                  "value": "Ves cada nota antes de que se guarde nada. Los archivos se leen solo en este iPhone."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tu vois chaque note avant que quoi que ce soit soit enregistré. Les fichiers sont lus sur cet iPad uniquement."
                }
