    "It is removed from this iPhone and won't be brought up again. Notes you saved during it stay, and the voice provider (OpenAI or ElevenLabs) may keep its own record as described in Settings › Privacy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Es wird von diesem iPad entfernt und nicht wieder aufgegriffen. Notizen, die du währenddessen gespeichert hast, bleiben, und der Stimmanbieter (OpenAI oder ElevenLabs) kann eine eigene Aufzeichnung behalten, wie unter Einstellungen › Datenschutz beschrieben."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Es wird von diesem iPhone entfernt und nicht wieder aufgegriffen. Notizen, die du währenddessen gespeichert hast, bleiben, und der Stimmanbieter (OpenAI oder ElevenLabs) kann eine eigene Aufzeichnung behalten, wie unter Einstellungen › Datenschutz beschrieben."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "It is removed from this iPad and won't be brought up again. Notes you saved during it stay, and the voice provider (OpenAI or ElevenLabs) may keep its own record as described in Settings › Privacy."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
