    "Saved to your memories, but it couldn't be removed from this list. Tap Discard to remove it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemerkt, aber es konnte nicht von dieser Liste entfernt werden. Tippe auf Verwerfen, um es zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en tus recuerdos, pero no se ha podido quitar de esta lista. Toca Descartar para quitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré dans tes souvenirs, mais impossible de le retirer de cette liste. Touche Abandonner pour le retirer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljeno u tvoja sjećanja, ali nije bilo moguće ukloniti s ovog popisa. Dodirni Odbaci da to ukloniš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato nei tuoi ricordi, ma non è stato possibile rimuoverlo da questa lista. Tocca Scarta per rimuoverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶に保存しましたが、このリストからは削除できませんでした。「破棄」をタップして削除してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano w notatkach, ale nie udało się usunąć tego z tej listy. Stuknij Odrzuć, żeby to usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo nas suas memórias, mas não pôde ser removido desta lista. Toque em Descartar para remover."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存到你的记忆，但无法从这个清单中移除。轻点“放弃”来移除它。"
          }
        }
      }
    },
    "Saved “%@” as a template with %lld items. Start a new list from it under New list, or ask Doddy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ als Vorlage mit %lld Einträgen gespeichert. Starte daraus eine neue Liste unter Neue Liste, oder bitte Doddy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” guardada como plantilla con %lld elementos. Empieza una lista nueva a partir de ella en Nueva lista, o pídeselo a Doddy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » enregistré comme modèle avec %lld éléments. Commence une nouvelle liste à partir de lui sous Nouvelle liste, ou demande à Doddy."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ spremljeno kao predložak sa stavkama: %lld. Novi popis iz njega počni pod Novi popis ili zamoli Doddyja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” salvata come modello con %lld voci. Inizia una nuova lista da lì sotto Nuova lista, o chiedi a Doddy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を%lld項目のテンプレートとして保存しました。「新規リスト」からこのテンプレートで新しいリストを作るか、Doddyに頼んでください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano „%@” jako szablon z pozycjami: %lld. Nową listę z niego zaczniesz w Nowa lista albo prosząc Doddy’ego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” salvo como modelo com %lld itens. Comece uma lista nova a partir dele em Nova lista, ou peça ao Doddy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将“%@”保存为模板，含 %lld 项。可在“新建清单”中用它创建新清单，或者让 Doddy 来做。"
          }
        }
      }
    },
    "Saved. Remove from this list": {
