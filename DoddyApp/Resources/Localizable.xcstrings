        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に何か書いてください。空のメモは保存されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw coś napisz. Puste notatki nie są zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva algo primeiro. Notas vazias não são salvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先写点什么。空笔记不会保存。"
          }
        }
      }
    },
