    "Analytics and telemetry": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analityka i telemetria"
          }
        }
      }
    },
    "And how do you like your answers?": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "A jakie odpowiedzi lubisz?"
          }
        }
      }
    },
    "Another app has Doddy's audio. He can't hear you until it lets go.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inna aplikacja zajęła dźwięk Doddy’ego. Nie usłyszy Cię, dopóki go nie zwolni."
          }
        }
      }
    },
    "Answer calls from my number": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbieraj połączenia z mojego numeru"
          }
        }
      }
    },
    "Answer the intro questions again": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedz ponownie na pytania wstępne"
          }
        }
      }
    },
    "Any RSS or Atom feed, for example a blog or a local newspaper.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
