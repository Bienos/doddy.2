            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Pridruživanje dodaje ovaj popis Doddyju na ovom iPadu. Njegove stavke i promjene koje bilo tko napravi idu preko iClouda svima koji ga dijele. Tvoje bilješke i drugi popisi ne dijele se."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Pridruživanje dodaje ovaj popis Doddyju na ovom iPhoneu. Njegove stavke i promjene koje bilo tko napravi idu preko iClouda svima koji ga dijele. Tvoje bilješke i drugi popisi ne dijele se."
                }
