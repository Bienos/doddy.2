      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś wieczorem"
          }
        }
      }
    },
    "This file couldn't be read.": {
      "extractionState": "manual",
