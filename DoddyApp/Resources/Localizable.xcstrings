    "Asks first. Puts back only what Doddy did, if it hasn't changed since.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt zuerst. Setzt nur zurück, was Doddy gemacht hat, und nur, wenn es sich seitdem nicht geändert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta primero. Solo revierte lo que hizo Doddy, si no ha cambiado desde entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande d’abord. Ne remet en place que ce que Doddy a fait, si rien n’a changé depuis."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo pita. Vraća samo ono što je Doddy napravio, i to samo ako se otad nije promijenilo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede prima. Ripristina solo ciò che ha fatto Doddy, e solo se nel frattempo non è cambiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず確認します。Doddyがしたことだけを、その後変更されていなければ元に戻します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw pyta. Cofa tylko to, co zrobił Doddy, i tylko jeśli od tamtej pory nic się nie zmieniło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunta antes. Só desfaz o que o Doddy fez, e só se nada mudou desde então."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会先询问。只撤回 Doddy 做过的事，而且仅在此后没有被更改的情况下。"
          }
        }
      }
    },
    "Asks for Face ID or your passcode when Doddy opens and after a minute away. Private notes always ask before showing their words.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt nach Face ID oder deinem Code, wenn Doddy geöffnet wird und nach einer Minute Abwesenheit. Private Notizen fragen immer, bevor sie ihren Text zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide Face ID o tu código al abrir Doddy y tras un minuto fuera. Las notas privadas siempre lo piden antes de mostrar su texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande Face ID ou ton code à l’ouverture de Doddy et après une minute d’absence. Les notes privées demandent toujours avant d’afficher leur contenu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traži Face ID ili tvoju šifru kad se Doddy otvori i nakon minute odsutnosti. Privatne bilješke uvijek pitaju prije nego što pokažu svoj tekst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede Face ID o il tuo codice quando apri Doddy e dopo un minuto di assenza. Le note private chiedono sempre prima di mostrare il testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyを開いたときと、1分間離れた後にFace IDまたはパスコードを求めます。プライベートなメモは、内容を表示する前に必ず確認します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosi o Face ID lub kod, gdy otwierasz Doddy’ego i po minucie nieobecności. Prywatne notatki zawsze pytają, zanim pokażą swoje słowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede o Face ID ou seu código quando o Doddy abre e depois de um minuto fora. Notas privadas sempre pedem antes de mostrar suas palavras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Doddy 时以及离开一分钟后，会要求面容 ID 或密码。私密笔记在显示内容前总会先验证。"
          }
        }
      }
    },
