    "Removes your anonymous server account, this iPhone's notification token, your phone number, queued updates, call settings, notes from calls and any memory copy for calls. Memories on this iPhone are not affected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Removes your anonymous server account, this iPad's notification token, your phone number, queued updates, call settings, notes from calls and any memory copy for calls. Memories on this iPad are not affected."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Removes your anonymous server account, this iPhone's notification token, your phone number, queued updates, call settings, notes from calls and any memory copy for calls. Memories on this iPhone are not affected."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Usuwa Twoje anonimowe konto na serwerze, token powiadomień tego iPada, numer telefonu, oczekujące wiadomości, ustawienia rozmów, notatki z rozmów i każdą kopię notatek do rozmów. Notatki na tym iPadzie pozostają bez zmian."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Usuwa Twoje anonimowe konto na serwerze, token powiadomień tego iPhone’a, numer telefonu, oczekujące wiadomości, ustawienia rozmów, notatki z rozmów i każdą kopię notatek do rozmów. Notatki na tym iPhonie pozostają bez zmian."
                }
              }
            }
          }
        }
      }
    },
