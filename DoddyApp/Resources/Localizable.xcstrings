    "Removes your anonymous server account, this iPhone's notification token, your phone number, queued updates, call settings, notes from calls and any memory copy for calls. Memories on this iPhone are not affected.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Entfernt dein anonymes Serverkonto, das Mitteilungs-Token von diesem iPad, deine Telefonnummer, wartende Updates, Anrufeinstellungen, Notizen aus Anrufen und jede Gedächtniskopie für Anrufe. Gemerktes auf diesem iPad ist nicht betroffen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Entfernt dein anonymes Serverkonto, das Mitteilungs-Token von diesem iPhone, deine Telefonnummer, wartende Updates, Anrufeinstellungen, Notizen aus Anrufen und jede Gedächtniskopie für Anrufe. Gemerktes auf diesem iPhone ist nicht betroffen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Removes your anonymous server account, this iPad's notification token, your phone number, queued updates, call settings, notes from calls and any memory copy for calls. Memories on this iPad are not affected."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Removes your anonymous server account, this iPhone's notification token, your phone number, queued updates, call settings, notes from calls and any memory copy for calls. Memories on this iPhone are not affected."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Elimina tu cuenta anónima del servidor, el token de notificaciones de este iPad, tu número de teléfono, las novedades en cola, los ajustes de llamadas, las notas de las llamadas y cualquier copia de recuerdos para llamadas. Los recuerdos en este iPad no se ven afectados."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
