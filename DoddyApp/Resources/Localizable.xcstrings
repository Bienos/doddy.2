            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una lista escrita a mano o impresa. Doddy la lee en este iPad; la foto no se guarda ni se envía a ningún sitio."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
