    "Lists you share are also in iCloud and with the people you invited.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen, die du teilst, sind auch in iCloud und bei den eingeladenen Personen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas que compartes están también en iCloud y con las personas que invitaste."
