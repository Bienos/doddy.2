    "Moved %lld to tomorrow. %lld couldn't be moved (changed in Reminders, or the time doesn't exist tomorrow); check them there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld auf morgen verschoben. %lld konnten nicht verschoben werden (in Erinnerungen geändert, oder die Uhrzeit gibt es morgen nicht); prüfe sie dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pasados a mañana. %lld no se han podido mover (cambiados en Recordatorios, o la hora no existe mañana); compruébalos allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld reporté(s) à demain. %lld n’ont pas pu l’être (modifiés dans Rappels, ou l’heure n’existe pas demain) ; vérifie-les là-bas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premješteno na sutra: %lld. Nije bilo moguće premjestiti: %lld (promijenjeno u Podsjetnicima ili to vrijeme sutra ne postoji); provjeri ih ondje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostati a domani: %lld. Non è stato possibile spostarne %lld (modificati in Promemoria, o l'ora non esiste domani); controllali lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件を明日に移しました。%lld件は移せませんでした（リマインダーで変更されたか、明日にはその時刻がありません）。リマインダーで確認してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeniesiono na jutro: %lld. Nie udało się przenieść: %lld (zmienione w Przypomnieniach albo ta godzina jutro nie istnieje); sprawdź je tam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld movidos para amanhã. %lld não puderam ser movidos (alterados no Lembretes, ou o horário não existe amanhã); verifique lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 %lld 项移到明天。有 %lld 项无法移动（在提醒事项中被更改过，或明天没有这个时间）；请到那里检查。"
          }
        }
      }
    },
