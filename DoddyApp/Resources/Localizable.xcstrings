    "Monthly reminders can be on days 1 to 28, so every month has the day. Nothing was set.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monatliche Erinnerungen gehen an den Tagen 1 bis 28, damit jeder Monat den Tag hat. Nichts wurde gestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios mensuales pueden ser los días 1 a 28, para que todos los meses tengan ese día. No se ha programado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels mensuels peuvent être du 1er au 28, pour que chaque mois ait ce jour. Rien n’a été réglé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjesečni podsjetnici mogu biti na dane od 1. do 28., tako da svaki mjesec ima taj dan. Ništa nije postavljeno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria mensili possono essere nei giorni da 1 a 28, così ogni mese ha quel giorno. Non è stato impostato niente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月のリマインダーは1日から28日までに設定できます。どの月にもその日があるためです。何も設定されていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Comiesięczne przypomnienia mogą być w dniach od 1 do 28, żeby każdy miesiąc miał ten dzień. Nic nie zostało ustawione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes mensais podem ficar nos dias 1 a 28, para que todo mês tenha o dia. Nada foi definido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月提醒只能设在 1 到 28 日，这样每个月都有这一天。没有设置任何内容。"
          }
        }
      }
    },
