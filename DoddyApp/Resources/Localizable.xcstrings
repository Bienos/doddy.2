        },
        "pl": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Potwierdzone przez Ciebie fakty i rutyny są przekazywane usłudze głosowej na początku rozmowy, tak jak Twoje notatki. Zobaczysz to w Prywatności, w Co opuszcza tego iPada."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Potwierdzone przez Ciebie fakty i rutyny są przekazywane usłudze głosowej na początku rozmowy, tak jak Twoje notatki. Zobaczysz to w Prywatności, w Co opuszcza tego iPhone’a."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Os fatos e rotinas que você confirmou são passados ao serviço de voz no começo de uma conversa, como suas notas. Você pode ver isso em Privacidade, O que sai deste iPad."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Os fatos e rotinas que você confirmou são passados ao serviço de voz no começo de uma conversa, como suas notas. Você pode ver isso em Privacidade, O que sai deste iPhone."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "你确认过的事实和例行流程会在对话开始时交给语音服务，和你的笔记一样。你可以在隐私的“哪些内容会离开这台 iPad”下查看。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "你确认过的事实和例行流程会在对话开始时交给语音服务，和你的笔记一样。你可以在隐私的“哪些内容会离开这台 iPhone”下查看。"
