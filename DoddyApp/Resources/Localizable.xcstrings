          }
        }
      }
    },
    "Doddy needs your location while you use the app to remind you at a place. Nothing was set. Allow it in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy braucht deinen Standort, während du die App nutzt, um dich an einem Ort zu erinnern. Nichts wurde gestellt. Erlaube es in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy necesita tu ubicación mientras usas la app para recordártelo en un lugar. No se ha programado nada. Permítelo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy a besoin de ta position pendant que tu utilises l’app pour te faire un rappel à un lieu. Rien n’a été réglé. Autorise-le dans Réglages."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy treba tvoju lokaciju dok koristiš aplikaciju da te podsjeti na nekom mjestu. Ništa nije postavljeno. Dopusti to u Postavkama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy ha bisogno della tua posizione mentre usi l'app per ricordartelo in un luogo. Non è stato impostato niente. Consentilo in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所でリマインドするには、アプリの使用中にDoddyが位置情報を使う必要があります。何も設定されていません。「設定」で許可してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy potrzebuje Twojej lokalizacji podczas używania aplikacji, żeby przypomnieć Ci w danym miejscu. Nic nie zostało ustawione. Zezwól na to w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy precisa da sua localização enquanto você usa o app para lembrar você em um lugar. Nada foi definido. Permita nos Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 需要在你使用应用期间获取你的位置，才能在某个地点提醒你。没有设置任何内容。请在设置中允许。"
          }
        }
      }
    },
    "Doddy never calls emergency or short numbers.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy nigdy nie dzwoni na numery alarmowe ani skrócone."
          }
        }
      }
    },
    "Doddy never calls premium or shared-cost numbers.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy nigdy nie dzwoni na numery o podwyższonej opłacie ani z dzieloną opłatą."
          }
        }
      }
    },
    "Doddy never says card or bank account numbers on a call.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy nigdy nie podaje w rozmowie numerów kart ani kont bankowych."
          }
        }
      }
    },
    "Doddy noticed this in what you said. It stays on this iPhone. It is handed to Doddy in a conversation only if you turned that on in Settings, What I've learned.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Doddy ist das in dem aufgefallen, was du gesagt hast. Es bleibt auf diesem iPad. Es wird Doddy in einem Gespräch nur übergeben, wenn du das unter Einstellungen, Was ich gelernt habe, eingeschaltet hast."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Doddy ist das in dem aufgefallen, was du gesagt hast. Es bleibt auf diesem iPhone. Es wird Doddy in einem Gespräch nur übergeben, wenn du das unter Einstellungen, Was ich gelernt habe, eingeschaltet hast."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Doddy noticed this in what you said. It stays on this iPad. It is handed to Doddy in a conversation only if you turned that on in Settings, What I've learned."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Doddy noticed this in what you said. It stays on this iPhone. It is handed to Doddy in a conversation only if you turned that on in Settings, What I've learned."
