              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uma lista escrita à mão ou impressa. O Doddy lê neste iPad; a foto não é guardada nem enviada a lugar nenhum."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uma lista escrita à mão ou impressa. O Doddy lê neste iPhone; a foto não é guardada nem enviada a lugar nenhum."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "一份手写或打印的清单。Doddy 在这台 iPad 上读取它；照片不会保留，也不会发送到任何地方。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "一份手写或打印的清单。Doddy 在这台 iPhone 上读取它；照片不会保留，也不会发送到任何地方。"
                }
              }
            }
          }
        }
      }
    },
    "A little\ntidier.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein bisschen\naufgeräumter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco\nmás en orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu\nplus rangé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Malo\nurednije."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un po'\npiù in ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しだけ\nすっきり。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trochę\nporządniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco\nmais arrumado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更清爽\n一点。"
          }
        }
      }
    },
    "A little dry humor, or straight to the useful bit?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein bisschen trockener Humor oder gleich zum Nützlichen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Un poco de humor seco o directo a lo útil?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu d’humour pince-sans-rire, ou directement l’essentiel ?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Malo suhog humora ili odmah na stvar?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pizzico di umorismo asciutto, o subito al sodo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し軽いユーモアを交えますか？それとも要点だけ？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trochę suchego humoru czy od razu do rzeczy?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco de humor seco ou direto ao que importa?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来点冷幽默，还是直接说重点？"
          }
        }
      }
    },
    "A little help finding it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleine Hilfe beim Finden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ayuda para encontrarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit coup de main pour le retrouver"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mala pomoć pri traženju"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piccolo aiuto per trovarlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つけるためのちょっとした手助け"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mała pomoc w szukaniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ajudinha para encontrar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮你找一找"
          }
        }
      }
    },
    "A mate in your pocket": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "A mate in your pocket"
          }
        }
      }
    },
    "A name or nickname is enough. It doesn't verify who you are.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Name oder Spitzname reicht. Er bestätigt nicht, wer du bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un nombre o un apodo basta. No verifica quién eres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un prénom ou un surnom suffit. Ça ne vérifie pas qui tu es."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoljno je ime ili nadimak. Ne provjerava tko si."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta un nome o un soprannome. Non verifica chi sei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前かニックネームで十分です。本人確認には使いません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczy imię lub ksywka. To nie potwierdza, kim jesteś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome ou apelido basta. Isso não verifica quem você é."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字或昵称就够了。这不会验证你的身份。"
          }
        }
      }
    },
    "A new try uses the same card, approved again for the time you pick. Only times when the whole call fits inside 8:00–23:00.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa próba używa tej samej karty, zatwierdzonej ponownie na wybraną godzinę. Tylko godziny, w których cała rozmowa mieści się między 8:00 a 23:00."
          }
        }
      }
    },
    "A notification at this time says only \"A quick look at your day?\". Tap it to see today's Doddy reminders and lists on this iPhone, then talk it through if you like.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Eine Mitteilung um diese Zeit sagt nur „Ein kurzer Blick auf deinen Tag?“. Tippe darauf, um die heutigen Doddy-Erinnerungen und Listen auf diesem iPad zu sehen, und sprich sie dann durch, wenn du magst."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Eine Mitteilung um diese Zeit sagt nur „Ein kurzer Blick auf deinen Tag?“. Tippe darauf, um die heutigen Doddy-Erinnerungen und Listen auf diesem iPhone zu sehen, und sprich sie dann durch, wenn du magst."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A notification at this time says only \"A quick look at your day?\". Tap it to see today's Doddy reminders and lists on this iPad, then talk it through if you like."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A notification at this time says only \"A quick look at your day?\". Tap it to see today's Doddy reminders and lists on this iPhone, then talk it through if you like."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una notificación a esta hora dice solo “¿Un vistazo rápido a tu día?”. Tócala para ver los recordatorios y las listas de Doddy de hoy en este iPad y, si quieres, coméntalo con Doddy."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una notificación a esta hora dice solo “¿Un vistazo rápido a tu día?”. Tócala para ver los recordatorios y las listas de Doddy de hoy en este iPhone y, si quieres, coméntalo con Doddy."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "À cette heure, une notification dit seulement « Un coup d’œil sur ta journée ? ». Touche-la pour voir les rappels et les listes Doddy du jour sur cet iPad, puis en parler avec lui si tu veux."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "À cette heure, une notification dit seulement « Un coup d’œil sur ta journée ? ». Touche-la pour voir les rappels et les listes Doddy du jour sur cet iPhone, puis en parler avec lui si tu veux."
                }
              }
            }
          }
        },
        "hr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Obavijest u to vrijeme kaže samo „Kratak pogled na tvoj dan?“. Dodirni je da vidiš današnje Doddyjeve podsjetnike i popise na ovom iPadu, a zatim ih, ako želiš, prođi s njim u razgovoru."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Obavijest u to vrijeme kaže samo „Kratak pogled na tvoj dan?“. Dodirni je da vidiš današnje Doddyjeve podsjetnike i popise na ovom iPhoneu, a zatim ih, ako želiš, prođi s njim u razgovoru."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A quest'ora una notifica dice solo “Uno sguardo rapido alla tua giornata?”. Toccala per vedere i promemoria e le liste di Doddy di oggi su questo iPad, poi se vuoi parlane con lui."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A quest'ora una notifica dice solo “Uno sguardo rapido alla tua giornata?”. Toccala per vedere i promemoria e le liste di Doddy di oggi su questo iPhone, poi se vuoi parlane con lui."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "この時刻の通知には「今日の予定をさっと確認しますか？」とだけ表示されます。タップすると、このiPadにある今日のDoddyのリマインダーとリストが見られます。よければ、そのまま話して整理できます。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "この時刻の通知には「今日の予定をさっと確認しますか？」とだけ表示されます。タップすると、このiPhoneにある今日のDoddyのリマインダーとリストが見られます。よければ、そのまま話して整理できます。"
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O tej godzinie powiadomienie powie tylko „Szybki rzut oka na Twój dzień?”. Stuknij je, aby zobaczyć dzisiejsze przypomnienia Doddy’ego i listy na tym iPadzie, a potem, jeśli chcesz, omówić je."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O tej godzinie powiadomienie powie tylko „Szybki rzut oka na Twój dzień?”. Stuknij je, aby zobaczyć dzisiejsze przypomnienia Doddy’ego i listy na tym iPhonie, a potem, jeśli chcesz, omówić je."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uma notificação nesse horário diz só “Uma olhada rápida no seu dia?”. Toque nela para ver os lembretes e as listas de hoje do Doddy neste iPad e, se quiser, conversar sobre eles."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uma notificação nesse horário diz só “Uma olhada rápida no seu dia?”. Toque nela para ver os lembretes e as listas de hoje do Doddy neste iPhone e, se quiser, conversar sobre eles."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "到了这个时间，通知只会显示“快速看一眼你的一天？”。轻点它，就能在这台 iPad 上查看今天的 Doddy 提醒和清单，愿意的话再和 Doddy 聊一聊。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "到了这个时间，通知只会显示“快速看一眼你的一天？”。轻点它，就能在这台 iPhone 上查看今天的 Doddy 提醒和清单，愿意的话再和 Doddy 聊一聊。"
                }
              }
            }
          }
        }
      }
    },
    "A notification at this time says only \"Anything to move to tomorrow?\". Tap it to see open reminders from today and move the ones you pick. Needs Reminders on in Connections.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung um diese Zeit sagt nur „Etwas auf morgen verschieben?“. Tippe darauf, um die offenen Erinnerungen von heute zu sehen und die zu verschieben, die du auswählst. Dafür müssen Erinnerungen unter Verbindungen eingeschaltet sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación a esta hora dice solo “¿Algo que pasar a mañana?”. Tócala para ver los recordatorios de hoy que siguen abiertos y pasar a mañana los que elijas. Necesita Recordatorios activado en Conexiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cette heure, une notification dit seulement « Quelque chose à reporter à demain ? ». Touche-la pour voir les rappels du jour encore ouverts et reporter ceux que tu choisis. Nécessite Rappels activé dans Connexions."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijest u to vrijeme kaže samo „Ima li što za prebaciti na sutra?“. Dodirni je da vidiš otvorene podsjetnike od danas i premjestiš one koje odabereš. Potrebni su uključeni Podsjetnici u Vezama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quest'ora una notifica dice solo “Qualcosa da spostare a domani?”. Toccala per vedere i promemoria di oggi ancora aperti e spostare quelli che scegli. Richiede Promemoria attivo in Collegamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時刻の通知には「明日に移すものはありますか？」とだけ表示されます。タップすると今日の未完了のリマインダーが見られ、選んだものを明日に移せます。「連携」でリマインダーをオンにする必要があります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O tej godzinie powiadomienie powie tylko „Coś przenieść na jutro?”. Stuknij je, aby zobaczyć otwarte przypomnienia z dzisiaj i przenieść te, które wybierzesz. Wymaga włączonych Przypomnień w Połączeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação nesse horário diz só “Algo para passar para amanhã?”. Toque nela para ver os lembretes de hoje ainda abertos e mover os que você escolher. Precisa de Lembretes ativado em Conexões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到了这个时间，通知只会显示“有什么要移到明天的吗？”。轻点它，查看今天未完成的提醒，并移动你选中的那些。需要在“连接”中开启提醒事项。"
          }
        }
      }
    },
