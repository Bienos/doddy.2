            }
          }
        },
        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Doddyは、あなたが何かを元に戻した、手順を変えた、「違う」と言った、同じことをもう一度頼んだ、カードに答えなかった、といった回数を数えています。Doddyが上達しているか確かめられるようにするためです。保存されるのは出来事の種類とツール名だけで、このiPadに90日間保存され、送信されることはありません。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Doddyは、あなたが何かを元に戻した、手順を変えた、「違う」と言った、同じことをもう一度頼んだ、カードに答えなかった、といった回数を数えています。Doddyが上達しているか確かめられるようにするためです。保存されるのは出来事の種類とツール名だけで、このiPhoneに90日間保存され、送信されることはありません。"
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Doddy liczy, jak często cofasz zmianę, poprawiasz krok, mówisz „To nieprawda”, prosisz o to samo jeszcze raz albo zostawiasz propozycję bez odpowiedzi, żeby można było zobaczyć, czy robi postępy. Zapisywany jest tylko rodzaj zdarzenia i nazwa narzędzia, przez 90 dni, na tym iPadzie, i nigdy nie jest to wysyłane."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Doddy liczy, jak często cofasz zmianę, poprawiasz krok, mówisz „To nieprawda”, prosisz o to samo jeszcze raz albo zostawiasz propozycję bez odpowiedzi, żeby można było zobaczyć, czy robi postępy. Zapisywany jest tylko rodzaj zdarzenia i nazwa narzędzia, przez 90 dni, na tym iPhonie, i nigdy nie jest to wysyłane."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O Doddy conta quantas vezes você desfaz algo, altera um passo, diz “Está errado”, pede a mesma coisa de novo ou deixa um cartão sem resposta, para você ver se ele está melhorando. Só o tipo de evento e o nome da ferramenta são guardados, por 90 dias, neste iPad, e nunca enviados."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O Doddy conta quantas vezes você desfaz algo, altera um passo, diz “Está errado”, pede a mesma coisa de novo ou deixa um cartão sem resposta, para você ver se ele está melhorando. Só o tipo de evento e o nome da ferramenta são guardados, por 90 dias, neste iPhone, e nunca enviados."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Doddy 会统计你撤销操作、更改步骤、说“不对”、重复提出同一请求或不回应卡片的次数，让你能看到他是否有进步。只保留事件类型和工具名称，存 90 天，仅在这台 iPad 上，绝不发送。"
