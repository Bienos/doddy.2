            "state": "translated",
            "value": "Dodaj %lld do listy"
          }
        }
      }
    },
    "Add a preference": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj preferencję"
          }
