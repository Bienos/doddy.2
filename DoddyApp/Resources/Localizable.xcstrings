    "First verify your phone number, so Doddy knows it's you calling.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige zuerst deine Telefonnummer, damit Doddy weiß, dass du anrufst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero verifica tu número de teléfono, para que Doddy sepa que eres tú quien llama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie d’abord ton numéro de téléphone, pour que Doddy sache que c’est toi qui appelles."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo potvrdi svoj broj telefona, da Doddy zna da ti zoveš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima verifica il tuo numero di telefono, così Doddy sa che sei tu a chiamare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず電話番号を確認して、かけてきたのがあなただとDoddyにわかるようにします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zweryfikuj numer telefonu, żeby Doddy wiedział, że to Ty dzwonisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro verifique seu número de telefone, para o Doddy saber que é você ligando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先验证你的手机号码，这样 Doddy 才知道是你打来的。"
          }
        }
      }
    },
    "Five cards are waiting already. Use or cancel one first.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pięć kart już czeka. Najpierw użyj albo anuluj którąś."
          }
        }
      }
    },
    "Fix the name if Doddy misheard. Nothing is made until you tap Create list.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiere den Namen, falls Doddy sich verhört hat. Nichts wird erstellt, bis du auf „Liste erstellen“ tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige el nombre si Doddy oyó mal. No se crea nada hasta que toques Crear lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige le nom si Doddy a mal entendu. Rien n’est créé tant que tu ne touches pas Créer la liste."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispravi naziv ako je Doddy krivo čuo. Ništa se ne stvara dok ne dodirneš Stvori popis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Correggi il nome se Doddy ha capito male. Niente viene creato finché non tocchi Crea lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyが聞き間違えていたら名前を直してください。「リストを作成」をタップするまで、何も作られません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popraw nazwę, jeśli Doddy źle usłyszał. Nic nie powstanie, dopóki nie stukniesz Utwórz listę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija o nome se o Doddy ouviu errado. Nada é criado até você tocar em Criar lista."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Doddy 听错了，请改一下名称。在你轻点“创建清单”之前，不会创建任何内容。"
          }
        }
      }
    },
