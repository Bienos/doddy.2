    "How the island looks while you talk to Doddy from another app. These are previews, not a running conversation.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So sieht die Island aus, während du aus einer anderen App mit Doddy redest. Das sind Vorschauen, kein laufendes Gespräch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se ve la isla mientras hablas con Doddy desde otra app. Son vistas previas, no una conversación en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aspect de l’île quand tu parles à Doddy depuis une autre app. Ce sont des aperçus, pas une conversation en cours."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako otok izgleda dok razgovaraš s Doddyjem iz druge aplikacije. Ovo su pregledi, ne razgovor u tijeku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come appare l'isola mentre parli con Doddy da un'altra app. Sono anteprime, non una conversazione in corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリからDoddyと話しているときのアイランドの見え方です。これはプレビューで、実際の会話ではありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak wygląda wyspa, gdy rozmawiasz z Doddym z innej aplikacji. To podglądy, a nie trwająca rozmowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como a ilha fica enquanto você fala com o Doddy a partir de outro app. São prévias, não uma conversa em andamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你在其他应用中和 Doddy 聊天时，灵动岛的样子。这些是预览，不是正在进行的对话。"
          }
        }
      }
    },
