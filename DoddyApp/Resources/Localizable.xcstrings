    "What you asked for that Doddy has no way to do, as a topic only. This stays on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du verlangt hast und Doddy nicht tun kann, nur als Thema. Das bleibt auf deinem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que pediste y Doddy no tiene forma de hacer, solo como tema. Esto se queda en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu as demandé et que Doddy n’a aucun moyen de faire, comme sujet seulement. Ça reste sur ton iPhone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtjevi koje Doddy nikako ne može ispuniti, samo kao tema. Ostaje na tvom iPhoneu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che hai chiesto e che Doddy non ha modo di fare, solo come argomento. Resta sul tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが頼んだけれどDoddyにはできないことを、トピックとしてだけ記録したものです。これはiPhoneにとどまります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rzeczy, o które poproszono, a których Doddy nie potrafi zrobić, tylko jako temat. Zostaje to na Twoim iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você pediu e o Doddy não tem como fazer, só como tópico. Isto fica no seu iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你请求过但 Doddy 无法做到的事，只记录主题。这只留在你的 iPhone 上。"
          }
        }
      }
    },
