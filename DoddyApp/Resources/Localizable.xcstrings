            "value": "Najstarije prvo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più vecchi prima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い順"
          }
        },
        "pl": {
