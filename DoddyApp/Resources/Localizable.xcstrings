        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte nicht verschriftlicht werden. Die Aufnahme ist noch da; tippe ein paar Wörter ein, damit du die Notiz später findest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido transcribir. La grabación sigue aquí; escribe unas palabras para poder encontrar la nota más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de le transcrire. L’enregistrement est toujours là ; tape quelques mots pour retrouver la note plus tard."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije bilo moguće pretvoriti u tekst. Snimka je još ovdje; upiši nekoliko riječi da bilješku poslije možeš pronaći."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile trascriverlo. La registrazione è ancora qui; scrivi qualche parola così potrai ritrovare la nota più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字に書き起こせませんでした。録音はまだここにあります。後でメモを見つけられるよう、いくつか言葉を入力してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać tego jako tekst. Nagranie wciąż tu jest; wpisz kilka słów, żeby łatwo znaleźć notatkę później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível transcrever. A gravação ainda está aqui; digite algumas palavras para encontrar a nota depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法转写成文字。录音仍然在这里；输入几个词，方便你以后找到这条笔记。"
          }
        }
      }
    },
    "It didn't work, show me the steps": {
