    },
    "That doesn't look like a phone number. Include the country code, like +48 500 100 200.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht nach einer Telefonnummer aus. Gib die Ländervorwahl mit an, etwa +49 151 1234567."
          }
        },
        "es": {
