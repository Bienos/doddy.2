    "This file isn't plain text Doddy can read.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist kein reiner Text, den Doddy lesen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no es texto sin formato que Doddy pueda leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’est pas du texte brut que Doddy peut lire."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova datoteka nije običan tekst koji Doddy može pročitati."
