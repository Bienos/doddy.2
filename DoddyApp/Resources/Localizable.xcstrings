      }
    },
    "Untick anything you don't want, or tap Change to fix a step. In a conversation, the rest run in this order.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odznacz, czego nie chcesz, albo stuknij Zmień, aby poprawić krok. W rozmowie reszta wykona się w tej kolejności."
          }
        }
      }
    },
    "Untick anything you don't want, or tap Change to fix a step. The rest run in this order, and each one gets its own result.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odznacz, czego nie chcesz, albo stuknij Zmień, aby poprawić krok. Reszta wykona się w tej kolejności, a każdy krok dostanie własny wynik."
          }
        }
      }
    },
    "Up to 5 minutes. Doddy writes it out on this iPhone; the recording is never sent anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do 5 minut. Doddy zapisuje ją jako tekst na tym iPhonie; nagranie nigdy nie jest nigdzie wysyłane."
          }
        }
      }
    },
    "Updates as notifications": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości jako powiadomienia"
          }
        }
      }
    },
    "Updates by text message": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości SMS-em"
          }
        }
      }
    },
    "Updates need a Doddy messaging server, and none is connected in this build yet. Nothing is sent anywhere until one is.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualności wymagają serwera wiadomości Doddy’ego, a w tej wersji żaden nie jest jeszcze podłączony. Nic nie jest nigdzie wysyłane, dopóki nie będzie."
          }
        }
      }
    },
    "Use 6 to 8 digits that are harder to guess: not one repeated digit or a run like 123456.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj od 6 do 8 cyfr, trudniejszych do zgadnięcia: nie jednej powtarzanej cyfry ani ciągu w rodzaju 123456."
          }
        }
      }
    },
    "Use Doddy's own voice": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj własnego głosu Doddy’ego"
          }
        }
      }
    },
    "Use a different number": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj innego numeru"
          }
        }
      }
    },
    "Use an https address with no path, like https://doddy-messaging.onrender.com.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj adresu https bez ścieżki, np. https://doddy-messaging.onrender.com."
          }
        }
      }
    },
    "Use in voice conversations": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj w rozmowach głosowych"
