            "value": "Pozycje"
          }
        }
      }
    },
    "Its words were added below, written out on this iPhone. Speech-to-text makes mistakes, so check it before saving.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa zostały dodane poniżej, zapisane jako tekst na tym iPhonie. Zamiana mowy na tekst popełnia błędy, więc sprawdź je przed zapisaniem."
          }
        }
      }
    },
    "Keep Precise Location on, or iOS can't tell when you get there.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaw włączone Dokładne położenie, inaczej iOS nie rozpozna, kiedy tam dotrzesz."
