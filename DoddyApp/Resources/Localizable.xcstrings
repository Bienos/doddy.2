    "What would make me useful in your day?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was würde mich in deinem Alltag nützlich machen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué me haría útil en tu día a día?"
          }
        },
        "fr": {
