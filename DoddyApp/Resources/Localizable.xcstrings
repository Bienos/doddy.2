    "Saving now stores nothing and removes anything saved before.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt speichern behält nichts und entfernt alles zuvor Gespeicherte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar ahora no almacena nada y elimina lo que se guardó antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer maintenant ne stocke rien et retire tout ce qui avait été enregistré avant."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremanje sad ne pohranjuje ništa i uklanja sve što je prije spremljeno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvando ora non viene conservato niente e viene rimosso tutto ciò che era salvato prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今保存すると何も保存されず、以前に保存したものも削除されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisanie teraz niczego nie zachowa i usunie wszystko, co było zapisane wcześniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar agora não armazena nada e remove qualquer coisa salva antes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在保存不会存储任何内容，并会移除之前保存的内容。"
          }
        }
      }
    },
    "Saving replaces the words Doddy uses. Earlier wordings are kept in its history.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern ersetzt die Wörter, die Doddy verwendet. Frühere Fassungen bleiben im Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar sustituye las palabras que usa Doddy. Las redacciones anteriores se conservan en su historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer remplace les mots que Doddy utilise. Les formulations précédentes sont gardées dans son historique."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremanje zamjenjuje riječi koje Doddy koristi. Ranije formulacije ostaju u njegovoj povijesti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvando sostituisci le parole che usa Doddy. Le formulazioni precedenti restano nella sua cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると、Doddyが使う言葉が置き換わります。以前の表現は履歴に残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisanie zastępuje słowa, których używa Doddy. Wcześniejsze wersje zostają w historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar substitui as palavras que o Doddy usa. As versões anteriores ficam no histórico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存会替换 Doddy 使用的措辞。之前的措辞保留在历史记录中。"
          }
        }
      }
    },
