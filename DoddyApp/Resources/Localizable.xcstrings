            "state": "translated",
            "value": "Doddy potrzebuje pozwolenia, żeby Ci przypominać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy precisa de permissão para lembrar você"
