    "It hasn't been saved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurde nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle n’a pas été enregistrée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije spremljena."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stata salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ保存されていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie została zapisana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi salva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它还没有保存。"
          }
        }
      }
    },
    "It hasn't been saved. Keep it for later and it opens the next time you start a new note; a photo or recording isn't kept with it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurde nicht gespeichert. Behalte sie für später, dann öffnet sie sich, wenn du das nächste Mal eine neue Notiz beginnst; ein Foto oder eine Aufnahme wird nicht mit ihr behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha guardado. Consérvala para luego y se abrirá la próxima vez que empieces una nota nueva; una foto o grabación no se conserva con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle n’a pas été enregistrée. Garde-la pour plus tard et elle s’ouvrira la prochaine fois que tu commenceras une nouvelle note ; une photo ou un enregistrement n’est pas conservé avec elle."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije spremljena. Zadrži je za poslije i otvorit će se sljedeći put kad počneš novu bilješku; fotografija ili snimka ne čuva se s njom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stata salvata. Conservala per dopo e si apre la prossima volta che inizi una nuova nota; una foto o una registrazione non viene conservata con lei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ保存されていません。「後で」にしておくと、次に新しいメモを始めたときに開きます。写真や録音は一緒には残りません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie została zapisana. Zachowaj ją na później, a otworzy się, gdy następnym razem zaczniesz nową notatkę; zdjęcie ani nagranie nie są z nią zachowywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi salva. Guarde para depois e ela abre na próxima vez que você começar uma nota nova; uma foto ou gravação não é guardada com ela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它还没有保存。选择“留到以后”，下次你开始新笔记时它会打开；照片或录音不会随它一起保留。"
          }
        }
      }
    },
