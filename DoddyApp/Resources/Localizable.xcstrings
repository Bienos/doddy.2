    "This removes every fact, routine and count of corrections from this iPhone. Your notes aren't touched. Exported files and older backups aren't affected.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Das entfernt jeden Fakt, jede Routine und jeden Korrekturzähler von diesem iPad. Deine Notizen bleiben unberührt. Exportierte Dateien und ältere Backups sind nicht betroffen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Das entfernt jeden Fakt, jede Routine und jeden Korrekturzähler von diesem iPhone. Deine Notizen bleiben unberührt. Exportierte Dateien und ältere Backups sind nicht betroffen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This removes every fact, routine and count of corrections from this iPad. Your notes aren't touched. Exported files and older backups aren't affected."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This removes every fact, routine and count of corrections from this iPhone. Your notes aren't touched. Exported files and older backups aren't affected."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Esto elimina todos los datos, rutinas y recuentos de correcciones de este iPad. Tus notas no se tocan. Los archivos exportados y las copias de seguridad anteriores no se ven afectados."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Esto elimina todos los datos, rutinas y recuentos de correcciones de este iPhone. Tus notas no se tocan. Los archivos exportados y las copias de seguridad anteriores no se ven afectados."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ceci retire de cet iPad chaque fait, chaque routine et chaque compteur de corrections. Tes notes ne sont pas touchées. Les fichiers exportés et les sauvegardes plus anciennes ne sont pas concernés."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ceci retire de cet iPhone chaque fait, chaque routine et chaque compteur de corrections. Tes notes ne sont pas touchées. Les fichiers exportés et les sauvegardes plus anciennes ne sont pas concernés."
                }
              }
            }
          }
        },
        "hr": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ovo uklanja svaku činjenicu, rutinu i brojač ispravaka s ovog iPada. Tvoje bilješke se ne diraju. Izvezene datoteke i starije sigurnosne kopije nisu zahvaćene."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ovo uklanja svaku činjenicu, rutinu i brojač ispravaka s ovog iPhonea. Tvoje bilješke se ne diraju. Izvezene datoteke i starije sigurnosne kopije nisu zahvaćene."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Questo rimuove da questo iPad ogni fatto, routine e conteggio delle correzioni. Le tue note non vengono toccate. I file esportati e i backup precedenti non vengono toccati."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Questo rimuove da questo iPhone ogni fatto, routine e conteggio delle correzioni. Le tue note non vengono toccate. I file esportati e i backup precedenti non vengono toccati."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "このiPadから、すべての事実、ルーティン、訂正の回数を削除します。メモには手を付けません。書き出したファイルや古いバックアップには影響しません。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "このiPhoneから、すべての事実、ルーティン、訂正の回数を削除します。メモには手を付けません。書き出したファイルや古いバックアップには影響しません。"
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To usuwa z tego iPada wszystkie fakty, rutyny i liczniki poprawek. Twoje notatki zostają. Wyeksportowane pliki i starsze kopie zapasowe pozostają bez zmian."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To usuwa z tego iPhone’a wszystkie fakty, rutyny i liczniki poprawek. Twoje notatki zostają. Wyeksportowane pliki i starsze kopie zapasowe pozostają bez zmian."
                }
