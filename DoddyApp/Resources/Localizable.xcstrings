    "Kept in Doddy on this iPhone and in your iPhone backups. Photos and voice memos aren't in exports; an encrypted backup can include them. Deleting here doesn't remove files you exported or older backups.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kept in Doddy on this iPad and in your iPad backups. Photos and voice memos aren't in exports; an encrypted backup can include them. Deleting here doesn't remove files you exported or older backups."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kept in Doddy on this iPhone and in your iPhone backups. Photos and voice memos aren't in exports; an encrypted backup can include them. Deleting here doesn't remove files you exported or older backups."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Przechowywane w Doddym na tym iPadzie i w kopiach zapasowych iPada. Zdjęcia i notatki głosowe nie trafiają do eksportu; może je zawierać zaszyfrowana kopia zapasowa. Usunięcie tutaj nie kasuje wyeksportowanych plików ani starszych kopii."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Przechowywane w Doddym na tym iPhonie i w kopiach zapasowych iPhone’a. Zdjęcia i notatki głosowe nie trafiają do eksportu; może je zawierać zaszyfrowana kopia zapasowa. Usunięcie tutaj nie kasuje wyeksportowanych plików ani starszych kopii."
                }
              }
            }
          }
        }
      }
    },
