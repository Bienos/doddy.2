    "I won't fill in the gaps. Try a distinctive word from the note.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich fülle keine Lücken. Versuch es mit einem markanten Wort aus der Notiz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No voy a rellenar los huecos. Prueba con una palabra distintiva de la nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne vais pas combler les trous. Essaie un mot distinctif de la note."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neću nagađati praznine. Pokušaj s prepoznatljivom riječi iz bilješke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non invento quello che manca. Prova una parola distintiva della nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推測で埋めることはしません。メモにある特徴的な言葉で試してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie będę zgadywać. Spróbuj charakterystycznego słowa z notatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu não vou preencher as lacunas. Tente uma palavra marcante da nota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我不会凭空补全。试试笔记里一个有特点的词。"
          }
        }
      }
    },
