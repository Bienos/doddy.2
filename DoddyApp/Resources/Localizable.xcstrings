    "Your phone was rung twice already. Doddy carries on with the call.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój telefon dzwonił już dwa razy. Doddy kontynuuje rozmowę."
          }
        }
      }
    },
    "Your photos": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zdjęcia"
          }
        }
      }
    },
    "Your preferences changed somewhere else while you were editing. Nothing was saved; your edits are still here. Check them and save again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Vorlieben wurden woanders geändert, während du bearbeitet hast. Nichts wurde gespeichert; deine Änderungen sind noch hier. Prüfe sie und speichere noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus preferencias cambiaron en otro sitio mientras editabas. No se ha guardado nada; tus cambios siguen aquí. Revísalos y guarda de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes préférences ont été modifiées ailleurs pendant que tu les éditais. Rien n’a été enregistré ; tes modifications sont toujours là. Vérifie-les et enregistre à nouveau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje preferencije promijenjene su negdje drugdje tijekom uređivanja. Ništa nije spremljeno; tvoje izmjene su još ovdje. Provjeri ih i ponovno spremi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue preferenze sono cambiate altrove mentre le modificavi. Niente è stato salvato; le tue modifiche sono ancora qui. Controllale e salva di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中に、好みの設定が別の場所で変更されました。何も保存されていません。編集内容はまだここにあります。確認して、もう一度保存してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje ustawienia zmieniły się gdzieś indziej w trakcie edycji. Nic nie zostało zapisane; Twoje zmiany wciąż tu są. Sprawdź je i zapisz ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas preferências mudaram em outro lugar enquanto você editava. Nada foi salvo; suas edições ainda estão aqui. Confira e salve de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你编辑期间，偏好在别处被更改了。没有保存任何内容；你的编辑还在这里。请检查后再次保存。"
          }
        }
      }
    },
    "Your presentation is ready": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja prezentacja jest gotowa"
          }
        }
      }
    },
    "Your question": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje pytanie"
          }
        }
      }
    },
    "Your question is still in the box. Your saved notes are not affected.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Frage steht noch im Feld. Deine gespeicherten Notizen sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pregunta sigue en el cuadro. Tus notas guardadas no se ven afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta question est toujours dans le champ. Tes notes enregistrées ne sont pas affectées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje pitanje još je u polju. Tvoje spremljene bilješke nisu zahvaćene."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua domanda è ancora nel campo. Le tue note salvate non vengono toccate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問は入力欄に残っています。保存したメモには影響ありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje pytanie wciąż jest w polu. Zapisane notatki pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua pergunta ainda está na caixa. Suas notas salvas não são afetadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的问题还在输入框里。你保存的笔记不受影响。"
          }
        }
      }
    },
    "Your shortcut reached Doddy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kurzbefehl hat Doddy erreicht"
          }
        },
        "es": {
