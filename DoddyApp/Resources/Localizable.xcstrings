    "Speech recognition is off for Doddy, so nothing was written out. You can turn it on in the Settings app, or type a few words.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracherkennung ist für Doddy aus, also wurde nichts verschriftlicht. Du kannst sie in der App Einstellungen einschalten oder ein paar Wörter tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz está desactivado para Doddy, así que no se ha transcrito nada. Puedes activarlo en la app Ajustes, o escribir unas palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est désactivée pour Doddy, donc rien n’a été transcrit. Tu peux l’activer dans l’app Réglages, ou taper quelques mots."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje govora isključeno je za Doddyja, pa ništa nije pretvoreno u tekst. Možeš ga uključiti u aplikaciji Postavke ili upisati nekoliko riječi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale è disattivato per Doddy, quindi niente è stato trascritto. Puoi attivarlo nell'app Impostazioni, oppure scrivere qualche parola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyの音声認識がオフになっているため、文字に書き起こせませんでした。設定アプリでオンにするか、いくつか言葉を入力してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie mowy jest wyłączone dla Doddy’ego, więc nic nie zostało zapisane jako tekst. Możesz je włączyć w aplikacji Ustawienia albo wpisać kilka słów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está desativado para o Doddy, então nada foi transcrito. Você pode ativar no app Ajustes, ou digitar algumas palavras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 的语音识别已关闭，所以没有转写任何内容。你可以在“设置”应用中开启，或者输入几个词。"
          }
        }
      }
    },
