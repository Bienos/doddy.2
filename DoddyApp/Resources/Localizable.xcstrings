      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowane"
          }
        }
      }
    },
    "Both voices go to OpenAI, or ElevenLabs if you switch Home's voice to it to be translated. Your notes, conversations and profile aren't sent. Nothing is kept on this iPhone unless you tap Copy or Save at the end. Not for emergencies: call 112.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Both voices go to OpenAI, or ElevenLabs if you switch Home's voice to it to be translated. Your notes, conversations and profile aren't sent. Nothing is kept on this iPad unless you tap Copy or Save at the end. Not for emergencies: call 112."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Both voices go to OpenAI, or ElevenLabs if you switch Home's voice to it to be translated. Your notes, conversations and profile aren't sent. Nothing is kept on this iPhone unless you tap Copy or Save at the end. Not for emergencies: call 112."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Oba głosy trafiają do OpenAI albo ElevenLabs, jeśli przełączysz na niego głos na ekranie głównym do tłumaczenia. Twoje notatki, rozmowy i profil nie są wysyłane. Nic nie zostaje na tym iPadzie, chyba że na końcu stukniesz Kopiuj lub Zapisz. Nie w nagłych wypadkach: dzwoń pod 112."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Oba głosy trafiają do OpenAI albo ElevenLabs, jeśli przełączysz na niego głos na ekranie głównym do tłumaczenia. Twoje notatki, rozmowy i profil nie są wysyłane. Nic nie zostaje na tym iPhonie, chyba że na końcu stukniesz Kopiuj lub Zapisz. Nie w nagłych wypadkach: dzwoń pod 112."
                }
              }
            }
          }
        }
      }
    },
    "Breathe": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddychaj"
          }
        }
      }
    },
    "Breathe in for 4 seconds, out for 6. Follow the words and the tide.": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wdech przez 4 sekundy, wydech przez 6. Podążaj za słowami i falą."
          }
        }
      }
    },
