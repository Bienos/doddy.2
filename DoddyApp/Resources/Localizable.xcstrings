    "iCloud didn't confirm it. Nothing is counted as done; try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud hat es nicht bestätigt. Nichts zählt als erledigt; versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no lo ha confirmado. Nada cuenta como hecho; inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ne l’a pas confirmé. Rien n’est compté comme fait ; réessaie."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud to nije potvrdio. Ništa se ne računa kao obavljeno; pokušaj ponovno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non l'ha confermato. Niente viene contato come fatto; riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudが確認しませんでした。何も完了とは扱われていません。もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud tego nie potwierdził. Nic nie jest uznane za zrobione; spróbuj jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud não confirmou. Nada conta como concluído; tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 未确认。不算已完成；请重试。"
          }
        }
      }
    },
