{
  "sourceLanguage": "en",
  "strings": {
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy sets an alarm only when you ask and tap Set alarm. Its alarms ring even in Silent mode or a Focus. Turn them off in Doddy's Settings, Alarms."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy ustawia budzik tylko wtedy, gdy o to poprosisz i stukniesz Ustaw budzik. Jego budziki dzwonią nawet w trybie cichym i przy włączonym skupieniu. Wyłączysz je w Ustawieniach Doddy'ego, w sekcji Budziki."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy reads your events for the days you ask about, and adds, changes or deletes an event only after you tap Add, Change or Delete. Turn this off in Settings, Connections."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy czyta Twoje wydarzenia z dni, o które pytasz, a dodaje, zmienia lub usuwa wydarzenie tylko po stuknięciu Dodaj, Zmień lub Usuń. Wyłączysz to w Ustawieniach, w sekcji Połączenia."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy looks up a contact by name when you ask. The details stay on your screen. Turn this off in Settings, Connections."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy wyszukuje kontakt po imieniu, gdy o to poprosisz. Szczegóły zostają na Twoim ekranie. Wyłączysz to w Ustawieniach, w sekcji Połączenia."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy uses your location only for reminders you set at a place: to find where you are when you tap Use where I am now, and so iOS can remind you when you arrive or leave. Doddy doesn't track where you go."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy używa Twojej lokalizacji tylko do przypomnień ustawionych w danym miejscu: żeby ustalić, gdzie jesteś, gdy stukniesz Użyj mojej obecnej lokalizacji, i żeby iOS mógł Ci przypomnieć, gdy tam dotrzesz albo stamtąd wyjdziesz. Doddy nie śledzi, dokąd chodzisz."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy listens while you are talking to him: after you tap Talk to Doddy, or as soon as you open Doddy if you turned that on in Settings. If you turn on Hey Doddy, the microphone also listens on this iPhone for the wake word; that sound isn't kept or sent. Your voice in a conversation is sent to ElevenLabs to run it. A voice memo you record on a note stays on this iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy słucha, gdy z nim rozmawiasz: po stuknięciu Porozmawiaj z Doddym albo od razu po otwarciu aplikacji, jeśli włączysz to w Ustawieniach. Jeśli włączysz Hej Doddy, mikrofon słucha też na tym iPhonie słowa wywołującego; ten dźwięk nie jest zapisywany ani wysyłany. Twój głos w rozmowie jest wysyłany do ElevenLabs, żeby ją prowadzić. Notatka głosowa, którą nagrasz przy notatce, zostaje na tym iPhonie."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy adds, changes, completes or deletes a reminder only after you tap Add, Change, Mark done or Delete. Turn this off in Settings, Connections."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy dodaje, zmienia, kończy lub usuwa przypomnienie tylko po stuknięciu Dodaj, Zmień, Oznacz jako zrobione lub Usuń. Wyłączysz to w Ustawieniach, w sekcji Połączenia."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy writes out a voice memo on this iPhone when you record one, so you can check its words before saving. The recording and its words are not sent anywhere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy zapisuje notatkę głosową jako tekst na tym iPhonie, gdy ją nagrywasz, żeby można było sprawdzić słowa przed zapisaniem. Nagranie i jego słowa nie są nigdzie wysyłane."
          }
        }
      }
    }
  },
  "version": "1.0"
}
