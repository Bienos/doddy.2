{
  "sourceLanguage": "en",
  "strings": {
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy stellt einen Wecker oder Timer nur, wenn du darum bittest und auf Wecker stellen oder Starten tippst. Sie klingeln auch im Lautlos-Modus oder in einem Fokus. Wecker schaltest du in den Doddy-Einstellungen unter Wecker aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy sets an alarm or a timer only when you ask and tap Set alarm or Start. They ring even in Silent mode or a Focus. Turn alarms off in Doddy's Settings, Alarms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy pone una alarma o un temporizador solo cuando se lo pides y tocas Poner alarma o Empezar. Suenan incluso en modo Silencio o en un modo de concentración. Desactiva las alarmas en los Ajustes de Doddy, Alarmas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy ne règle une alarme ou un minuteur que si tu le demandes et touches Régler l’alarme ou Commencer. Ils sonnent même en mode Silence ou en mode Concentration. Désactive les alarmes dans les Réglages de Doddy, Alarmes."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy postavlja alarm ili mjerač vremena samo kad to zatražiš i dodirneš Postavi alarm ili Počni. Zvone čak i u tihom načinu ili tijekom Fokusa. Alarme isključi u Doddyjevim Postavkama, Alarmi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy imposta una sveglia o un timer solo quando lo chiedi e tocchi Imposta sveglia o Inizia. Suonano anche in modalità Silenzioso o con una Full Immersion attiva. Disattiva le sveglie nelle Impostazioni di Doddy, Sveglie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyがアラームやタイマーを設定するのは、あなたが頼んで「アラームを設定」または「開始」をタップしたときだけです。消音モードや集中モード中でも鳴ります。アラームをオフにするには、Doddyの設定の「アラーム」を使ってください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy ustawia budzik albo minutnik tylko wtedy, gdy o to poprosisz i stukniesz Ustaw budzik albo Zacznij. Dzwonią nawet w trybie cichym i przy włączonym skupieniu. Budziki wyłączysz w Ustawieniach Doddy'ego, w sekcji Budziki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy só define um alarme ou um timer quando você pede e toca em Definir alarme ou Começar. Eles tocam mesmo no modo Silencioso ou em um Foco. Desative os alarmes nos Ajustes do Doddy, em Alarmes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你提出请求并轻点“设置闹钟”或“开始”时，Doddy 才会设置闹钟或计时器。它们在静音模式或专注模式下也会响。可在 Doddy 设置的“闹钟”中关闭闹钟。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy liest deine Termine für die Tage, nach denen du fragst, und fügt einen Termin erst hinzu, ändert oder löscht ihn erst, nachdem du auf Hinzufügen, Ändern oder Löschen getippt hast. Schalte das unter Einstellungen, Verbindungen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy reads your events for the days you ask about, and adds, changes or deletes an event only after you tap Add, Change or Delete. Turn this off in Settings, Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy lee tus eventos de los días por los que preguntas, y añade, cambia o elimina un evento solo después de que toques Añadir, Cambiar o Eliminar. Desactívalo en Ajustes, Conexiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy lit tes événements pour les jours dont tu parles, et n’ajoute, ne modifie ou ne supprime un événement qu’après que tu as touché Ajouter, Modifier ou Supprimer. Désactive ceci dans Réglages, Connexions."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy čita tvoje događaje za dane o kojima pitaš, a dodaje, mijenja ili briše događaj tek nakon što dodirneš Dodaj, Promijeni ili Izbriši. Isključi to u Postavkama, Veze."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy legge i tuoi eventi per i giorni di cui chiedi, e aggiunge, modifica o elimina un evento solo dopo che tocchi Aggiungi, Modifica o Elimina. Disattivalo in Impostazioni, Collegamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyは、あなたが尋ねた日のイベントを読み、イベントの追加・変更・削除は「追加」「変更」「削除」をタップした後にだけ行います。オフにするには、設定の「連携」を使ってください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy czyta Twoje wydarzenia z dni, o które pytasz, a dodaje, zmienia lub usuwa wydarzenie tylko po stuknięciu Dodaj, Zmień lub Usuń. Wyłączysz to w Ustawieniach, w sekcji Połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy lê seus eventos dos dias sobre os quais você pergunta, e só adiciona, altera ou apaga um evento depois que você toca em Adicionar, Alterar ou Apagar. Desative em Ajustes, Conexões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 会读取你询问的那些日子的日程，并且只有在你轻点“添加”、“更改”或“删除”后才会添加、更改或删除日程。可在设置的“连接”中关闭。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy öffnet die Kamera nur, wenn du auf „Foto aufnehmen“, „Kamera öffnen“ oder „Barcode scannen“ tippst. Ein Foto für eine Notiz bleibt in dieser Notiz auf diesem iPhone, und sein Text wird hier gelesen. Bei einem Barcode geht nur seine Nummer an Open Food Facts, und das Foto wird nicht behalten. Ein Foto, das du aufnimmst, um Doddy danach zu fragen, geht, wenn du in „Nachrichten“ auf „Senden“ tippst, an Doddys Server und an Claude von Anthropic, der die Antwort schreibt; weder Doddys Server noch dieses iPhone behält es. Doddy speichert nie ein Foto in deiner Fotomediathek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy opens the camera only when you tap Take a photo, Open camera or Scan a barcode. A photo for a note stays in that note on this iPhone, and its text is read here. For a barcode, only its number goes to Open Food Facts, and the photo isn't kept. A photo you take to ask Doddy about goes, when you tap Send in Messages, to Doddy's server and Anthropic's Claude for the answer; neither Doddy's server nor this iPhone keeps it. Doddy never saves a photo to your photo library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy abre la cámara solo cuando tocas Hacer una foto, Abrir cámara o Escanear un código de barras. Una foto para una nota se queda en esa nota en este iPhone y su texto se lee aquí. De un código de barras, solo su número va a Open Food Facts, y la foto no se guarda. Una foto que haces para preguntarle a Doddy va, cuando tocas Enviar en Mensajes, al servidor de Doddy y a Claude, de Anthropic, que escribe la respuesta; ni el servidor de Doddy ni este iPhone la guardan. Doddy nunca guarda una foto en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy ouvre l’appareil photo seulement quand tu touches Prendre une photo, Ouvrir l’appareil photo ou Scanner un code-barres. Une photo pour une note reste dans cette note sur cet iPhone, et son texte est lu ici. Pour un code-barres, seul son numéro va à Open Food Facts, et la photo n’est pas gardée. Une photo que tu prends pour interroger Doddy part, quand tu touches Envoyer dans Messages, vers le serveur de Doddy et Claude d’Anthropic, qui écrit la réponse ; ni le serveur de Doddy ni cet iPhone ne la gardent. Doddy n’enregistre jamais de photo dans ta photothèque."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy otvara kameru samo kad dodirneš Snimi fotografiju, Otvori kameru ili Skeniraj crtični kod. Fotografija za bilješku ostaje u toj bilješci na ovom iPhoneu, a njezin se tekst čita ovdje. Od crtičnog koda u Open Food Facts ide samo njegov broj, a fotografija se ne čuva. Fotografija koju snimiš da bi pitao Doddyja o njoj ide, kad dodirneš Pošalji u Porukama, na Doddyjev poslužitelj i Claudeu tvrtke Anthropic, koji piše odgovor; ne čuva je ni Doddyjev poslužitelj ni ovaj iPhone. Doddy nikad ne sprema fotografije u tvoju knjižnicu fotografija."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy apre la fotocamera solo quando tocchi Scatta una foto, Apri fotocamera o Scansiona un codice a barre. Una foto per una nota resta in quella nota su questo iPhone e il suo testo viene letto qui. Di un codice a barre, solo il numero va a Open Food Facts, e la foto non viene conservata. Una foto che scatti per chiedere a Doddy va, quando tocchi Invia in Messaggi, al server di Doddy e a Claude di Anthropic, che scrive la risposta; né il server di Doddy né questo iPhone la conservano. Doddy non salva mai una foto nella tua libreria foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyがカメラを開くのは、「写真を撮る」「カメラを開く」「バーコードをスキャン」をタップしたときだけです。メモ用の写真はこのiPhone上のそのメモに残り、その文字はここで読み取られます。バーコードの場合、Open Food Factsに送られるのは番号だけで、写真は保存されません。Doddyに尋ねるために撮った写真は、「メッセージ」で「送信」をタップすると、Doddyのサーバーと、回答を書くAnthropicのClaudeに送られます。Doddyのサーバーもこの iPhoneも、その写真を保存しません。Doddyが写真ライブラリに写真を保存することはありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy otwiera aparat tylko wtedy, gdy stukniesz Zrób zdjęcie, Otwórz aparat albo Zeskanuj kod kreskowy. Zdjęcie do notatki zostaje w tej notatce na tym iPhonie, a jego tekst jest odczytywany tutaj. Przy kodzie kreskowym do Open Food Facts trafia tylko jego numer, a zdjęcie nie jest zachowywane. Zdjęcie zrobione po to, żeby zapytać o nie Doddy'ego, trafia po stuknięciu Wyślij w Wiadomościach na serwer Doddy'ego i do Claude (Anthropic), który pisze odpowiedź; nie przechowuje go ani serwer Doddy'ego, ani ten iPhone. Doddy nigdy nie zapisuje zdjęć w Twojej bibliotece zdjęć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy abre a câmera só quando você toca em Tirar foto, Abrir câmera ou Escanear código de barras. Uma foto para uma nota fica nessa nota neste iPhone e o texto dela é lido aqui. De um código de barras, só o número vai para o Open Food Facts, e a foto não é guardada. Uma foto que você tira para perguntar ao Doddy vai, quando você toca em Enviar em Mensagens, para o servidor do Doddy e para o Claude, da Anthropic, que escreve a resposta; nem o servidor do Doddy nem este iPhone a guardam. O Doddy nunca salva uma foto na sua fototeca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你轻点“拍照”、“打开相机”或“扫描条形码”时，Doddy 才会打开相机。用于笔记的照片会保留在这台 iPhone 上的那条笔记中，其中的文字在这里读取。扫描条形码时，只有条形码号码会发送给 Open Food Facts，照片不会被保留。你为了问 Doddy 而拍的照片，在你于“信息”中轻点“发送”后，会发送到 Doddy 的服务器和撰写回答的 Anthropic 的 Claude；Doddy 的服务器和这台 iPhone 都不会保留它。Doddy 绝不会把照片存入你的照片图库。"
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy sucht einen Kontakt nach Namen oder schaut, wessen Geburtstag ansteht, wenn du fragst, und liest die Geburtstage der Personen, an die du erinnert werden willst. In einem Sprachgespräch gehen die gefundenen Namen sowie Tag und Monat ihres Geburtstags an ElevenLabs, das die Stimme von Doddy betreibt; Nummern, E-Mail-Adressen und Geburtsjahre bleiben auf diesem iPhone. Schalte das unter Einstellungen, Verbindungen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy looks up a contact by name, or whose birthday is coming up, when you ask, and reads birthdays for the people you pick to be reminded of. In a voice conversation, the names it finds and their birthday's day and month go to ElevenLabs, which runs Doddy's voice; numbers, email addresses and birth years stay on this iPhone. Turn this off in Settings, Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy busca un contacto por su nombre, o de quién es el próximo cumpleaños, cuando se lo pides, y lee los cumpleaños de las personas que eliges para que te los recuerde. En una conversación de voz, los nombres que encuentra y el día y mes de su cumpleaños van a ElevenLabs, que ejecuta la voz de Doddy; los números, las direcciones de correo y los años de nacimiento se quedan en este iPhone. Desactívalo en Ajustes, Conexiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy cherche un contact par son nom, ou dont l’anniversaire approche, quand tu le demandes, et lit les anniversaires des personnes que tu choisis pour te les rappeler. En conversation vocale, les noms qu’il trouve et le jour et le mois de leur anniversaire vont à ElevenLabs, qui fait tourner la voix de Doddy ; les numéros, adresses e-mail et années de naissance restent sur cet iPhone. Désactive ceci dans Réglages, Connexions."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy traži kontakt po imenu, ili čiji rođendan dolazi, kad to zatražiš, i čita rođendane osoba na koje želiš da te podsjeća. U glasovnom razgovoru imena koja pronađe te dan i mjesec njihova rođendana idu u ElevenLabs, koji pokreće Doddyjev glas; brojevi, adrese e-pošte i godine rođenja ostaju na ovom iPhoneu. Isključi to u Postavkama, Veze."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy cerca un contatto per nome, o di chi è il prossimo compleanno, quando lo chiedi, e legge i compleanni delle persone che scegli per ricevere un promemoria. In una conversazione vocale, i nomi che trova e il giorno e il mese del loro compleanno vanno a ElevenLabs, che fa funzionare la voce di Doddy; numeri, indirizzi email e anni di nascita restano su questo iPhone. Disattivalo in Impostazioni, Collegamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyは、あなたが頼んだときに名前で連絡先を探したり、誕生日が近い人を調べたりし、リマインドする相手として選んだ人の誕生日を読み取ります。音声会話では、見つかった名前と誕生日の日と月が、Doddyの声を動かすElevenLabsに送られます。電話番号、メールアドレス、生まれた年はこのiPhoneにとどまります。オフにするには、設定の「連携」を使ってください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy wyszukuje kontakt po imieniu albo sprawdza, czyje urodziny się zbliżają, gdy o to poprosisz, i odczytuje urodziny osób, o których ma Ci przypominać. W rozmowie głosowej znalezione imiona oraz dzień i miesiąc urodzin trafiają do ElevenLabs, które obsługuje głos Doddy'ego; numery, adresy e-mail i lata urodzenia zostają na tym iPhonie. Wyłączysz to w Ustawieniach, w sekcji Połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy procura um contato pelo nome, ou de quem é o próximo aniversário, quando você pede, e lê os aniversários das pessoas que você escolhe para ser lembrado. Em uma conversa por voz, os nomes que ele encontra e o dia e o mês do aniversário vão para a ElevenLabs, que executa a voz do Doddy; números, endereços de e-mail e anos de nascimento ficam neste iPhone. Desative em Ajustes, Conexões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你提出请求时，Doddy 会按姓名查找联系人，或查找谁的生日快到了，并读取你选择要提醒生日的人的生日。在语音对话中，找到的姓名及其生日的日和月会发送给运行 Doddy 语音的 ElevenLabs；电话号码、电子邮件地址和出生年份只保留在这台 iPhone 上。可在设置的“连接”中关闭。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy verwendet Face ID, um die App oder eine private Notiz zu öffnen, wenn du die Sperre einschaltest. iOS prüft dein Gesicht; Doddy erfährt nur, ob es gepasst hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy uses Face ID to open the app or a private note when you turn the lock on. iOS checks your face; Doddy only learns whether it matched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy usa Face ID para abrir la app o una nota privada cuando activas el bloqueo. iOS comprueba tu cara; Doddy solo se entera de si ha coincidido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy utilise Face ID pour ouvrir l’app ou une note privée quand tu actives le verrouillage. iOS vérifie ton visage ; Doddy apprend seulement si ça correspondait."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy koristi Face ID za otvaranje aplikacije ili privatne bilješke kad uključiš zaključavanje. iOS provjerava tvoje lice; Doddy saznaje samo je li se podudaralo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy usa Face ID per aprire l'app o una nota privata quando attivi il blocco. iOS controlla il tuo volto; Doddy sa solo se corrisponde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックをオンにすると、DoddyはアプリやプライベートなメモをFace IDで開きます。顔の照合はiOSが行い、Doddyが知るのは一致したかどうかだけです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy używa Face ID, żeby otworzyć aplikację albo prywatną notatkę, gdy włączysz blokadę. iOS sprawdza Twoją twarz; Doddy dowiaduje się tylko, czy się zgadza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy usa o Face ID para abrir o app ou uma nota privada quando você ativa o bloqueio. O iOS verifica seu rosto; o Doddy só fica sabendo se correspondeu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启锁定后，Doddy 会使用面容 ID 来打开应用或私密笔记。由 iOS 检查你的面容；Doddy 只会得知是否匹配。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy liest deine Trainings, Herzfrequenz, Ruheherzfrequenz, Herzfrequenzvariabilität (HRV), deinen Schlaf und VO2max aus Health, um sie dir auf seinem Apple-Health-Bildschirm zu zeigen. Nur eine kurze Wochenzusammenfassung kann dieses iPhone verlassen, und nur wenn du es erlaubst. In „Nachrichten“ geht sie, wenn du auf „Senden“ tippst, an Doddys Server und an Claude von Anthropic, der die Antwort schreibt; sie bleibt in „Nachrichten“, mit einer Kopie des Textes auf Doddys Server für Doddy im Web, bis du sie löschst. In einem Sprachgespräch geht sie, wenn du fragst und zustimmst, an ElevenLabs, das Doddys Stimme betreibt, und wird mit diesem Gespräch gespeichert. Doddy schreibt nichts in Health. Schalte das unter Einstellungen, Verbindungen, Apple Health oder in der Health-App aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy reads your workouts, heart rate, resting heart rate, heart rate variability, sleep and VO2 max from Health to show them to you on its Apple Health screen. Only a short summary of the week can leave this iPhone, and only when you allow it. In Messages, when you tap Send, it goes to Doddy's server and Anthropic's Claude for the answer, and it stays in Messages, with a copy of the text on Doddy's server for Doddy on the web, until you delete it. In a voice conversation, when you ask and say yes, it goes to ElevenLabs, which runs Doddy's voice, and is kept with that conversation. Doddy writes nothing to Health. Turn this off in Settings, Connections, Apple Health, or in the Health app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy lee tus entrenamientos, frecuencia cardiaca, frecuencia cardiaca en reposo, variabilidad de la frecuencia cardiaca (VFC), sueño y VO2 máx. de Salud para mostrártelos en su pantalla de Apple Health. Solo un breve resumen de la semana puede salir de este iPhone, y solo si lo permites. En Mensajes, cuando tocas Enviar, va al servidor de Doddy y a Claude, de Anthropic, que escribe la respuesta, y se queda en Mensajes, con una copia del texto en el servidor de Doddy para Doddy en la web, hasta que lo borres. En una conversación de voz, cuando preguntas y dices que sí, va a ElevenLabs, que ejecuta la voz de Doddy, y se guarda con esa conversación. Doddy no escribe nada en Salud. Desactívalo en Ajustes, Conexiones, Apple Health, o en la app Salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy lit tes entraînements, ta fréquence cardiaque, ta fréquence cardiaque au repos, ta variabilité de la fréquence cardiaque (VFC), ton sommeil et ta VO2 max dans Santé pour te les montrer sur son écran Apple Health. Seul un court résumé de la semaine peut quitter cet iPhone, et seulement si tu le permets. Dans Messages, quand tu touches Envoyer, il part vers le serveur de Doddy et Claude d’Anthropic, qui écrit la réponse, et il reste dans Messages, avec une copie du texte sur le serveur de Doddy pour Doddy sur le web, jusqu’à ce que tu le supprimes. Dans une conversation vocale, quand tu demandes et dis oui, il va à ElevenLabs, qui fait tourner la voix de Doddy, et il est gardé avec cette conversation. Doddy n’écrit rien dans Santé. Désactive ceci dans Réglages, Connexions, Apple Health, ou dans l’app Santé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy čita tvoje treninge, puls, puls u mirovanju, varijabilnost srčanog ritma (HRV), san i VO2 max iz aplikacije Zdravlje da ti ih prikaže na svom zaslonu Apple Health. S ovog iPhonea može izaći samo kratak tjedni sažetak, i to samo kad to dopustiš. U Porukama, kad dodirneš Pošalji, ide na Doddyjev poslužitelj i Claudeu tvrtke Anthropic, koji piše odgovor, i ostaje u Porukama, s kopijom teksta na Doddyjevu poslužitelju za Doddyja na webu, dok ga ne izbrišeš. U glasovnom razgovoru, kad pitaš i pristaneš, ide u ElevenLabs, koji pokreće Doddyjev glas, i čuva se s tim razgovorom. Doddy ništa ne upisuje u Zdravlje. Isključi to u Postavkama, Veze, Apple Health, ili u aplikaciji Zdravlje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy legge i tuoi allenamenti, la frequenza cardiaca, la frequenza cardiaca a riposo, la variabilità della frequenza cardiaca (HRV), il sonno e il VO2 max da Salute per mostrarteli nella sua schermata Apple Health. Da questo iPhone può uscire solo un breve riepilogo della settimana, e solo se lo permetti. In Messaggi, quando tocchi Invia, va al server di Doddy e a Claude di Anthropic, che scrive la risposta, e resta in Messaggi, con una copia del testo sul server di Doddy per Doddy sul web, finché non lo elimini. In una conversazione vocale, quando chiedi e dici di sì, va a ElevenLabs, che fa funzionare la voce di Doddy, e viene conservato con quella conversazione. Doddy non scrive nulla in Salute. Disattivalo in Impostazioni, Collegamenti, Apple Health, o nell’app Salute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyは、ワークアウト、心拍数、安静時心拍数、心拍変動（HRV）、睡眠、VO2最大値をヘルスケアから読み取り、Doddyの「Apple Health」画面に表示します。このiPhoneの外に出られるのは週の短いまとめだけで、それもあなたが許可したときだけです。「メッセージ」で「送信」をタップすると、Doddyのサーバーと、回答を書くAnthropicのClaudeに送られ、あなたが削除するまで「メッセージ」に残ります。そのテキストのコピーは、Web版Doddyで表示するためにDoddyのサーバーにも保存されます。音声会話では、あなたが尋ねて「はい」と答えると、Doddyの声を動かすElevenLabsに送られ、その会話とともに保存されます。Doddyはヘルスケアに何も書き込みません。オフにするには、設定の「連携」の「Apple Health」か、ヘルスケアAppを使ってください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy odczytuje z aplikacji Zdrowie Twoje treningi, tętno, tętno spoczynkowe, zmienność rytmu serca (HRV), sen i VO2 max, żeby pokazać je na swoim ekranie Apple Health. Z tego iPhone'a może wyjść tylko krótkie podsumowanie tygodnia i tylko za Twoją zgodą. W Wiadomościach, po stuknięciu Wyślij, trafia na serwer Doddy'ego i do Claude (Anthropic), który pisze odpowiedź. Wiadomość zostaje w Wiadomościach, a kopia jej tekstu na serwerze Doddy'ego, żebyś mógł ją czytać w przeglądarce, dopóki jej nie usuniesz. W rozmowie głosowej, gdy zapytasz i się zgodzisz, podsumowanie trafia do ElevenLabs, które obsługuje głos Doddy'ego, i jest przechowywane razem z tą rozmową. Doddy nic nie zapisuje w Zdrowiu. Wyłączysz to w Ustawieniach, w sekcji Połączenia, Apple Health, albo w aplikacji Zdrowie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy lê seus treinos, frequência cardíaca, frequência cardíaca em repouso, variabilidade da frequência cardíaca (VFC), sono e VO2 máx. do app Saúde para mostrá-los na tela Apple Health dele. Só um breve resumo da semana pode sair deste iPhone, e só se você permitir. Em Mensagens, quando você toca em Enviar, ele vai para o servidor do Doddy e para o Claude, da Anthropic, que escreve a resposta, e fica em Mensagens, com uma cópia do texto no servidor do Doddy para o Doddy na web, até você apagá-lo. Em uma conversa por voz, quando você pergunta e diz sim, ele vai para a ElevenLabs, que executa a voz do Doddy, e é guardado com essa conversa. O Doddy não escreve nada no Saúde. Desative em Ajustes, Conexões, Apple Health, ou no app Saúde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 从“健康”读取你的体能训练、心率、静息心率、心率变异性（HRV）、睡眠和最大摄氧量，并在它的“Apple Health”页面上显示给你看。只有本周的简短摘要可以离开这部 iPhone，而且只在你允许时。在“信息”中轻点“发送”后，它会发送到 Doddy 的服务器和撰写回答的 Anthropic 的 Claude，并保留在“信息”中，文字副本也会保存在 Doddy 的服务器上供网页版 Doddy 显示，直到你删除它。在语音对话中，当你询问并同意后，它会发送给运行 Doddy 语音的 ElevenLabs，并随该对话一起保存。Doddy 不会向“健康”写入任何内容。可在设置的“连接”中的“Apple Health”或在“健康”App 中关闭。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy schreibt nie in Apple Health und ändert dort nichts. Es fragt nur an, deine Trainings, Herzfrequenz, Ruheherzfrequenz, Herzfrequenzvariabilität (HRV), deinen Schlaf und VO2max zu lesen. iOS verlangt von Apps diesen Text, weil der Health-Berechtigungsbildschirm sowohl Lesen als auch Schreiben abdeckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy never writes to or changes Apple Health. It only asks to read your workouts, heart rate, resting heart rate, heart rate variability, sleep and VO2 max. iOS asks apps for this text because its Health permission screen covers both reading and writing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy nunca escribe en Salud ni cambia nada allí. Solo pide permiso para leer tus entrenamientos, frecuencia cardiaca, frecuencia cardiaca en reposo, variabilidad de la frecuencia cardiaca (VFC), sueño y VO2 máx. iOS pide este texto a las apps porque su pantalla de permisos de Salud cubre tanto la lectura como la escritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy n’écrit jamais dans Santé et n’y modifie rien. Il demande seulement à lire tes entraînements, ta fréquence cardiaque, ta fréquence cardiaque au repos, ta variabilité de la fréquence cardiaque (VFC), ton sommeil et ta VO2 max. iOS demande ce texte aux apps parce que son écran d’autorisation de Santé couvre à la fois la lecture et l’écriture."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy nikad ne upisuje u Zdravlje i ništa tamo ne mijenja. Samo traži dopuštenje za čitanje tvojih treninga, pulsa, pulsa u mirovanju, varijabilnosti srčanog ritma (HRV), sna i VO2 max. iOS traži ovaj tekst od aplikacija jer njegov zaslon dopuštenja za Zdravlje obuhvaća i čitanje i upisivanje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy non scrive mai in Salute e non vi modifica nulla. Chiede solo di leggere i tuoi allenamenti, la frequenza cardiaca, la frequenza cardiaca a riposo, la variabilità della frequenza cardiaca (HRV), il sonno e il VO2 max. iOS richiede questo testo alle app perché la sua schermata dei permessi di Salute riguarda sia la lettura sia la scrittura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyがヘルスケアに書き込んだり、内容を変更したりすることはありません。読み取りの許可を求めるのは、ワークアウト、心拍数、安静時心拍数、心拍変動（HRV）、睡眠、VO2最大値だけです。ヘルスケアの許可画面は読み取りと書き込みの両方を扱うため、iOSはアプリにこの文章を求めます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy nigdy niczego nie zapisuje w aplikacji Zdrowie ani tam niczego nie zmienia. Prosi tylko o zgodę na odczyt Twoich treningów, tętna, tętna spoczynkowego, zmienności rytmu serca (HRV), snu i VO2 max. iOS wymaga od aplikacji tego tekstu, bo jego ekran uprawnień Zdrowia obejmuje zarówno odczyt, jak i zapis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy nunca escreve no Saúde nem altera nada lá. Ele só pede para ler seus treinos, frequência cardíaca, frequência cardíaca em repouso, variabilidade da frequência cardíaca (VFC), sono e VO2 máx. O iOS pede este texto aos apps porque a tela de permissões do Saúde abrange leitura e escrita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 绝不会向“健康”写入或更改任何内容。它只请求读取你的体能训练、心率、静息心率、心率变异性（HRV）、睡眠和最大摄氧量。iOS 要求 App 提供这段文字，因为“健康”的权限页面同时涵盖读取和写入。"
          }
        }
      }
    },
    "NSHomeKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy schaltet in deinem Zuhause nur dann ein Licht, eine Steckdose oder einen Ventilator ein oder aus oder startet eine Szene, wenn du darum bittest und auf einer Karte mit ihrem Namen auf Ja tippst. Schlösser, Garagentore, Alarmanlagen und Kameras steuert Doddy nie. Der Name dessen, worum du gebeten hast, und ob es geklappt hat, gehen in diesem Gespräch an Doddys Stimme; Doddy speichert nichts davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy turns a light, outlet or fan on or off, or runs a scene, in your Home only when you ask and after you tap Yes on a card that names it. It never controls locks, garage doors, alarms or cameras. The name of what you asked for and whether it worked go to Doddy's voice in that conversation; Doddy keeps none of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy enciende o apaga una luz, un enchufe o un ventilador, o ejecuta una escena, en tu Casa solo cuando lo pides y después de que toques Sí en una tarjeta que lo nombra. Nunca controla cerraduras, puertas de garaje, alarmas ni cámaras. El nombre de lo que pediste y si funcionó van a la voz de Doddy en esa conversación; Doddy no guarda nada de ello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy allume ou éteint une lumière, une prise ou un ventilateur, ou lance une scène, dans ta Maison uniquement quand tu le demandes et après que tu as touché Oui sur une carte qui la nomme. Il ne commande jamais les serrures, les portes de garage, les alarmes ni les caméras. Le nom de ce que tu as demandé et le fait que cela ait marché vont à la voix de Doddy dans cette conversation ; Doddy n'en garde rien."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy uključuje ili isključuje svjetlo, utičnicu ili ventilator, ili pokreće scenu, u tvom Domu samo kad to zatražiš i nakon što dodirneš Da na kartici koja je imenuje. Nikad ne upravlja bravama, garažnim vratima, alarmima ni kamerama. Naziv onoga što si zatražio i je li uspjelo idu Doddyjevu glasu u tom razgovoru; Doddy ništa od toga ne pohranjuje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy accende o spegne una luce, una presa o un ventilatore, o avvia una scena, nella tua Casa solo quando lo chiedi e dopo che hai toccato Sì su una scheda che lo nomina. Non controlla mai serrature, porte del garage, allarmi o telecamere. Il nome di ciò che hai chiesto e se ha funzionato vanno alla voce di Doddy in quella conversazione; Doddy non conserva nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy は、あなたが頼んだとき、そしてその名前が書かれたカードで「はい」をタップしたあとにだけ、ホームのライト、コンセント、扇風機をオン・オフしたり、シーンを実行したりします。鍵、ガレージドア、アラーム、カメラは操作しません。頼んだものの名前と成功したかどうかは、その会話の Doddy の声にだけ送られ、Doddy は何も保存しません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy włącza lub wyłącza światło, gniazdko albo wentylator, albo uruchamia scenę w Twoim Domu tylko wtedy, gdy o to poprosisz i stukniesz Tak na karcie z jej nazwą. Nigdy nie steruje zamkami, bramami garażowymi, alarmami ani kamerami. Nazwa tego, o co prosisz, i informacja, czy się udało, trafiają do głosu Doddy w tej rozmowie; Doddy nic z tego nie zachowuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy liga ou desliga uma luz, uma tomada ou um ventilador, ou executa uma cena, na sua Casa somente quando você pede e depois de tocar em Sim em um cartão que a nomeia. Ele nunca controla fechaduras, portões de garagem, alarmes ou câmeras. O nome do que você pediu e se funcionou vão para a voz do Doddy nessa conversa; o Doddy não guarda nada disso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你提出要求、并在写有其名称的卡片上点按“是”之后，Doddy 才会在你的“家庭”中打开或关闭灯、插座或风扇，或运行场景。它从不控制门锁、车库门、警报器或摄像头。你所要求事项的名称以及是否成功，只会在该次对话中发送给 Doddy 的语音；Doddy 不会保存其中任何内容。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy verwendet deinen Standort nur, wenn du darum bittest: für Erinnerungen, die du an einem Ort stellst (um herauszufinden, wo du bist, wenn du auf „Meinen aktuellen Standort verwenden“ tippst, und damit iOS dich beim Ankommen oder Gehen erinnern kann), um zu speichern, wo du geparkt hast, und um mit Apple Karten auszurechnen, wann du irgendwohin losmusst. Doddy behält ihn nicht und verfolgt nicht, wohin du gehst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy uses your location only when you ask: for reminders you set at a place (to find where you are when you tap Use where I am now, and so iOS can remind you when you arrive or leave), to save where you parked, and to work out with Apple Maps when to leave for somewhere. Doddy doesn't keep it or track where you go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy usa tu ubicación solo cuando se lo pides: para los recordatorios que pones en un lugar (para saber dónde estás cuando tocas Usar donde estoy ahora, y para que iOS pueda recordártelo cuando llegues o salgas), para guardar dónde aparcaste y para calcular con Mapas de Apple cuándo salir hacia algún sitio. Doddy no la guarda ni rastrea adónde vas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy n’utilise ta position que lorsque tu le demandes : pour les rappels que tu règles à un lieu (pour trouver où tu es quand tu touches Utiliser ma position actuelle, et pour qu’iOS puisse te faire un rappel quand tu arrives ou pars), pour enregistrer où tu t’es garé, et pour calculer avec Apple Plans quand partir quelque part. Doddy ne la conserve pas et ne suit pas où tu vas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy koristi tvoju lokaciju samo kad to zatražiš: za podsjetnike koje postaviš na mjestu (da pronađe gdje si kad dodirneš Koristi gdje sam sad, i da te iOS može podsjetiti kad stigneš ili odeš), za spremanje mjesta parkiranja i da s Appleovim Kartama izračuna kad krenuti nekamo. Doddy je ne čuva i ne prati kamo ideš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy usa la tua posizione solo quando lo chiedi: per i promemoria che imposti in un luogo (per trovare dove sei quando tocchi Usa dove sono ora, e perché iOS possa ricordartelo quando arrivi o parti), per salvare dove hai parcheggiato, e per calcolare con Mappe di Apple quando partire per un posto. Doddy non la conserva e non traccia dove vai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyが位置情報を使うのは、あなたが頼んだときだけです。場所で設定したリマインダーのため（「今いる場所を使う」をタップしたときに現在地を調べ、到着時や出発時にiOSがリマインドできるようにするため）、駐車した場所を保存するため、そしてAppleのマップでどこかへの出発時刻を計算するためです。Doddyは位置情報を保存せず、あなたの行き先を追跡することもありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy używa Twojej lokalizacji tylko wtedy, gdy o to prosisz: do przypomnień ustawionych w danym miejscu (żeby ustalić, gdzie jesteś, gdy stukniesz Użyj mojej obecnej lokalizacji, i żeby iOS mógł przypomnieć Ci po przyjściu lub wyjściu), do zapisania miejsca parkowania i do obliczenia z Mapami Apple, kiedy wyjść, żeby gdzieś dotrzeć. Doddy jej nie przechowuje i nie śledzi, dokąd chodzisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy usa sua localização só quando você pede: para lembretes que você define em um lugar (para descobrir onde você está quando toca em Usar onde estou agora, e para o iOS poder lembrar você ao chegar ou sair), para salvar onde você estacionou, e para calcular com o Mapas da Apple quando sair para algum lugar. O Doddy não a guarda nem rastreia aonde você vai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 只在你提出请求时使用你的位置：用于你在某个地点设置的提醒（在你轻点“使用我现在的位置”时确定你的位置，并让 iOS 在你到达或离开时提醒你），用于保存你的停车位置，以及通过 Apple 地图计算何时该出发去某个地方。Doddy 不会保留你的位置，也不会追踪你去了哪里。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dich zu hören, braucht Doddy das Mikrofon. Doddy hört zu, während du mit ihm redest: nachdem du auf Mit Doddy reden getippt hast, oder sobald du Doddy öffnest, wenn du das in den Einstellungen eingeschaltet hast. Deine Stimme in einem Gespräch geht an ElevenLabs, das Doddys Stimme betreibt und von jedem Gespräch eine Aufnahme und ein Transkript speichert; im Übersetzermodus gilt das auch für die Stimme der anderen Person. Ein Sprachmemo, das du zu einer Notiz aufnimmst, bleibt auf diesem iPhone. Eine Aufnahme, die du mit „Aufnehmen“ startest, bleibt ebenfalls auf diesem iPhone, und Doddy zeigt sie die ganze Zeit an, solange er aufnimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To hear you, Doddy needs the microphone. Doddy listens while you are talking to him: after you tap Talk to Doddy, or as soon as you open Doddy if you turned that on in Settings. Your voice in a conversation goes to ElevenLabs, which runs Doddy's voice and keeps a recording and transcript of each conversation; in translator mode, so does the other person's voice. A voice memo you record on a note stays on this iPhone. A recording you start with Record stays on this iPhone too, and Doddy shows it the whole time it records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para oírte, Doddy necesita el micrófono. Doddy escucha mientras hablas con él: después de que toques Hablar con Doddy, o en cuanto abres Doddy si lo activaste en Ajustes. Tu voz en una conversación va a ElevenLabs, que ejecuta la voz de Doddy y guarda una grabación y una transcripción de cada conversación; en el modo traductor, también la voz de la otra persona. Una nota de voz que grabes en una nota se queda en este iPhone. Una grabación que inicias con Grabar también se queda en este iPhone, y Doddy lo muestra todo el tiempo que graba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour t'entendre, Doddy a besoin du micro. Doddy écoute pendant que tu lui parles : après que tu as touché Parler à Doddy, ou dès que tu ouvres Doddy si tu l’as activé dans Réglages. Ta voix en conversation va à ElevenLabs, qui fait tourner la voix de Doddy et garde un enregistrement et une transcription de chaque conversation ; en mode traducteur, la voix de l’autre personne aussi. Un mémo vocal que tu enregistres sur une note reste sur cet iPhone. Un enregistrement que tu lances avec Enregistrer reste lui aussi sur cet iPhone, et Doddy l’indique pendant tout le temps où il enregistre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da bi te čuo, Doddy treba mikrofon. Doddy sluša dok razgovaraš s njim: nakon što dodirneš Razgovaraj s Doddyjem ili čim otvoriš Doddyja ako je to uključeno u Postavkama. Tvoj glas u razgovoru ide u ElevenLabs, koji pokreće Doddyjev glas i čuva snimku i prijepis svakog razgovora; u načinu prevoditelja to vrijedi i za glas druge osobe. Glasovna bilješka koju snimiš uz bilješku ostaje na ovom iPhoneu. Snimka koju pokreneš s Snimaj također ostaje na ovom iPhoneu, a Doddy to prikazuje cijelo vrijeme dok snima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per sentirti, Doddy ha bisogno del microfono. Doddy ascolta mentre parli con lui: dopo che tocchi Parla con Doddy, o appena apri Doddy se l'hai attivato in Impostazioni. La tua voce in una conversazione va a ElevenLabs, che fa funzionare la voce di Doddy e conserva una registrazione e una trascrizione di ogni conversazione; in modalità traduttore, anche la voce dell'altra persona. Un memo vocale che registri su una nota resta su questo iPhone. Anche una registrazione che avvii con Registra resta su questo iPhone, e Doddy lo mostra per tutto il tempo in cui registra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの声を聞くために、Doddyはマイクが必要です。Doddyが聞いているのは、あなたがDoddyと話している間です。「Doddyと話す」をタップした後、または設定でオンにしている場合はDoddyを開いてすぐに聞き始めます。会話中のあなたの声は、Doddyの声を動かすElevenLabsに送られます。ElevenLabsは各会話の録音と文字起こしを保存します。翻訳モードでは、相手の声も同じように送られます。メモに録音したボイスメモは、このiPhoneにとどまります。「録音」で始めた録音も、このiPhoneにとどまります。Doddyは録音中、そのことをずっと表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żeby Cię słyszeć, Doddy potrzebuje mikrofonu. Doddy słucha, gdy z nim rozmawiasz: po stuknięciu Porozmawiaj z Doddym albo od razu po otwarciu aplikacji, jeśli włączysz to w Ustawieniach. Twój głos w rozmowie trafia do ElevenLabs, które obsługuje głos Doddy'ego i przechowuje nagranie oraz zapis każdej rozmowy; w trybie tłumacza trafia tam także głos drugiej osoby. Notatka głosowa, którą nagrasz przy notatce, zostaje na tym iPhonie. Nagranie, które zaczniesz przyciskiem Nagrywaj, też zostaje na tym iPhonie, a Doddy pokazuje to przez cały czas nagrywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ouvir você, o Doddy precisa do microfone. O Doddy escuta enquanto você fala com ele: depois que você toca em Falar com o Doddy, ou assim que você abre o Doddy, se ativou isso nos Ajustes. Sua voz em uma conversa vai para a ElevenLabs, que executa a voz do Doddy e guarda uma gravação e uma transcrição de cada conversa; no modo tradutor, a voz da outra pessoa também. Uma gravação de voz que você faz em uma nota fica neste iPhone. Uma gravação que você inicia com Gravar também fica neste iPhone, e o Doddy mostra isso o tempo todo enquanto grava."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了听到你，Doddy 需要使用麦克风。Doddy 会在你和他聊天时聆听：在你轻点“和 Doddy 聊聊”之后，或者如果你在设置中开启了相应选项，则在你打开 Doddy 时立即开始。你在对话中的语音会发送给运行 Doddy 语音的 ElevenLabs，ElevenLabs 会保存每次对话的录音和文字记录；在翻译模式下，对方的语音也会如此。你在笔记上录制的语音备忘录只保留在这台 iPhone 上。你用“录制”开始的录音同样只保留在这台 iPhone 上，Doddy 会在录音期间一直显示这一点。"
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy liest deine Schritte, die Gehstrecke und die gestiegenen Etagen aus „Bewegung & Fitness“ nur, wenn du danach fragst, für einen Tag der letzten sieben. In einem Sprachgespräch gehen diese Zahlen als Teil des Gesprächs an ElevenLabs, das die Stimme von Doddy betreibt. Doddy speichert sie nirgendwo sonst. Schalte das unter Einstellungen, Verbindungen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy reads your steps, walking distance and floors climbed from Motion & Fitness only when you ask, for one day of the last seven. In a voice conversation those numbers go to ElevenLabs, which runs Doddy's voice, as part of that conversation. Doddy doesn't save them anywhere else. Turn this off in Settings, Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy lee tus pasos, la distancia caminada y los pisos subidos de Movimiento y forma física solo cuando se lo pides, de un día de los últimos siete. En una conversación de voz, esas cifras van a ElevenLabs, que ejecuta la voz de Doddy, como parte de esa conversación. Doddy no las guarda en ningún otro sitio. Desactívalo en Ajustes, Conexiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy lit tes pas, la distance parcourue à pied et les étages montés dans Mouvements et forme uniquement quand tu le demandes, pour un jour parmi les sept derniers. Dans une conversation vocale, ces chiffres vont à ElevenLabs, qui fait tourner la voix de Doddy, comme partie de cette conversation. Doddy ne les enregistre nulle part ailleurs. Désactive ceci dans Réglages, Connexions."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy čita tvoje korake, prijeđenu udaljenost i popete katove iz podataka Kretanje i kondicija samo kad to zatražiš, za jedan dan od zadnjih sedam. U glasovnom razgovoru ti brojevi idu u ElevenLabs, koji pokreće Doddyjev glas, kao dio tog razgovora. Doddy ih ne sprema nigdje drugdje. Isključi to u Postavkama, Veze."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy legge i tuoi passi, la distanza percorsa a piedi e i piani saliti da Movimento e fitness solo quando lo chiedi, per un giorno degli ultimi sette. In una conversazione vocale questi numeri vanno a ElevenLabs, che fa funzionare la voce di Doddy, come parte di quella conversazione. Doddy non li salva da nessun'altra parte. Disattivalo in Impostazioni, Collegamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyは、あなたが頼んだときだけ、過去7日間のうち1日分の歩数、歩行距離、上った階数を「モーションとフィットネス」から読み取ります。音声会話では、その数値が会話の一部として、Doddyの声を動かすElevenLabsに送られます。Doddyはこれらをほかの場所には保存しません。オフにするには、設定の「連携」を使ってください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy odczytuje Twoje kroki, przebyty dystans i pokonane piętra z danych Ruch i fitness tylko wtedy, gdy o to poprosisz, dla jednego dnia z ostatnich siedmiu. W rozmowie głosowej te liczby trafiają, jako część tej rozmowy, do ElevenLabs, które obsługuje głos Doddy'ego. Doddy nie zapisuje ich nigdzie indziej. Wyłączysz to w Ustawieniach, w sekcji Połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy lê seus passos, a distância caminhada e os andares subidos em Movimento e Condicionamento só quando você pede, de um dia entre os últimos sete. Em uma conversa por voz, esses números vão para a ElevenLabs, que executa a voz do Doddy, como parte dessa conversa. O Doddy não os salva em nenhum outro lugar. Desative em Ajustes, Conexões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你提出请求时，Doddy 才会从“运动与健身”读取最近七天中某一天的步数、步行距离和爬楼层数。在语音对话中，这些数字会作为对话的一部分发送给运行 Doddy 语音的 ElevenLabs。Doddy 不会把它们保存在其他任何地方。可在设置的“连接”中关闭。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy zählt die Fotos und Videos, die du an den erfragten Tagen aufgenommen hast, und zeigt sie auf deinem Bildschirm. Nur wie viele es sind und wann sie aufgenommen wurden, geht in diesem Gespräch an ElevenLabs, das die Stimme von Doddy betreibt; diese Bilder verlassen dieses iPhone nicht. Ein Foto, das du selbst in „Nachrichten“ auswählst, um Doddy danach zu fragen, geht verkleinert und ohne Standort an Doddys Server und an Claude von Anthropic, der die Antwort schreibt; weder Doddys Server noch dieses iPhone behält es. Doddy ändert deine Mediathek nie. Schalte das unter Einstellungen, Verbindungen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy counts the photos and videos you took on the days you ask about and shows them on your screen. Only how many there are and when they were taken go to ElevenLabs, which runs Doddy's voice, in that conversation; these pictures don't leave this iPhone. A photo you pick yourself to ask Doddy about in Messages goes, made smaller and without its location, to Doddy's server and Anthropic's Claude for the answer; neither Doddy's server nor this iPhone keeps it. Doddy never changes your library. Turn this off in Settings, Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy cuenta las fotos y vídeos que hiciste los días que preguntas y los muestra en tu pantalla. Solo cuántos hay y cuándo se hicieron van a ElevenLabs, que ejecuta la voz de Doddy, en esa conversación; esas imágenes no salen de este iPhone. Una foto que tú mismo eliges en Mensajes para preguntarle a Doddy va, reducida y sin su ubicación, al servidor de Doddy y a Claude, de Anthropic, que escribe la respuesta; ni el servidor de Doddy ni este iPhone la guardan. Doddy nunca cambia tu fototeca. Desactívalo en Ajustes, Conexiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy compte les photos et vidéos que tu as prises les jours que tu demandes et les affiche sur ton écran. Seuls leur nombre et le moment où elles ont été prises vont à ElevenLabs, qui fait tourner la voix de Doddy, dans cette conversation ; ces images ne quittent pas cet iPhone. Une photo que tu choisis toi-même dans Messages pour interroger Doddy part, réduite et sans sa position, vers le serveur de Doddy et Claude d’Anthropic, qui écrit la réponse ; ni le serveur de Doddy ni cet iPhone ne la gardent. Doddy ne modifie jamais ta photothèque. Désactive ceci dans Réglages, Connexions."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy broji fotografije i videozapise snimljene u danima za koje pitaš i prikazuje ih na tvom zaslonu. Samo njihov broj i vrijeme snimanja idu u ElevenLabs, koji pokreće Doddyjev glas, u tom razgovoru; te slike ne napuštaju ovaj iPhone. Fotografija koju sam odabereš u Porukama da bi pitao Doddyja o njoj ide, smanjena i bez lokacije, na Doddyjev poslužitelj i Claudeu tvrtke Anthropic, koji piše odgovor; ne čuva je ni Doddyjev poslužitelj ni ovaj iPhone. Doddy nikad ne mijenja tvoju knjižnicu. Isključi to u Postavkama, Veze."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy conta le foto e i video che hai fatto nei giorni che chiedi e li mostra sul tuo schermo. Solo quanti sono e quando sono stati fatti vanno a ElevenLabs, che fa funzionare la voce di Doddy, in quella conversazione; queste immagini non lasciano questo iPhone. Una foto che scegli tu in Messaggi per chiedere a Doddy va, rimpicciolita e senza posizione, al server di Doddy e a Claude di Anthropic, che scrive la risposta; né il server di Doddy né questo iPhone la conservano. Doddy non modifica mai la tua libreria. Disattivalo in Impostazioni, Collegamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyは、あなたが尋ねた日に撮った写真とビデオの数を数え、画面に表示します。その会話でDoddyの声を動かすElevenLabsに送られるのは、枚数と撮影日時だけです。これらの写真がこのiPhoneから出ることはありません。「メッセージ」でDoddyに尋ねるためにあなたが自分で選んだ写真は、縮小され位置情報を除いた状態で、Doddyのサーバーと、回答を書くAnthropicのClaudeに送られます。Doddyのサーバーもこの iPhoneも、その写真を保存しません。Doddyがライブラリを変更することはありません。オフにするには、設定の「連携」を使ってください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy liczy zdjęcia i filmy zrobione w dniach, o które pytasz, i pokazuje je na Twoim ekranie. Do ElevenLabs, które obsługuje głos Doddy'ego, trafia w tej rozmowie tylko ich liczba i czas zrobienia; te zdjęcia nie opuszczają tego iPhone'a. Zdjęcie, które sam wybierzesz w Wiadomościach, żeby zapytać o nie Doddy'ego, trafia, pomniejszone i bez lokalizacji, na serwer Doddy'ego i do Claude (Anthropic), który pisze odpowiedź; nie przechowuje go ani serwer Doddy'ego, ani ten iPhone. Doddy nigdy nie zmienia Twojej biblioteki. Wyłączysz to w Ustawieniach, w sekcji Połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy conta as fotos e vídeos que você fez nos dias sobre os quais pergunta e os mostra na sua tela. Só quantos são e quando foram feitos vão para a ElevenLabs, que executa a voz do Doddy, nessa conversa; essas imagens não saem deste iPhone. Uma foto que você mesmo escolhe em Mensagens para perguntar ao Doddy vai, reduzida e sem a localização, para o servidor do Doddy e para o Claude, da Anthropic, que escreve a resposta; nem o servidor do Doddy nem este iPhone a guardam. O Doddy nunca altera sua fototeca. Desative em Ajustes, Conexões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 会统计你在所问日期拍摄的照片和视频，并在你的屏幕上显示。在那次对话中，只有数量和拍摄时间会发送给运行 Doddy 语音的 ElevenLabs；这些图片不会离开这台 iPhone。你在“信息”中自己选择、想问 Doddy 的照片，会被缩小并去除位置信息后发送到 Doddy 的服务器和撰写回答的 Anthropic 的 Claude；Doddy 的服务器和这台 iPhone 都不会保留它。Doddy 绝不会更改你的图库。可在设置的“连接”中关闭。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy fügt eine Erinnerung erst hinzu, ändert, erledigt oder löscht sie erst, nachdem du auf Hinzufügen, Ändern, Erledigt oder Löschen getippt hast. Schalte das unter Einstellungen, Verbindungen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy adds, changes, completes or deletes a reminder only after you tap Add, Change, Mark done or Delete. Turn this off in Settings, Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy añade, cambia, completa o elimina un recordatorio solo después de que toques Añadir, Cambiar, Marcar como hecho o Eliminar. Desactívalo en Ajustes, Conexiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy n’ajoute, ne modifie, ne termine ou ne supprime un rappel qu’après que tu as touché Ajouter, Modifier, Marquer comme fait ou Supprimer. Désactive ceci dans Réglages, Connexions."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy dodaje, mijenja, dovršava ili briše podsjetnik tek nakon što dodirneš Dodaj, Promijeni, Označi kao obavljeno ili Izbriši. Isključi to u Postavkama, Veze."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy aggiunge, modifica, completa o elimina un promemoria solo dopo che tocchi Aggiungi, Modifica, Segna come fatto o Elimina. Disattivalo in Impostazioni, Collegamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyがリマインダーの追加・変更・完了・削除を行うのは、「追加」「変更」「完了にする」「削除」をタップした後だけです。オフにするには、設定の「連携」を使ってください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy dodaje, zmienia, kończy lub usuwa przypomnienie tylko po stuknięciu Dodaj, Zmień, Oznacz jako zrobione lub Usuń. Wyłączysz to w Ustawieniach, w sekcji Połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy só adiciona, altera, conclui ou apaga um lembrete depois que você toca em Adicionar, Alterar, Marcar como concluído ou Apagar. Desative em Ajustes, Conexões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你轻点“添加”、“更改”、“标记为完成”或“删除”后，Doddy 才会添加、更改、完成或删除提醒。可在设置的“连接”中关闭。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy verschriftlicht Sprachmemos und Aufnahmen auf diesem iPhone, damit du den Text prüfen und durchsuchen kannst. Außerdem schreibt er auf, was du sagst, wenn du in Nachrichten auf das Mikrofon tippst. Das Audio und sein Text werden nirgendwohin gesendet; Wörter, die du in Nachrichten diktierst, verlassen dieses iPhone nur, wenn du sie danach als Nachricht sendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy writes out voice memos and recordings on this iPhone, so you can check and search their words. It also writes out what you say when you tap the mic in Messages. The audio and its words are not sent anywhere; words you dictate into Messages leave this iPhone only if you then send them as a message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy transcribe notas de voz y grabaciones en este iPhone, para que puedas revisar y buscar sus palabras. También escribe lo que dices cuando tocas el micrófono en Mensajes. El audio y su texto no se envían a ningún sitio; las palabras que dictas en Mensajes solo salen de este iPhone si luego las envías como mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy transcrit les mémos vocaux et les enregistrements sur cet iPhone, pour que tu puisses vérifier et rechercher leurs mots. Il écrit aussi ce que tu dis quand tu touches le micro dans Messages. L’audio et ses mots ne sont envoyés nulle part ; les mots que tu dictes dans Messages ne quittent cet iPhone que si tu les envoies ensuite comme message."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy pretvara glasovne bilješke i snimke u tekst na ovom iPhoneu, da možeš provjeravati i pretraživati njihove riječi. Zapisuje i ono što kažeš kad dodirneš mikrofon u Porukama. Zvuk i njegove riječi ne šalju se nikamo; riječi koje izdiktiraš u Poruke napuštaju ovaj iPhone samo ako ih zatim pošalješ kao poruku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy trascrive memo vocali e registrazioni su questo iPhone, così puoi controllarne e cercarne il testo. Trascrive anche quello che dici quando tocchi il microfono in Messaggi. L’audio e il suo testo non vengono inviati da nessuna parte; le parole che detti in Messaggi lasciano questo iPhone solo se poi le invii come messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddyは、ボイスメモや録音をこのiPhone上で文字に書き起こし、言葉を確認したり検索したりできるようにします。メッセージでマイクをタップしたときに話した内容も文字にします。音声とその文字はどこにも送られません。メッセージに音声入力した言葉は、メッセージとして送信したときだけこのiPhoneの外に出ます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy zapisuje notatki głosowe i nagrania jako tekst na tym iPhonie, żeby można było sprawdzać i przeszukiwać ich słowa. Zapisuje też to, co mówisz po dotknięciu mikrofonu w Wiadomościach. Dźwięk i jego słowa nie są nigdzie wysyłane; słowa podyktowane w Wiadomościach opuszczają tego iPhone’a tylko wtedy, gdy wyślesz je potem jako wiadomość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Doddy transcreve neste iPhone as gravações de voz das notas e as gravações de reuniões e conversas, para você conferir e pesquisar as palavras. Ele também escreve o que você fala ao tocar no microfone em Mensagens. O áudio e as palavras dele não são enviados a lugar nenhum; as palavras que você dita em Mensagens só saem deste iPhone se você as enviar depois como mensagem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Doddy 会在这台 iPhone 上将语音备忘录和录音转写成文字，以便你检查和搜索其中的内容。你在“信息”中轻点麦克风时说的话，它也会转写成文字。音频及其文字不会发送到任何地方；你在“信息”中听写的文字，只有在你随后将其作为消息发送时才会离开这台 iPhone。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
