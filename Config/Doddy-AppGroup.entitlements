<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ADR-215: the app shares its widget snapshot with Doddy's widgets. See project.yml (DODDY_APP_GROUP). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(DODDY_APP_GROUP)</string>
	</array>
</dict>
</plist>
