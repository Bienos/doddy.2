<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac menu bar prototype (ADR-435) with the App Group it shares with its desktop widget (ADR-439, the note count only). Sandboxed; no network, no microphone. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)$(DODDY_APP_BUNDLE_IDENTIFIER).mac</string>
	</array>
</dict>
</plist>
