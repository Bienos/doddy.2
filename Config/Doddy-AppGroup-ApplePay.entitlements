<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Doddy app with the widgets' App Group and Apple Pay (ADR-490). Use with
     DODDY_APPLE_PAY_MERCHANT_ID set to a merchant ID registered in the developer account (paid
     team), with its Apple Pay payment processing certificate made from Stripe's request. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array><string>Default</string></array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(DODDY_APP_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>$(DODDY_APPLE_PAY_MERCHANT_ID)</string>
	</array>
</dict>
</plist>
