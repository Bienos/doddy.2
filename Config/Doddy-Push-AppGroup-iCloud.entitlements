<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Doddy app with push (ADR-142), the widgets' App Group (ADR-219) and iCloud for shared lists (ADR-263). Needs a paid team; use with DODDY_CLOUD_CONTAINER. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array><string>Default</string></array>
	<!-- Timers, reminders and "time to leave" come through a Focus where the user allows it (ADR-612). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(DODDY_APP_BUNDLE_IDENTIFIER)</string>
	</array>
	<!-- Shared lists (ADR-263): CloudKit in the app's own iCloud container. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(DODDY_APP_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
