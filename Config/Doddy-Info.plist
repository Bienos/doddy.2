<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Partial Info.plist for the Doddy app target. Xcode merges it with the keys it generates from
  the INFOPLIST_KEY_* build settings in project.yml (GENERATE_INFOPLIST_FILE = YES).
  V3 (DECISIONS.md ADR-053): background audio, so a conversation the user started keeps running
  after they leave the app, and Live Activities for its Dynamic Island.
  Landing page: registers doddy:// so the site's "Open Doddy" link opens the app (DeepLink.swift);
  navigation only.
-->
<plist version="1.0">
<dict>
	<!-- Export compliance (ADR-697, go-live checklist B9; owner, 2 Nov 2026: "Exempt: set it to NO").
	     Doddy uses only standard encryption: HTTPS, and Apple's CryptoKit (AES-256-GCM) for the local
	     backup file. With this key App Store Connect doesn't ask on every upload, so Xcode Cloud's
	     TestFlight builds don't wait as "Missing Compliance". Change it if Doddy ever adds its own or
	     non-standard encryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Screens in English and the languages with a table in l10n/ (ADR-223, ADR-458); iOS picks by
	     the iPhone's language. tools/build_strings_catalog.py writes the array; don't edit it. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
		<string>es</string>
		<string>fr</string>
		<string>hr</string>
		<string>it</string>
		<string>ja</string>
		<string>pl</string>
		<string>pt-BR</string>
		<string>zh-Hans</string>
	</array>
	<!-- Widgets' shared folder (ADR-219); only works when the build is signed with the App Group. -->
	<key>DoddyAppGroup</key>
	<string>group.$(DODDY_APP_BUNDLE_IDENTIFIER)</string>
	<!-- Shared lists (ADR-263): the iCloud container, empty unless the build sets
	     DODDY_CLOUD_CONTAINER with the iCloud entitlement; empty means sharing isn't offered.
	     CKSharingSupported lets iOS open Doddy from a shared list's link. -->
	<key>DoddyCloudContainer</key>
	<string>$(DODDY_CLOUD_CONTAINER)</string>
	<key>CKSharingSupported</key>
	<true/>
	<!-- One Doddy window at a time (ADR-436). iPad would otherwise allow several windows, each
	     bound to the same conversation router, so two voice screens could open at once. SwiftUI
	     supplies the scene itself; the app delegate still picks the share-accept scene delegate. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- Light by default (ADR-667): the launch screen is the light canvas in both appearances, so the
	     first thing on a phone in dark mode isn't a black screen. The app then follows Settings ›
	     Appearance (light until the person picks otherwise). The generated launch screen is off in
	     project.yml so this one is used. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- Shared lists (ADR-284): iCloud's silent "a list changed" wake-up. Used for nothing else. -->
		<string>remote-notification</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Motion v2 (owner answer to Q9): lets Doddy's display link run at 120 Hz on ProMotion
	     iPhones while he moves, so he keeps up with scrolling and the keyboard. The link runs
	     only while he moves, never while he is still. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Alarms (ADR-260): AlarmKit, iOS 26 and later only. Kept here rather than as an
	     INFOPLIST_KEY_ build setting, which older Xcode versions don't know. -->
	<key>NSAlarmKitUsageDescription</key>
	<string>Doddy sets an alarm or a timer only when you ask and tap Set alarm or Start. They ring even in Silent mode or a Focus. Turn alarms off in Doddy's Settings, Alarms.</string>
	<!-- Apple Health (ADR-693). Doddy only READS Health (NSHealthShareUsageDescription, in project.yml), but
	     HealthReader asks through requestAuthorization(toShare:read:), and App Store Connect rejects a build
	     that references that call without this text. The text says what is true: nothing is written. Kept in
	     this file, not as an INFOPLIST_KEY_ build setting, so the merged Info.plist is certain to carry it.
	     scripts/check_forbidden_capabilities.sh still fails on any write, save or delete. -->
	<key>NSHealthUpdateUsageDescription</key>
	<string>Doddy never writes to or changes Apple Health. It only asks to read your workouts, heart rate, resting heart rate, heart rate variability, sleep and VO2 max. iOS asks apps for this text because its Health permission screen covers both reading and writing.</string>
	<!-- ADR-563: Doddy's own server (web search, Claude, Gmail and the other online accounts).
	     Built in, so the app works without typing an address in Settings. Only a Debug build lets
	     Settings' development field override it (ADR-720); a shipped build always uses this address,
	     because the device ID the phone signs in with goes there. -->
	<key>DoddyServerURL</key>
	<string>https://doddy-yaci.onrender.com</string>
	<!-- Decision 2026-11-08-required-account: the Doddy accounts (Supabase Auth). Both values are
	     public by design: the project's address (https://<ref>.supabase.co) and its publishable key.
	     Empty until the owner fills them in (docs/OWNER_QUEUE.md, row 23). While empty, this build has
	     no Doddy accounts: nobody is asked to sign in, exactly as before. -->
	<key>DoddyAccountsURL</key>
	<string></string>
	<key>DoddyAccountsPublishableKey</key>
	<string></string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.bienos.doddy2.dev.links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>doddy</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
