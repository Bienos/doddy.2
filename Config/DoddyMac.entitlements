<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Native Mac app (ADR-351): sandboxed, the App Group it shares with its two extensions, and a file
  the user picks in the save panel (the text export). No network entitlement (not even a client),
  no Contacts, Calendar, location, camera or microphone.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(DODDY_MAC_APP_GROUP)</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
