    "Open Doddy from the menu bar to count your notes here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Doddy über die Menüleiste, um deine Notizen hier zu zählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Doddy desde la barra de menús para contar tus notas aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Doddy depuis la barre des menus pour compter tes notes ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Doddyja iz trake izbornika da ovdje prebroji tvoje bilješke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Doddy dalla barra dei menu per contare qui le tue note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーからDoddyを開くと、ここにメモの数が表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Doddy’ego z paska menu, żeby policzyć tu swoje notatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Doddy pela barra de menus para contar suas notas aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从菜单栏打开 Doddy，即可在这里统计你的笔记。"
          }
        }
      }
    },
