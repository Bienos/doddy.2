{
  "name": "doddy-connected-apps-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Minimum backend for DODDY Connected Apps: one read-only Google Calendar capability through Composio.",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec \"dist/test/**/*.test.js\"",
    "start": "node dist/src/server.js",
    "session:mint": "node dist/src/mintSession.js",
    "live-check": "node dist/src/liveCheck.js",
    "fixtures": "npm run build && node dist/test/fixtures.generate.js",
    "start:env": "node --env-file=.env.local dist/src/server.js",
    "start:op": "op run --env-file=.env.op -- node --env-file-if-exists=.env.local dist/src/server.js",
    "setup:composio": "npm run build && node dist/src/setupComposio.js",
    "setup:tools": "npm run build && node dist/src/setupTools.js"
  },
  "dependencies": {
    "@composio/core": "0.22.0",
    "@electric-sql/pglite": "0.5.8",
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.0",
    "typescript": "5.9.3"
  }
}
