# DODDY Connected Apps backend — example configuration.
# Copy to backend/.env.local (ignored by git) or set these in a secret manager. Never commit real values.
# Variable names are this project's choices, not Composio SDK settings.

# ---- Mode -------------------------------------------------------------------
# mock = deterministic demo data, zero provider calls, no secrets needed.
# live = real Composio + Google Calendar. Fails to start if anything below is missing or invalid.
DODDY_MODE=mock
# development | test | production   (production + live is refused until real app sign-in exists)
DODDY_ENV=development

# ---- Network ------------------------------------------------------------------
DODDY_HOST=127.0.0.1
DODDY_PORT=8787
# Public HTTPS origin Composio redirects to (https required outside loopback). No path.
DODDY_PUBLIC_BASE_URL=
# The only place the browser hand-off may return to (custom scheme or https, no query).
DODDY_APP_RETURN_URL=doddy-dev://connected-apps/return

# ---- Storage ------------------------------------------------------------------
# User↔Composio mapping, attempts, approvals, receipts, usage counters. No email, calendar or note content.
# Hosted Postgres (ADR-525), required when DODDY_ENV=production. Empty: PGlite in DODDY_DB_PATH.
DATABASE_URL=
# PEM of the database's CA when it isn't a public one (Supabase: its root CA). "\n" is read as a line break.
DATABASE_CA_CERT=
# PGlite data directory (local development and mock mode), or :memory:
DODDY_DB_PATH=./data/doddy-backend.pglite

# ---- App sessions -----------------------------------------------------------
# dev    = loopback test tokens dev-user-a / dev-user-b (mock mode + loopback host only)
# signed = owner-minted HMAC tokens (npm run session:mint); development only for live mode
# supabase = Doddy accounts (Sign in with Apple or Google through Supabase Auth, ADR-526); required in production.
#            In development the owner's minted tokens also work when DODDY_SESSION_SIGNING_KEY is set.
DODDY_AUTH_MODE=dev
# base64 of >= 32 random bytes, e.g. `openssl rand -base64 32`
DODDY_SESSION_SIGNING_KEY=
# supabase mode: the project's https origin. Only its public keys are used; no Supabase secret here.
SUPABASE_URL=

# ---- Composio (live mode only) -------------------------------------------------
# Project API key from the Composio dashboard. Server-side only; never in the app.
COMPOSIO_API_KEY=
# Auth config for Google Calendar with scopes set to calendar.events.readonly (see docs/integrations).
COMPOSIO_GOOGLECALENDAR_AUTH_CONFIG_ID=
# Pinned toolkit version (YYYYMMDD_NN). "latest" is refused.
COMPOSIO_GOOGLECALENDAR_TOOLKIT_VERSION=
# verifier (recommended; requires the project's OAuth callback verifier → <DODDY_PUBLIC_BASE_URL>/v1/oauth/verify)
# callback (single-owner development only)
COMPOSIO_COMPLETION_MODE=verifier

# ---- Online accounts: Gmail, Google Drive, Notion, Todoist, Outlook (live mode only) -
# Each account needs BOTH lines; leave a pair empty to leave that account "not set up" on this server.
# `npm run setup:tools` lists/creates the auth configs and prints these lines. Versions must be pinned.
# Live mode still needs the Google Calendar pair above (that is how live mode is validated today).
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_GMAIL_TOOLKIT_VERSION=
COMPOSIO_GOOGLEDRIVE_AUTH_CONFIG_ID=
COMPOSIO_GOOGLEDRIVE_TOOLKIT_VERSION=
COMPOSIO_NOTION_AUTH_CONFIG_ID=
COMPOSIO_NOTION_TOOLKIT_VERSION=
COMPOSIO_TODOIST_AUTH_CONFIG_ID=
COMPOSIO_TODOIST_TOOLKIT_VERSION=
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
COMPOSIO_OUTLOOK_TOOLKIT_VERSION=
# Google Calendar as an online account (ADR-486): its own auth config with the calendar.events scope.
# Separate from COMPOSIO_GOOGLECALENDAR_* above (the older read-only Connected Apps path).
COMPOSIO_GCALENDAR_AUTH_CONFIG_ID=
COMPOSIO_GCALENDAR_TOOLKIT_VERSION=

# ---- Web search through Monid (live mode; optional) ------------------------------
# Server-side key from app.monid.ai/access/api-keys (monid_live_...). Empty: Settings shows
# "Web search: not set up". Searches are paid from Doddy's Monid wallet (~$0.001 each).
MONID_API_KEY=
MONID_BASE_URL=https://api.monid.ai

# ---- Limits (Doddy's own ceilings, not provider quotas) -------------------------
DODDY_LIMIT_USER_DAILY_READS=30
# Online-account tool runs per user per UTC day (reads and confirmed writes)
DODDY_LIMIT_USER_DAILY_TOOL_RUNS=100
# Web searches per user, and for the whole server, per UTC day (each one costs Doddy money)
DODDY_LIMIT_USER_DAILY_WEB_SEARCHES=30
# ADR-563: the phone signs itself in with a device ID. first-device = the first iPhone owns this
# server (development only; needs DODDY_SESSION_SIGNING_KEY). off = only hand-made tokens.
# open (ADR-587) = the first iPhone owns it, and every other iPhone gets Ask Doddy only.
DODDY_DEVICE_SIGNUP=off
# Optional, comma-separated codes that let a further device in.
DODDY_DEVICE_INVITE_CODES=
# ADR-564: Claude for summaries, writing and documents. Empty = "not set up".
ANTHROPIC_API_KEY=
DODDY_CLAUDE_MODEL=claude-sonnet-5-5
DODDY_LIMIT_USER_DAILY_CLAUDE=40
DODDY_LIMIT_SERVICE_DAILY_CLAUDE=100
# ADR-587: Ask Doddy (typed questions, Claude with this server's key) per user and for the server,
# per UTC day. Worst case about $0.04 a question on Sonnet 5.5, usually under $0.01.
DODDY_LIMIT_USER_DAILY_ASK=50
DODDY_LIMIT_SERVICE_DAILY_ASK=500
DODDY_LIMIT_SERVICE_DAILY_WEB_SEARCHES=200
DODDY_LIMIT_SERVICE_DAILY_CALLS=300
DODDY_LIMIT_SERVICE_MONTHLY_CALLS=3000
DODDY_LIMIT_USER_CONCURRENCY=1
DODDY_LIMIT_SERVICE_CONCURRENCY=4
DODDY_PROVIDER_TIMEOUT_MS=10000
DODDY_MAX_PAGES=3
DODDY_PAGE_SIZE=50
DODDY_MAX_EVENTS=100
DODDY_ATTEMPT_TTL_SECONDS=600

# ---- Doddy Web (ADR-585) ----------------------------------------------------------------
# The origin the browser app is opened at (scheme, host, port; no path). Empty: no web routes and
# no web pages. https outside loopback; for local development http://127.0.0.1:5173 (Vite) or this
# server's own http://127.0.0.1:8787.
DODDY_WEB_ORIGIN=
# The built web app (npm run build in web/). Relative to where the server starts.
DODDY_WEB_DIST=../web/dist
# 1 behind exactly one proxy that appends the client to X-Forwarded-For (Render); used only to
# limit wrong sign-in codes per client.
DODDY_TRUST_PROXY=0
# Sign-in tries per client address (an IPv6 /64) per quarter hour; right or wrong, all count.
DODDY_WEB_SIGNIN_TRIES_PER_CLIENT=10

# ---- Opt-in live check (npm run live-check) -------------------------------------
DODDY_LIVE_CHECK_USER_ID=
DODDY_LIVE_CHECK_TIME_ZONE=
