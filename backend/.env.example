# DODDY Connected Apps backend — example configuration.
# Copy to backend/.env.local (ignored by git) or set these in a secret manager. Never commit real values.
# Variable names are this project's choices, not Composio SDK settings.

# ---- Mode -------------------------------------------------------------------
# mock = deterministic demo data, zero provider calls, no secrets needed.
# live = real Composio + Google Calendar. Fails to start if anything below is missing or invalid.
DODDY_MODE=mock
# development | test | production   (production + live is refused until real app sign-in exists)
DODDY_ENV=development

# ---- Network ------------------------------------------------------------------
DODDY_HOST=127.0.0.1
DODDY_PORT=8787
# Public HTTPS origin Composio redirects to (https required outside loopback). No path.
DODDY_PUBLIC_BASE_URL=
# The only place the browser hand-off may return to (custom scheme or https, no query).
DODDY_APP_RETURN_URL=doddy-dev://connected-apps/return

# ---- Storage ------------------------------------------------------------------
# User↔Composio mapping, attempts, approvals, receipts, usage counters. No email, calendar or note content.
# Hosted Postgres (ADR-525), required in production and in live mode on a non-loopback DODDY_HOST.
# Empty: PGlite in DODDY_DB_PATH (loopback development and mock mode only).
DATABASE_URL=
# PEM of the database's CA when it isn't a public one (Supabase: its root CA). "\n" is read as a line break.
DATABASE_CA_CERT=
# PGlite data directory (local development and mock mode), or :memory:
DODDY_DB_PATH=./data/doddy-backend.pglite

# ---- App sessions -----------------------------------------------------------
# dev    = loopback test tokens dev-user-a / dev-user-b (mock mode + loopback host only)
# signed = owner-minted HMAC tokens (npm run session:mint); development only for live mode
# supabase = Doddy accounts (Sign in with Apple or Google through Supabase Auth, ADR-526); required in production.
#            In development the owner's minted tokens also work when DODDY_SESSION_SIGNING_KEY is set.
# A live server on a host that is not loopback starts only under production rules (DODDY_ENV=production, supabase,
# COMPOSIO_COMPLETION_MODE=verifier, DODDY_DEVICE_SIGNUP=off, no DODDY_DEVICE_INVITE_CODES, DODDY_OWNER_CLAIM not open):
# docs/integrations/DEPLOY_RENDER.md, "Production rules".
DODDY_AUTH_MODE=dev
# base64 of >= 32 random bytes, e.g. `openssl rand -base64 32`
# The server never signs with this directly: it derives one key per job from it (sessions, file links; HKDF-SHA256,
# a fixed label each) and puts a key id on everything it signs (backend/src/signingKeys.ts).
DODDY_SESSION_SIGNING_KEY=
# Two more optional secrets, set by hand in the host's secret store only while rotating (not listed as lines here,
# so the secrets manifest is unchanged; steps in docs/integrations/DEPLOY_RENDER.md, "Rotating the signing key"):
#  - DODDY_SESSION_SIGNING_KEY_PREVIOUS: the key DODDY_SESSION_SIGNING_KEY had before. Accepted for checking, never
#    for signing, so tokens and links made with it keep working. The server refuses to start with it unless
#    DODDY_IDENTIFIER_KEY is set too. Remove it once the longest token has run out: 30 days (a file link lasts a day).
#  - DODDY_IDENTIFIER_KEY: makes each iPhone's user id and the invite codes' counter ids. Unset, it is
#    DODDY_SESSION_SIGNING_KEY itself, as before. Before rotating, set it to the value that key has today.
# supabase mode, and Google and Apple on Doddy Web (ADR-818): the project's https origin.
SUPABASE_URL=
# Google and Apple on Doddy Web (ADR-818): the project's publishable key (sb_publishable_…, public by
# design). Empty: the web signs in with the iPhone's code only.
SUPABASE_PUBLISHABLE_KEY=
# google, apple (the buttons shown, in order)
DODDY_WEB_SIGNIN_PROVIDERS=google,apple
# off (the default when this is unset): a Google or Apple account signs in on the web only to an account that already
# exists; a new person is asked to make theirs in the iPhone app first. open: it can make one on the web, after saying so.
DODDY_WEB_SIGNUP=off
# Optional, server only: deletes a person's Supabase sign-in when their Doddy account is deleted. From 1Password.
SUPABASE_SECRET_KEY=

# ---- Composio (live mode only) -------------------------------------------------
# Project API key from the Composio dashboard. Server-side only; never in the app.
COMPOSIO_API_KEY=
# Auth config for Google Calendar with scopes set to calendar.events.readonly (see docs/integrations).
COMPOSIO_GOOGLECALENDAR_AUTH_CONFIG_ID=
# Pinned toolkit version (YYYYMMDD_NN). "latest" is refused.
COMPOSIO_GOOGLECALENDAR_TOOLKIT_VERSION=
# verifier (recommended; requires the project's OAuth callback verifier → <DODDY_PUBLIC_BASE_URL>/v1/oauth/verify)
# callback (single-owner development only)
COMPOSIO_COMPLETION_MODE=verifier

# ---- Online accounts: Gmail, Google Drive, Notion, Todoist, Outlook (live mode only) -
# Each account needs BOTH lines; leave a pair empty to leave that account "not set up" on this server.
# `npm run setup:tools` lists/creates the auth configs and prints these lines. Versions must be pinned.
# Live mode still needs the Google Calendar pair above (that is how live mode is validated today).
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_GMAIL_TOOLKIT_VERSION=
COMPOSIO_GOOGLEDRIVE_AUTH_CONFIG_ID=
COMPOSIO_GOOGLEDRIVE_TOOLKIT_VERSION=
COMPOSIO_NOTION_AUTH_CONFIG_ID=
COMPOSIO_NOTION_TOOLKIT_VERSION=
COMPOSIO_TODOIST_AUTH_CONFIG_ID=
COMPOSIO_TODOIST_TOOLKIT_VERSION=
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
COMPOSIO_OUTLOOK_TOOLKIT_VERSION=
# Google Calendar as an online account (ADR-486): its own auth config with the calendar.events scope.
# Separate from COMPOSIO_GOOGLECALENDAR_* above (the older read-only Connected Apps path).
COMPOSIO_GCALENDAR_AUTH_CONFIG_ID=
COMPOSIO_GCALENDAR_TOOLKIT_VERSION=

# ---- Web search through Monid (live mode; optional) ------------------------------
# Server-side key from app.monid.ai/access/api-keys (monid_live_...). Empty: Settings shows
# "Web search: not set up". Searches are paid from Doddy's Monid wallet (web ~$0.007 each with Exa,
# ~$0.001 with Search1API; news ~$0.001; places ~$0.0002).
MONID_API_KEY=
MONID_BASE_URL=https://api.monid.ai
# Which fixed Monid endpoint web search asks (decision 2026-11-14-web-search-exa): exa (default; faster,
# ~$0.007 a search) or search1api (~$0.001, slower). Not a secret. With exa, a refusal from Exa is asked
# once of Search1API in the same request; a timeout never is. Any other value: the server doesn't start.
DODDY_WEB_SEARCH_PROVIDER=exa
# Flights (decision 2026-11-11-flights-kiwi-search-duffel-booking), live mode only, each off by default.
# Kiwi.com search (no key). Duffel search needs a test key; booking also needs FLIGHT_BOOKING_ENABLED=1
# and refuses a live key.
FLIGHT_SEARCH_ENABLED=0
DUFFEL_ACCESS_TOKEN=
FLIGHT_BOOKING_ENABLED=0

# ---- Payments: Doddy paying for things (x402), optional Coinbase wallet --------------
# OFF unless you set a wallet. See docs/integrations/PAYMENTS_X402.md before turning this on.
# none = no payment route can run (default). coinbase_cdp = a Coinbase Developer Platform server account.
DODDY_PAYMENTS_WALLET=none
# base-sepolia = test network, no real money (the only value the server accepts). `base` (REAL MONEY) is refused at
# startup until the owner approves mainnet in a separate decision (ADR-737).
DODDY_PAYMENTS_NETWORK=base-sepolia
# USDC amounts, up to 6 decimals. The funded wallet balance is the real final limit; keep it small.
DODDY_PAYMENTS_MAX_PER_PAYMENT_USDC=0.25
# From this amount up, the person must also type the amount to confirm (the server refuses a payment without it).
DODDY_PAYMENTS_CONFIRM_AMOUNT_USDC=0.10
DODDY_PAYMENTS_USER_DAILY_USDC=1.00
DODDY_PAYMENTS_SERVICE_DAILY_USDC=5.00
# Only these sites (and their subdomains) may be paid. Empty = any public https site, in mock mode only:
# with DODDY_MODE=live and a wallet set, the server refuses to start until this lists at least one site.
DODDY_PAYMENTS_ALLOWED_HOSTS=
# Sites whose payment page addresses may keep a query string (the part after "?"). Empty = none may:
# such an address is refused before anything is read.
DODDY_PAYMENTS_QUERY_HOSTS=
# Live mode + coinbase_cdp only. Server-side secrets: set them in the host's secret store, never in chat or git.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_PAYMENT_ACCOUNT_ADDRESS=

# ---- Limits (Doddy's own ceilings, not provider quotas) -------------------------
DODDY_LIMIT_USER_DAILY_READS=30
# Online-account tool runs per user per UTC day (reads and confirmed writes)
DODDY_LIMIT_USER_DAILY_TOOL_RUNS=100
# Web searches per user, and for the whole server, per UTC day (each one costs Doddy money)
DODDY_LIMIT_USER_DAILY_WEB_SEARCHES=30
# ADR-563: the phone signs itself in with a device ID. first-device = the first iPhone owns this
# server (development only; needs DODDY_SESSION_SIGNING_KEY). off = only hand-made tokens.
# open (ADR-587) = the first iPhone owns it, and every other iPhone gets Ask Doddy only.
DODDY_DEVICE_SIGNUP=off
# Optional, comma-separated codes that let a further device in.
DODDY_DEVICE_INVITE_CODES=
# Decision 2026-11-12-account-and-device-tokens (c): how many days an iPhone's join to another account lasts (1 to 3650).
# The join ends after that unless the iPhone signs in again with the same Apple or Google, which renews it; the iPhone then
# uses its own account again. A plain number, not a secret.
DODDY_DEVICE_JOIN_DAYS=90
# ADR-707: may the first iPhone to sign in claim a server that has NO owner yet? The app is built from a
# public repository and carries no secret, so on a live server this is closed unless you open it:
#   open   = the first caller owns an empty server (the default in mock mode: tests, demos).
#   closed = nobody can claim it (the default in live mode). Signed in with DODDY_DEVICE_SIGNUP=first-device
#            an empty server refuses everyone; with =open every iPhone is a guest. The server logs
#            `owner_unclaimed` (at most every ten minutes) while that is so.
# A server that already has an owner is not affected. To set up a new or wiped server: set this to open,
# sign in once on the owner's iPhone, then remove the setting (or set it back to closed).
DODDY_OWNER_CLAIM=
# ADR-709: invite codes. Every try with a code counts, right or wrong, per client network per hour; one valid
# code may make this many sessions per UTC day, and sign in this many different iPhones.
DODDY_INVITE_TRIES_PER_CLIENT=20
DODDY_INVITE_SESSIONS_PER_CODE_PER_DAY=20
DODDY_INVITE_DEVICES_PER_CODE=5
# ADR-564: Claude for summaries, writing and documents. Empty = "not set up".
ANTHROPIC_API_KEY=
DODDY_CLAUDE_MODEL=claude-sonnet-5-5
DODDY_LIMIT_USER_DAILY_CLAUDE=40
DODDY_LIMIT_SERVICE_DAILY_CLAUDE=100
# ADR-710: one document can take up to nine Anthropic calls, so it counts as this many runs against both
# caps above, and only this many are made at once (per user, and for the whole server).
DODDY_DOCUMENT_CLAUDE_UNITS=5
DODDY_LIMIT_USER_DOCUMENT_JOBS=1
DODDY_LIMIT_SERVICE_DOCUMENT_JOBS=3
# ADR-587: Ask Doddy (typed questions, Claude with this server's key) per user and for the server,
# per UTC day. Worst case about $0.04 a question on Sonnet 5.5, usually under $0.01.
DODDY_LIMIT_USER_DAILY_ASK=50
DODDY_LIMIT_SERVICE_DAILY_ASK=500
# Guests' questions (ADR-587 guest sessions) for the whole server per UTC day: a pool of their own.
DODDY_LIMIT_SERVICE_DAILY_GUEST_ASK=100
# The browser chat (POST /v1/web/chat) for the whole server per UTC day: a pool of its own, not Ask Doddy's.
# A person's daily total (DODDY_LIMIT_USER_DAILY_ASK) is still shared between the iPhone and the browser.
DODDY_LIMIT_SERVICE_DAILY_WEB_CHAT=200
DODDY_LIMIT_SERVICE_DAILY_WEB_SEARCHES=200
DODDY_LIMIT_SERVICE_DAILY_CALLS=300
DODDY_LIMIT_SERVICE_MONTHLY_CALLS=3000
DODDY_LIMIT_USER_CONCURRENCY=1
DODDY_LIMIT_SERVICE_CONCURRENCY=4
DODDY_PROVIDER_TIMEOUT_MS=10000
DODDY_MAX_PAGES=3
DODDY_PAGE_SIZE=50
DODDY_MAX_EVENTS=100
DODDY_ATTEMPT_TTL_SECONDS=600

# ---- Doddy Web (ADR-600) ----------------------------------------------------------------
# The origin the browser app is opened at (scheme, host, port; no path). Empty: no web routes and
# no web pages. https outside loopback; for local development http://127.0.0.1:5173 (Vite) or this
# server's own http://127.0.0.1:8787.
DODDY_WEB_ORIGIN=
# The built web app (npm run build in web/). Relative to where the server starts.
DODDY_WEB_DIST=../web/dist
# 1 behind exactly one proxy that appends the client to X-Forwarded-For (Render); used only to
# limit wrong sign-in codes per client.
DODDY_TRUST_PROXY=0
# Sign-in tries per client address (an IPv6 /64) per quarter hour; right or wrong, all count.
DODDY_WEB_SIGNIN_TRIES_PER_CLIENT=10

# ---- Opt-in live check (npm run live-check) -------------------------------------
DODDY_LIVE_CHECK_USER_ID=
DODDY_LIVE_CHECK_TIME_ZONE=
